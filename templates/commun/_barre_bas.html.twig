{#
    Onglets d'une rubrique, affichés seulement sur téléphone, en barre fixée juste au-dessus de la barre principale
    (même dessin). Variables : onglets (liste de {url, icone (nom dans commun/_icones), libelle, actif}).
#}
{% import 'commun/_icones.html.twig' as i %}
<nav class="barre-bas" aria-label="Onglets de la rubrique">
    {% for o in onglets %}
        <a href="{{ o.url }}" class="{{ o.actif ? 'actif' }}" {{ o.actif ? 'aria-current="page"' }}>{{ i.icone(o.icone) }}<span>{{ o.libelle }}</span>{% if o.pastille ?? null %}<span class="pastille">{{ o.pastille }}</span>{% endif %}</a>
    {% endfor %}
</nav>
