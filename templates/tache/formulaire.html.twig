{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
    <p>
        {% if t.id %}
            <a href="{{ path('app_tache_voir', {id: t.id}) }}">← Retour à la tâche</a>
        {% else %}
            <a href="{{ path('app_tache_index') }}">← Tâches</a>
        {% endif %}
    </p>
    <h1>{{ titre }}</h1>

    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'formulaire'}}) }}
        {{ form_errors(form) }}

        <fieldset class="carte">
            <legend>Tâche</legend>
            {{ m.groupe(form, ['objet', 'responsable', 'joueur', 'categorie', 'echeance', 'urgente', 'description']) }}
            {% if not t.id %}<p class="discret petit">Confiez la tâche à une personne de l'encadrement ou à un joueur : la personne, ou la famille du joueur, reçoit un e-mail.</p>{% endif %}
        </fieldset>

        {% if form.statut is defined %}
            <fieldset class="carte">
                <legend>Suivi</legend>
                {{ m.groupe(form, ['statut', 'compteRendu']) }}
            </fieldset>
        {% endif %}

        {{ form_rest(form) }}
        <div class="barre-actions">
            <button type="submit" class="bouton principal">{{ t.id ? 'Enregistrer' : 'Confier la tâche' }}</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
