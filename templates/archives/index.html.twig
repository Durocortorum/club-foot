{% extends 'base.html.twig' %}

{% block title %}Archives{% endblock %}

{% block body %}
    <div class="titre-page">
        <h1>Archives</h1>
    </div>

    {# Anciens membres : une carte-lien par type (icône, nom, explication, flèche), vers la liste filtrée sur « anciens ». #}
    {% set anciens = [
        {icone: "⚽", nom: "Joueurs", texte: "Anciens joueurs", lien: path("app_joueur_index", {statut: "anciens"})},
        {icone: "📋", nom: "Éducateurs", texte: "Anciens éducateurs", lien: path("app_intervenant_index", {type: "educateurs", statut: "anciens"})},
        {icone: "🏛️", nom: "Dirigeants", texte: "Anciens dirigeants", lien: path("app_intervenant_index", {type: "dirigeants", statut: "anciens"})},
        {icone: "🗂️", nom: "Administratifs", texte: "Anciens administratifs", lien: path("app_intervenant_index", {type: "administratifs", statut: "anciens"})},
        {icone: "🤝", nom: "Bénévoles", texte: "Anciens bénévoles", lien: path("app_intervenant_index", {type: "benevoles", statut: "anciens"})},
        {icone: "🟨", nom: "Arbitres", texte: "Anciens arbitres", lien: path("app_intervenant_index", {type: "arbitres", statut: "anciens"})},
    ] %}
    {% if is_granted("ROLE_ADMIN") %}
        {% set anciens = anciens|merge([{icone: "💼", nom: "Sponsors", texte: "Anciens partenaires", lien: path("app_sponsor_index", {statut: "anciens"})}]) %}
    {% endif %}
    <section>
        <h2 class="titre-bloc">Ont quitté le club</h2>
        <div class="cartes-liens">
            {% for a in anciens %}
                <a class="carte-lien" href="{{ a.lien }}">
                    <span class="carte-lien-icone" aria-hidden="true">{{ a.icone }}</span>
                    <span class="carte-lien-texte"><strong>{{ a.nom }}</strong><span>{{ a.texte }}</span></span>
                    <span class="carte-lien-fleche" aria-hidden="true">→</span>
                </a>
            {% endfor %}
        </div>
    </section>

    <section class="bloc">
    <h2 class="titre-bloc">Effectifs par saison</h2>
    <p class="discret">Reconstitués à partir des feuilles de match et de présence de chaque équipe.</p>

    {% for secteur, libelle in secteurs %}
        <section class="secteur">
            <h3>{{ libelle.libelle }}</h3>
            <ul class="liste-simple archives">
                {% for ligne in categories[secteur] %}
                    <li>
                        <span class="archives-categorie">{{ ligne.categorie.nom }}</span>
                        <span class="sommaire">
                            {% for s in ligne.saisons %}
                                <a href="{{ path('app_archives_saison', {id: ligne.categorie.id, saison: s|replace({'/': '-'})}) }}">Saison {{ s }}</a>
                            {% endfor %}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <p class="vide">Aucun match ni feuille de présence enregistré pour vos secteurs.</p>
    {% endfor %}
    </section>
{% endblock %}
