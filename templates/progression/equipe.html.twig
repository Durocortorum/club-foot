{% extends 'base.html.twig' %}
{% import 'progression/_courbe.html.twig' as c %}

{% block title %}Progression {{ categorie }}{% endblock %}

{% block body %}
    <div class="titre-page">
        <h1>Progression <span class="compteur">{{ categorie }}</span></h1>
        <span class="actions">
            <a class="bouton" href="{{ path('app_tests', {categorie: categorie.id}) }}">Catalogue des tests</a>
            {% if is_granted('ROLE_TESTS_PHYSIQUES') %}<a class="bouton principal" href="{{ path('app_test_seance', {categorie: categorie.id}) }}">Faire passer des tests</a>{% endif %}
        </span>
    </div>
    <p class="discret petit">Dernier résultat de chaque joueur à chaque test, et son évolution depuis le test précédent (<span class="progression-evolution mieux">vert</span> : progrès, <span class="progression-evolution moins-bien">rouge</span> : recul). ★ : meilleur de l'équipe. Cliquez sur un joueur pour ses courbes.</p>

    <form class="filtres" method="get">
        <select name="categorie" onchange="this.form.requestSubmit()" aria-label="Équipe">
            {% for cat in categories %}<option value="{{ cat.id }}" {{ cat.id == categorie.id ? 'selected' }}>{{ cat.nom }}</option>{% endfor %}
        </select>
        <noscript><button type="submit" class="bouton">Afficher</button></noscript>
    </form>

    {% if tableau.tests %}
        <p class="discret">{{ tableau.testes }} joueur{{ tableau.testes > 1 ? 's' }} testé{{ tableau.testes > 1 ? 's' }} sur {{ tableau.lignes|length }}.</p>
        <div class="table-defile">
            <table class="liste tableau-progression">
                <thead>
                    <tr><th>Joueur</th>{% for t in tableau.tests %}<th class="a-droite" title="{{ t.plusBasMieux ? 'Le plus bas est le meilleur' : 'Le plus élevé est le meilleur' }}">{{ t.nom }} <span class="discret">({{ t.unite }})</span></th>{% endfor %}</tr>
                </thead>
                <tbody>
                    {% for l in tableau.lignes %}
                        <tr>
                            <td class="fort"><a href="{{ path('app_progression_joueur', {id: l.joueur.id}) }}">{{ l.joueur.nom }} {{ l.joueur.prenom }}</a></td>
                            {% for t in tableau.tests %}
                                {% set v = l.valeurs[t.id] ?? null %}
                                <td class="a-droite nowrap">
                                    {% if v %}
                                        <span title="Test du {{ v.date|date('d/m/Y') }}">{{ v.meilleur ? '★ ' }}{{ c.nombre(v.valeur) }}</span>
                                        {% if v.evolution is not null and v.mieux is not null %}<br><small class="progression-evolution {{ v.mieux ? 'mieux' : 'moins-bien' }}">{{ v.evolution > 0 ? '+' : '−' }}{{ c.nombre(v.evolution|abs) }}</small>{% endif %}
                                    {% else %}<span class="discret">–</span>{% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="vide">Aucun test pour les joueurs de {{ categorie }}.{% if is_granted('ROLE_TESTS_PHYSIQUES') %} <a href="{{ path('app_test_seance', {categorie: categorie.id}) }}">Faire passer des tests</a> à l'équipe.{% endif %}</p>
    {% endif %}
{% endblock %}
