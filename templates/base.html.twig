<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Application interne (données de mineurs) : jamais dans les moteurs de recherche. #}
        <meta name="robots" content="noindex, nofollow">
        {# Pas de copie en mémoire des pages (bouton « retour », aperçus) : les données changent souvent
           (matchs supprimés, convocations, messages), chaque page est toujours relue à jour. #}
        <meta name="turbo-cache-control" content="no-cache">
        <title>{% block title %}Accueil{% endblock %} · {{ apparence.club.nom }}</title>
        {% set club = apparence.club %}
        {% set logo_club = club.logo ? path('app_club_logo', {version: club.version}) : asset('images/logo.svg') %}
        {% if club.logo %}<link rel="icon" type="image/png" href="{{ path('app_club_icone', {version: club.version}) }}">{% else %}<link rel="icon" type="image/svg+xml" href="{{ asset('images/logo.svg') }}">{% endif %}
        {# Application installable sur l'écran d'accueil (nécessaire aux notifications sur iPhone). #}
        <link rel="manifest" href="{{ path('app_manifeste') }}" crossorigin="use-credentials">
        <meta name="theme-color" content="{{ club.couleur }}">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-title" content="{{ club.nom|slice(0, 12) }}">
        {% if club.logo %}<link rel="apple-touch-icon" href="{{ path('app_club_logo', {version: club.version}) }}">{% endif %}
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    {# Couleurs du club (page « Apparence du club ») sur le <body>, que Turbo remplace à chaque page :
       dans le <head>, l'ancien style restait après un changement de club. #}
    <body style="--rouge: {{ club.couleur }}; --rouge-fonce: {{ club.couleurFoncee }}; --sur-rouge: {{ club.couleurTexte }}; --notif: {{ club.couleursNotification.fond }}; --sur-notif: {{ club.couleursNotification.texte }};">
        {% if app.user %}
            <header class="entete" data-controller="menu">
                <a class="marque" href="{{ path('app_accueil') }}">
                    <img class="blason" src="{{ logo_club }}" alt="">
                    {{ club.nom }}
                </a>
                {# Petits écrans : le menu et le compte sont repliés derrière ce bouton. #}
                <button type="button" class="burger" aria-expanded="false" aria-controls="navigation" data-menu-target="bouton" data-action="menu#basculer">
                    <span aria-hidden="true">☰</span> Menu
                </button>
                {% set route = app.request.attributes.get('_route') %}
                {% if is_granted('ROLE_MEDICAL_SEUL') %}
                {# Compte médical seul (médecin, kiné...) : l'Infirmerie et les dossiers médicaux, rien d'autre. #}
                <nav class="menu" id="navigation">
                    {% if is_granted('ROLE_INFIRMERIE_LECTURE') %}<a href="{{ path('app_infirmerie_index') }}" class="{{ route starts with 'app_infirmerie' or route starts with 'app_blessure' or route starts with 'app_contact' ? 'actif' }}">Infirmerie</a>{% endif %}
                    <a href="{{ path('app_dossier_medical_index') }}" class="{{ route starts with 'app_dossier_medical' ? 'actif' }}">Dossiers médicaux</a>
                    {% set non_lus = messages_non_lus() %}
                    <a href="{{ path('app_message_index') }}" class="{{ route starts with 'app_message' ? 'actif' }}">Messages <span class="pastille alerte" data-controller="nouvelles" data-nouvelles-url-value="{{ path('app_messages_etat') }}" {{ non_lus ? '' : 'hidden' }}>{{ non_lus ?: '' }}</span></a>
                </nav>
                {% elseif not is_granted('ROLE_ENCADREMENT') %}
                <nav class="menu" id="navigation">
                    <a href="{{ path('app_espace') }}" class="{{ route == 'app_espace' ? 'actif' }}">Mon espace</a>
                    <a href="{{ path('app_espace_calendrier') }}" class="{{ route == 'app_espace_calendrier' ? 'actif' }}">Calendrier</a>
                    {% if boutique_ouverte() %}<a href="{{ path('app_espace_boutique') }}" class="{{ route starts with 'app_espace_boutique' ? 'actif' }}">Boutique</a>{% endif %}
                    {% set non_lus = messages_non_lus() %}
                    <a href="{{ path('app_espace_messages') }}" class="{{ route starts with 'app_espace_message' ? 'actif' }}">Messages <span class="pastille alerte" data-controller="nouvelles" data-nouvelles-url-value="{{ path('app_messages_etat') }}" {{ non_lus ? '' : 'hidden' }}>{{ non_lus ?: '' }}</span></a>
                </nav>
                {% else %}
                <nav class="menu" id="navigation">
                    <a href="{{ path('app_accueil') }}" class="{{ route == 'app_accueil' ? 'actif' }}">Accueil</a>
                    <a href="{{ path('app_joueur_index') }}" class="{{ route starts with 'app_joueur' or route starts with 'app_mesure' or route in ['app_test_nouveau', 'app_progression_joueur'] ? 'actif' }}">Joueurs</a>
                    <a href="{{ path('app_intervenant_index', {type: 'educateurs'}) }}" class="{{ route starts with 'app_intervenant' or route starts with 'app_organigramme' or route starts with 'app_numero_utile' ? 'actif' }}">Encadrement</a>
                    <a href="{{ path('app_calendrier') }}" class="{{ route == 'app_calendrier' ? 'actif' }}">Calendrier</a>
                    <a href="{{ path('app_rencontre_index') }}" class="{{ route starts with 'app_rencontre' ? 'actif' }}">Matchs</a>
                    <a href="{{ path('app_statistiques') }}" class="{{ route == 'app_statistiques' ? 'actif' }}">Statistiques</a>
                    <a href="{{ path('app_presence_index') }}" class="{{ route starts with 'app_presence' ? 'actif' }}">Présences</a>
                    <a href="{{ path('app_seance_index') }}" class="{{ route starts with 'app_seance' or route starts with 'app_exercice' or route starts with 'app_planning' or route starts with 'app_ressenti' or route == 'app_progression_equipe' or route starts with 'app_test_type' or route in ['app_tests', 'app_test_seance'] ? 'actif' }}">Entraînements</a>
                    {% set non_lus = messages_non_lus() %}
                    <a href="{{ path('app_message_index') }}" class="{{ route starts with 'app_message' ? 'actif' }}" title="Messagerie avec les familles et les collègues">Messages <span class="pastille alerte" title="Messages et réponses non lus" data-controller="nouvelles" data-nouvelles-url-value="{{ path('app_messages_etat') }}" {{ non_lus ? '' : 'hidden' }}>{{ non_lus ?: '' }}</span></a>
                    {% set nb_taches_menu = taches_ouvertes() %}
                    <a href="{{ path('app_tache_index', nb_taches_menu.miennes ? {} : {vue: 'toutes'}) }}" class="{{ route starts with 'app_tache' ? 'actif' }}">{# Un seul rond : toutes les tâches en cours visibles ; jaune si au moins une est pour soi. #}Tâches{% if nb_taches_menu.total %} <span class="pastille {{ nb_taches_menu.miennes ? 'alerte' }}" title="{{ nb_taches_menu.total }} {{ nb_taches_menu.total > 1 ? 'tâches' : 'tâche' }} en cours{{ nb_taches_menu.miennes ? ', dont ' ~ nb_taches_menu.miennes ~ ' pour vous' }}">{{ nb_taches_menu.total }}</span>{% endif %}</a>
                    <a href="{{ path('app_archives') }}" class="{{ route starts with 'app_archives' ? 'actif' }}">Archives</a>
                    {% if is_granted('ROLE_ECOLE_FOOT') or is_granted('ROLE_PREFORMATION') or is_granted('ROLE_FORMATION') or is_granted('ROLE_ELITE') or is_granted('ROLE_PRO') %}
                        <a href="{{ path('app_detection_index') }}" class="{{ route starts with 'app_detection' or route starts with 'app_observe' or route starts with 'app_candidature' ? 'actif' }}">Recrutement</a>
                    {% endif %}
                    {% if is_granted('ROLE_SCOLAIRE_LECTURE') %}
                        <a href="{{ path('app_scolarite_index') }}" class="{{ route starts with 'app_scolarite' or route starts with 'app_bulletin' ? 'actif' }}">Scolarité</a>
                    {% endif %}
                    {% if is_granted('ROLE_DISCIPLINE_LECTURE') %}
                        <a href="{{ path('app_discipline_index') }}" class="{{ route starts with 'app_discipline' or route starts with 'app_sanction' ? 'actif' }}">Discipline</a>
                    {% endif %}
                    {% if is_granted('ROLE_INFIRMERIE_LECTURE') %}
                        <a href="{{ path('app_infirmerie_index') }}" class="{{ route starts with 'app_infirmerie' or route starts with 'app_blessure' or route starts with 'app_contact' ? 'actif' }}">Infirmerie</a>
                    {% endif %}
                    <a href="{{ path('app_transport') }}" class="{{ route starts with 'app_transport' ? 'actif' }}">Transport</a>
                    {% if is_granted('ROLE_FINANCES_LECTURE') %}
                        <a href="{{ path('app_finances') }}" class="{{ route starts with 'app_finances' ? 'actif' }}">Finances</a>
                        {% set a_traiter = boutique_a_traiter() %}
                        <a href="{{ path('app_boutique') }}" class="{{ route starts with 'app_boutique' and route != 'app_boutique_photo' ? 'actif' }}">Boutique{% if a_traiter %} <span class="pastille" title="{{ a_traiter }} commande{{ a_traiter > 1 ? 's' }} à régler ou à préparer">{{ a_traiter }}</span>{% endif %}</a>
                    {% endif %}
                </nav>
                {% endif %}
                <div class="compte">
                    {% if is_granted('ROLE_ADMIN') %}
                        {% set nb_demandes = demandes_medicales() %}
                        <a href="{{ path('app_sponsor_index') }}" class="{{ route starts with 'app_sponsor' ? 'actif' }}">Sponsors</a>
                        <a href="{{ path('app_utilisateur_index') }}" class="{{ route starts with 'app_utilisateur' ? 'actif' }}">Utilisateurs</a>
                        {% if nb_demandes %}<a href="{{ path('app_utilisateur_droits') }}#demandes" title="Demandes d'accès médical à traiter">🔒 <span class="pastille alerte">{{ nb_demandes }} demande{{ nb_demandes > 1 ? 's' }}</span></a>{% endif %}
                        <a href="{{ path('app_categorie_index') }}" class="{{ route starts with 'app_categorie' ? 'actif' }}">Catégories</a>
                        <a href="{{ path('app_club') }}" class="{{ route == 'app_club' ? 'actif' }}" title="Logo et couleurs du club">Apparence</a>
                        <a href="{{ path('app_paiement_en_ligne') }}" class="{{ route starts with 'app_paiement_en_ligne' ? 'actif' }}" title="Paiement en ligne des cotisations (HelloAsso)">Paiement en ligne</a>
                    {% elseif is_granted('ROLE_MEDECIN') %}
                        {% set nb_demandes = demandes_medicales() %}
                        <a href="{{ path('app_utilisateur_droits') }}" class="{{ route starts with 'app_utilisateur' ? 'actif' }}" title="Donner les droits médicaux">Droits médicaux{% if nb_demandes %} <span class="pastille alerte">{{ nb_demandes }}</span>{% endif %}</a>
                    {% endif %}
                    {% set medical_fin = medical_jusqu_a() %}
                    {% if medical_fin %}
                        <form method="post" action="{{ path('app_medical_fermer') }}" class="en-ligne medical-ouvert" title="Accès aux données médicales ouvert par code e-mail">
                            <input type="hidden" name="_token" value="{{ csrf_token('fermer-medical') }}">
                            <span>🔓 Médical jusqu'à {{ medical_fin|date('H:i', 'Europe/Paris') }}</span>
                            <button type="submit" class="lien-bouton">Fermer</button>
                        </form>
                    {% endif %}
                    <a href="{{ path('app_mon_compte') }}" title="Mon compte : changer mon mot de passe">{{ app.user }}</a>
                    <a href="{{ path('app_deconnexion') }}">Déconnexion</a>
                </div>
            </header>
        {% endif %}

        <main class="contenu">
            {% if app.user and club.nom == constant('App\\Command\\ClubDemoCommand::NOM') %}
                <div class="bandeau-demo sans-impression">
                    <span>Club de démonstration : toutes les données sont inventées. Elles reviennent à l'origine chaque nuit.</span>
                    <form method="post" action="{{ path('app_demo_remettre_a_zero') }}" class="en-ligne" data-confirmation="Remettre la démonstration à zéro ? Tout ce qui a été ajouté, modifié ou supprimé sera remis comme à l'origine." data-confirmation-bouton="Remettre à zéro">
                        <input type="hidden" name="_token" value="{{ csrf_token('demo-a-zero') }}">
                        <button type="submit" class="bouton petit">Remettre la démo à zéro</button>
                    </form>
                </div>
            {% endif %}
            {# Les liens d'invitation (« lien_famille ») sont affichés par famille/_liens.html.twig. #}
            {% for type, messages in app.flashes(['succes', 'erreur', 'info']) %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% set liens_famille = app.user ? app.flashes('lien_famille') : [] %}
            {% if liens_famille %}
                {{ include('famille/_liens.html.twig', {liens: liens_famille}) }}
            {% endif %}

            {% block body %}{% endblock %}
        </main>
        {% if app.user and aide_active() %}{{ include('commun/_aide.html.twig') }}{% endif %}
        <footer class="pied sans-impression">
            {% for page in constant('App\\Controller\\LegalController::PAGES') %}<a href="{{ page[0] }}">{{ page[1] }}</a>{% endfor %}
        </footer>
    </body>
</html>
