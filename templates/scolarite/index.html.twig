{% extends 'base.html.twig' %}

{% block title %}Bulletins scolaires{% endblock %}

{% block body %}
    <nav class="onglets">
        <a href="{{ path('app_scolarite_index') }}" class="actif">Bulletins</a>
        <a href="{{ path('app_discipline_index') }}">Discipline</a>
    </nav>

    <div class="titre-page">
        <h1>Bulletins scolaires <span class="compteur">{{ bulletins|length }}</span></h1>
        <a class="bouton principal" href="{{ path('app_bulletin_nouveau') }}">+ Nouveau bulletin</a>
    </div>

    <p class="discret petit">
        Les bulletins repris d'Access étaient des liens vers des PDF du serveur du club (\\Srvstade), qui ne sont pas dans la base.
        Ils sont marqués « PDF à joindre » : leur emplacement d'origine est indiqué pour retrouver le fichier.
    </p>

    <form class="filtres" method="get">
        <input type="search" name="q" value="{{ filtres.q }}" placeholder="Joueur ou libellé">
        <select name="categorie">
            <option value="">Toutes les catégories</option>
            {% for c in categories %}
                <option value="{{ c.id }}" {{ filtres.categorie == c.id ? 'selected' }}>{{ c.nom }}</option>
            {% endfor %}
        </select>
        <select name="pdf">
            <option value="">Avec ou sans PDF</option>
            <option value="avec" {{ filtres.pdf == 'avec' ? 'selected' }}>PDF joint</option>
            <option value="sans" {{ filtres.pdf == 'sans' ? 'selected' }}>PDF à joindre</option>
        </select>
        <button type="submit" class="bouton">Filtrer</button>
    </form>

    <div class="table-defile">
        <table class="liste">
            <thead><tr><th>Joueur</th><th>Catégorie</th><th>Saison</th><th>Bulletin</th><th>PDF</th></tr></thead>
            <tbody>
                {% for b in bulletins %}
                    <tr>
                        <td><a href="{{ path('app_joueur_voir', {id: b.joueur.id, _fragment: 'scolarite'}) }}"><strong>{{ b.joueur.nom }}</strong> {{ b.joueur.prenom }}</a></td>
                        <td>{{ b.joueur.categorie }}</td>
                        <td>{{ b.saison }}</td>
                        <td>{{ b.libelle }}</td>
                        <td class="nowrap">
                            {% if b.fichier %}
                                <a href="{{ path('app_bulletin_pdf', {id: b.id}) }}" target="_blank">Ouvrir</a>
                            {% else %}
                                <a href="{{ path('app_bulletin_modifier', {id: b.id}) }}" title="{{ b.origine }}">Joindre</a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="vide">Aucun bulletin pour ces critères.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
