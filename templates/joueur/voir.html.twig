{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}{{ joueur.nomComplet }}{% endblock %}

{% macro oui_non(libelle, valeur) %}
    <dt>{{ libelle }}</dt><dd>{{ valeur ? 'Oui' : 'Non' }}</dd>
{% endmacro %}

{# Information essentielle : toujours affichée, « non renseigné » si vide, pour voir ce qu'il reste à compléter. #}
{% macro essentiel(libelle, valeur) %}
    <dt>{{ libelle }}</dt><dd>{% if valeur is not same as(null) and valeur != '' %}{{ valeur }}{% else %}<span class="non-renseigne">non renseigné</span>{% endif %}</dd>
{% endmacro %}

{# Ligne du tableau « Matchs » : une saison ou le total (voir BilanJoueur). #}
{% macro ligne_bilan(saison, b) %}
    <tr>
        <td class="principal">{{ saison }}</td>
        <td data-label="matchs">{{ b.matchs }}</td>
        <td data-label="titulaire">{{ b.titularisations }}</td>
        <td data-label="min.">{{ b.minutes }}</td>
        <td data-label="temps">{{ b.minutesPossibles ? (b.minutes * 100 / b.minutesPossibles)|round ~ ' %' }}</td>
        <td data-label="buts">{{ b.buts ?: '' }}</td>
        <td data-label="passes D.">{{ b.passes ?: '' }}</td>
        <td data-label="note">{{ b.note ? b.note|number_format(1, ',') }}</td>
        <td data-label="cartons J/R">{{ b.jaunes or b.rouges ? b.jaunes ~ ' / ' ~ b.rouges }}</td>
        <td data-label="excl. 10'">{{ b.exclusions ?: '' }}</td>
    </tr>
{% endmacro %}
{% import _self as f %}

{% block body %}
    {% set peut_modifier = is_granted('JOUEUR_MODIFIER', joueur) %}
    {# Sections à deux niveaux (voir / modifier), réglées dans le tableau des droits d'accès. #}
    {# Médical (Infirmerie, Visite médicale) : en plus du droit, accès ouvert par code e-mail (voir AccesMedical). #}
    {% set medical = medical_ouvert() %}
    {% set inf_droit, vm_droit = is_granted('ROLE_INFIRMERIE_LECTURE'), is_granted('ROLE_VISITE_MEDICALE_LECTURE') %}
    {% set inf_voir, inf_modif = inf_droit and medical, is_granted('ROLE_INFIRMERIE') and medical %}
    {% set vm_voir, vm_modif = vm_droit and medical, is_granted('ROLE_VISITE_MEDICALE') and medical %}
    {% set medical_verrouille = (inf_droit or vm_droit) and not medical %}
    {% set scol_voir, scol_modif = is_granted('ROLE_SCOLAIRE_LECTURE'), is_granted('ROLE_SCOLAIRE') %}
    {# Tests physiques : modifier seulement pour les joueurs de ses secteurs, ou tous avec l'infirmerie. #}
    {% set tests_voir = is_granted('ROLE_TESTS_PHYSIQUES_LECTURE') %}
    {% set tests_modif = is_granted('ROLE_TESTS_PHYSIQUES') and (peut_modifier or is_granted('ROLE_INFIRMERIE')) %}

    <p><a href="{{ path('app_joueur_index') }}">← Retour à la liste</a></p>

    <div class="titre-page">
        <div class="identite">
            {{ m.avatar(joueur, 'grand') }}
            <div>
                <h1>{{ joueur.prenom }} <strong>{{ joueur.nom }}</strong></h1>
                <p class="discret">
                    {{ joueur.categorie ?? 'Sans catégorie' }}
                    {% if joueur.poste %} · {{ joueur.poste }}{% endif %}
                    {% if joueur.age %} · {{ joueur.age }} ans{% endif %}
                    {% if joueur.ancien %} <span class="pastille">ancien joueur</span>{% endif %}
                </p>
            </div>
        </div>
        <div class="actions">
            {% if peut_modifier %}
                <a class="bouton principal" href="{{ path('app_joueur_modifier', {id: joueur.id}) }}">Modifier</a>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                {{ m.supprimer(path('app_joueur_supprimer', {id: joueur.id}), 'supprimer' ~ joueur.id, 'Supprimer définitivement la fiche de ' ~ joueur.nomComplet ~ ' ?') }}
            {% endif %}
        </div>
    </div>

    <nav class="sommaire">
        <a href="#fiche">Fiche</a>
        <a href="#matchs">Matchs</a>
        <a href="#presences">Présences</a>
        {% if famille %}<a href="#famille">Accès famille</a>{% endif %}
        {% if scol_voir or sanctions %}<a href="#scolarite">Scolarité et discipline</a>{% endif %}
        {% if medical_verrouille %}<a href="#medical-verrou">🔒 Médical</a>{% endif %}
        {% if not (inf_droit and vm_droit) %}<a href="{{ path('app_demande_medicale', {section: inf_droit ? 'visite_medicale' : 'infirmerie'}) }}" title="Demander au médecin du club l'accès aux données médicales">🔒 Demander l'accès médical</a>{% endif %}
        {% if inf_voir %}<a href="#infirmerie">Infirmerie</a>{% endif %}
        {% if vm_voir %}<a href="#visite-medicale">Visite médicale</a>{% endif %}
        {% if tests_voir %}<a href="#physique">Tests physiques</a>{% endif %}
    </nav>

    <div class="grille-fiches" id="fiche">
        <section class="carte">
            <h2>Identité</h2>
            <dl>
                {{ m.ligne('Surnom', joueur.surnom) }}
                {{ f.essentiel('Date de naissance', joueur.dateNaissance ? joueur.dateNaissance|date('d/m/Y')) }}
                {{ m.ligne('Lieu de naissance', joueur.lieuNaissance) }}
                {{ m.ligne('Nationalité', joueur.nationalite) }}
            </dl>
        </section>

        <section class="carte">
            <h2>Club</h2>
            <dl>
                {{ f.essentiel('Catégorie', joueur.categorie) }}
                {% if joueur.educateur %}
                    <dt>Éducateur</dt><dd><a href="{{ path('app_intervenant_voir', {type: 'educateurs', id: joueur.educateur.id}) }}">{{ joueur.educateur }}</a></dd>
                {% else %}
                    {{ f.essentiel('Éducateur', null) }}
                {% endif %}
                {{ f.essentiel('N° de licence', joueur.licence) }}
                {{ f.essentiel('Poste', joueur.poste) }}
                {{ f.essentiel('Pied fort', joueur.pied) }}
                {{ m.ligne("Arrivé le", joueur.dateArrivee ? joueur.dateArrivee|date('d/m/Y')) }}
                {{ f.oui_non('Sélectionné', joueur.selectionne) }}
            </dl>
        </section>

        <section class="carte">
            <h2>Coordonnées</h2>
            <dl>
                {{ m.ligne('Adresse', joueur.adresse) }}
                {{ m.ligne('Ville', [joueur.codePostal, joueur.ville]|filter(v => v)|join(' ')) }}
                {{ m.ligne('Portable joueur', joueur.telJoueur) }}
                {{ m.ligne('E-mail joueur', joueur.emailJoueur) }}
            </dl>
        </section>

        <section class="carte">
            <h2>Famille</h2>
            <dl>
                {% if joueur.avecParents %}
                    {{ m.ligne('Parent 1', joueur.nomParent1) }}
                    {{ m.ligne('Profession parent 1', joueur.professionParent1) }}
                    {{ m.ligne('Portable parent 1', joueur.telPortable1) }}
                    {{ m.ligne('E-mail parent 1', joueur.emailParent1) }}
                    {{ m.ligne('Parent 2', joueur.nomParent2) }}
                    {{ m.ligne('Profession parent 2', joueur.professionParent2) }}
                    {{ m.ligne('Portable parent 2', joueur.telPortable2) }}
                    {{ m.ligne('E-mail parent 2', joueur.emailParent2) }}
                {% endif %}
                {{ f.oui_non("Droit à l'image", joueur.droitImage) }}
                {{ f.oui_non('Transport éducateur', joueur.transportEducateur) }}
                {% if joueur.avecParents %}
                    {{ f.oui_non('Transport parent', joueur.transportParent) }}
                {% endif %}
            </dl>
        </section>

        <section class="carte">
            <h2>Scolarité</h2>
            <dl>
                {{ m.ligne('Classe', joueur.niveauScolaire) }}
                {{ m.ligne('École', joueur.ecole) }}
                {{ m.ligne('Établissement', joueur.etablissement) }}
                {{ m.ligne('Régime', joueur.situationScolaire) }}
            </dl>
        </section>

        {% if detection %}
            <section class="carte">
                <h2>Détection</h2>
                <p>Détecté le {{ detection.dateDetection ? detection.dateDetection|date('d/m/Y') : '?' }}{% if detection.clubActuel %} (venait de {{ detection.clubActuel }}){% endif %}.</p>
                <a href="{{ path('app_detection_voir', {id: detection.id}) }}">Voir la fiche de détection</a>
            </section>
        {% endif %}

        {% if inf_voir %}
            <section class="carte medical">
                <h2>Médical <span class="pastille">confidentiel</span></h2>
                <dl>
                    {{ m.ligne("Nom de l'assuré", joueur.nomAssure) }}
                    {{ m.ligne('N° de sécurité sociale', joueur.numeroSecu) }}
                    {{ m.ligne('Médecin traitant', joueur.medecin) }}
                    {{ m.ligne('Tél. médecin', joueur.telMedecin) }}
                    {{ m.ligne('Renseignements', joueur.renseignementsMedicaux) }}
                </dl>
            </section>
        {% endif %}

        {% if joueur.memo %}
            <section class="carte">
                <h2>Mémo</h2>
                <p class="memo">{{ joueur.memo }}</p>
            </section>
        {% endif %}
    </div>

    {# ---------- Matchs ---------- #}
    <section class="bloc" id="matchs">
        <h2 class="titre-bloc">Matchs</h2>
        {% if bilan %}
            <div class="table-defile">
                <table class="liste chiffres liste-fiches">
                    <thead>
                        <tr><th>Saison</th><th>Matchs</th><th>Titulaire</th><th>Minutes</th><th title="Part des minutes jouées sur les matchs où il figurait sur la feuille de match">% minutes</th><th>Buts</th><th>Passes D.</th><th>Note moy.</th><th>Cartons J / R</th><th title="Exclusions temporaires de 10 minutes">Excl. 10'</th></tr>
                    </thead>
                    <tbody>
                        {% for saison, b in bilan|filter((b, saison) => saison != 'Total') %}
                            {{ f.ligne_bilan(saison, b) }}
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        {{ f.ligne_bilan('Total', bilan.Total) }}
                    </tfoot>
                </table>
            </div>
            <p class="discret petit">Statistiques des matchs ayant une feuille de match (aucune pour l'école de foot). % minutes : temps de jeu rapporté à la durée des matchs où il figurait sur la feuille.</p>

            {% if matchs %}
                <h3>Derniers matchs</h3>
                <div class="table-defile">
                    <table class="liste liste-fiches">
                        <thead><tr><th>Date</th><th>Match</th><th>Score</th><th>Poste</th><th>Min.</th><th>Note</th><th>Appréciation</th></tr></thead>
                        <tbody>
                            {% for p in matchs %}
                                {% set r = p.rencontre %}
                                <tr>
                                    <td class="nowrap">{{ r.date ? r.date|date('d/m/Y') }}</td>
                                    <td class="principal etroit"><a href="{{ path('app_rencontre_voir', {id: r.id}) }}">{{ r.domicile }} – {{ r.exterieur }}</a> <span class="discret">{{ r.equipeAffichee }}</span></td>
                                    <td class="a-cote">{{ m.score(r) }}</td>
                                    <td>{{ p.poste }}</td>
                                    <td data-label="min.">{{ p.tempsJeu }}</td>
                                    <td data-label="note">{{ p.note ? p.note|number_format(1, ',') }}</td>
                                    <td class="petit">{{ p.appreciation }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% else %}
            <p class="discret">Aucun match enregistré.</p>
        {% endif %}
    </section>

    {# ---------- Présences ---------- #}
    <section class="bloc" id="presences">
        <h2 class="titre-bloc">Présences à l'entraînement</h2>
        {% if presences %}
            <div class="table-defile">
                <table class="liste chiffres liste-fiches">
                    <thead><tr><th>Saison</th><th>Séances</th><th>Présent</th><th>Taux</th><th>Absences</th></tr></thead>
                    <tbody>
                        {% for saison, b in presences %}
                            <tr>
                                <td class="principal">{{ saison }}</td>
                                <td data-label="séances">{{ b.seances }}</td>
                                <td data-label="présent">{{ b.presences }}</td>
                                <td><span class="jauge"><span style="width: {{ b.taux ?? 0 }}%"></span></span> {{ b.taux }} %</td>
                                <td class="texte petit">{% for motif, n in b.absences %}{{ motif }} : {{ n }}{{ not loop.last ? ' · ' }}{% endfor %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="discret">Aucune présence enregistrée.</p>
        {% endif %}
    </section>

    {# ---------- Accès famille ---------- #}
    {% if famille %}
        <section class="bloc" id="famille">
            <div class="titre-page">
                <h2 class="titre-bloc">Accès famille</h2>
                {% if famille.a_inviter|length > 1 %}
                    <form method="post" action="{{ path('app_famille_inviter', {id: joueur.id}) }}" class="en-ligne">
                        <input type="hidden" name="_token" value="{{ csrf_token('inviter-famille' ~ joueur.id) }}">
                        <button class="bouton">Inviter toutes les adresses</button>
                    </form>
                {% endif %}
            </div>
            <p class="discret petit">
                Le joueur et ses parents reçoivent un lien pour choisir leur mot de passe. Ils accèdent ensuite à leur espace
                (prochains matchs, réponse aux convocations), sans jamais voir les autres pages de l'application.
            </p>
            {% if famille.majeur %}
                <p class="flash flash-info petit">
                    {{ joueur.prenom }} est majeur(e) : le club n'invite que lui ou elle. C'est {{ joueur.prenom }} qui décide
                    de l'accès de ses parents, depuis son espace (rubrique « Accès de mes parents »).
                    {% if not joueur.emailJoueur %}Ajoutez d'abord son adresse e-mail sur la fiche (bouton « Modifier »).{% endif %}
                </p>
            {% endif %}
            {% if famille.comptes or famille.a_inviter %}
                <ul class="liste-simple carte">
                    {% for c in famille.comptes %}
                        <li class="avec-actions">
                            <span>
                                <strong>{{ c.email }}</strong>
                                {% if c.statutAcces == 'actif' %}
                                    <span class="pastille succes">compte actif</span>
                                {% elseif c.statutAcces == 'invite' %}
                                    <span class="pastille">invité le {{ c.inviteLe|date('d/m/Y') }}, lien valable jusqu'au {{ c.jetonExpireLe|date('d/m/Y') }}</span>
                                {% else %}
                                    <span class="pastille alerte">lien expiré</span>
                                {% endif %}
                                {% if c.joueurs|length > 1 %}<span class="discret petit">· suit aussi {{ c.joueurs|filter(j => j != joueur)|map(j => j.prenom)|join(', ') }}</span>{% endif %}
                            </span>
                            <span class="nowrap">
                                {% if c.statutAcces != 'actif' %}
                                    <form method="post" action="{{ path('app_famille_inviter', {id: joueur.id}) }}" class="en-ligne">
                                        <input type="hidden" name="_token" value="{{ csrf_token('inviter-famille' ~ joueur.id) }}">
                                        <input type="hidden" name="email" value="{{ c.email }}">
                                        <button class="bouton petit">Nouveau lien</button>
                                    </form>
                                {% endif %}
                                {{ m.supprimer(path('app_famille_retirer', {id: joueur.id, compte: c.id}), 'retirer-famille' ~ c.id, 'Retirer l\'accès de ' ~ c.email ~ ' à ' ~ joueur.prenom ~ ' ?', 'Retirer') }}
                            </span>
                        </li>
                    {% endfor %}
                    {% for email, qui in famille.a_inviter %}
                        <li class="avec-actions">
                            <span><strong>{{ email }}</strong> <span class="discret petit">· e-mail {{ {joueur: 'du joueur', parent1: 'du parent 1', parent2: 'du parent 2'}[qui] }}</span> <span class="pastille">pas encore invité</span></span>
                            <form method="post" action="{{ path('app_famille_inviter', {id: joueur.id}) }}" class="en-ligne">
                                <input type="hidden" name="_token" value="{{ csrf_token('inviter-famille' ~ joueur.id) }}">
                                <input type="hidden" name="email" value="{{ email }}">
                                <button class="bouton petit principal">Inviter</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="discret">Aucune adresse e-mail sur la fiche : ajoutez celle du joueur ou des parents (bouton « Modifier ») pour pouvoir les inviter.</p>
            {% endif %}
        </section>
    {% endif %}

    {# ---------- Scolarité et discipline ---------- #}
    {# Droit Scolarité : « voir » ou « modifier ». Les éducateurs du joueur voient aussi ses sanctions (suspensions). #}
    {% if scol_voir or sanctions %}
        <section class="bloc" id="scolarite">
            {% if scol_voir %}
                <div class="titre-page">
                    <h2 class="titre-bloc">Bulletins scolaires</h2>
                    {% if scol_modif %}<a class="bouton" href="{{ path('app_bulletin_nouveau', {joueur: joueur.id}) }}">+ Bulletin</a>{% endif %}
                </div>
                {% if bulletins %}
                    <ul class="liste-simple carte">
                        {% for b in bulletins %}
                            <li class="avec-actions">
                                <span>
                                    <span class="discret">{{ b.saison }}</span> {{ b.libelle }}
                                    {% if not b.fichier and b.origine %}<span class="pastille" title="{{ b.origine }}">PDF à joindre</span>{% endif %}
                                </span>
                                <span class="nowrap">
                                    {% if b.fichier %}<a href="{{ path('app_bulletin_pdf', {id: b.id}) }}" target="_blank">Ouvrir le PDF</a>{% endif %}
                                    {% if scol_modif %}{{ b.fichier ? ' · ' }}<a href="{{ path('app_bulletin_modifier', {id: b.id}) }}">{{ b.fichier ? 'Modifier' : 'Joindre le PDF' }}</a>{% endif %}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="discret">Aucun bulletin.</p>
                {% endif %}
            {% endif %}

            <div class="titre-page">
                <h2 class="titre-bloc">Discipline</h2>
                {% if scol_modif %}<a class="bouton" href="{{ path('app_sanction_nouvelle', {joueur: joueur.id}) }}">+ Incident</a>{% endif %}
            </div>
            {% if sanctions %}
                <div class="table-defile">
                    <table class="liste liste-fiches">
                        <thead><tr><th>Date</th><th>Lieu</th><th>Motif</th><th>Sanction sportive</th><th>Sanction scolaire</th><th>Gravité</th>{% if scol_modif %}<th></th>{% endif %}</tr></thead>
                        <tbody>
                            {% for s in sanctions %}
                                <tr>
                                    <td class="nowrap">{{ s.date|date('d/m/Y') }}</td>
                                    <td>{{ s.lieu }}</td>
                                    <td class="principal etroit">{{ s.motif }}</td>
                                    <td data-label="sportive :">{{ s.sanctionSportive }}</td>
                                    <td data-label="scolaire :">{{ s.sanctionScolaire }}</td>
                                    <td data-label="gravité">{{ s.graviteLibelle }}</td>
                                    {% if scol_modif %}<td class="a-cote"><a href="{{ path('app_sanction_modifier', {id: s.id}) }}">Modifier</a></td>{% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="discret">Aucun incident.</p>
            {% endif %}
        </section>
    {% endif %}

    {# ---------- Médical verrouillé : droit présent, code e-mail pas encore saisi ---------- #}
    {% if medical_verrouille %}
        <section class="bloc carte verrou-medical" id="medical-verrou">
            <p><strong>🔒 Données médicales</strong><br><span class="discret petit">{{ [inf_droit ? 'renseignements médicaux et blessures', vm_droit ? 'visite médicale']|filter(v => v)|join(', ')|capitalize }} : confidentiel, accès par code reçu par e-mail.</span></p>
            <a class="bouton principal" href="{{ path('app_medical_code', {retour: path('app_joueur_voir', {id: joueur.id}) ~ '#' ~ (inf_droit ? 'infirmerie' : 'visite-medicale')}) }}">Ouvrir avec un code</a>
        </section>
    {% endif %}

    {# ---------- Infirmerie (blessures) ---------- #}
    {% if inf_voir %}
        <section class="bloc" id="infirmerie">
            <div class="titre-page">
                <h2 class="titre-bloc">Blessures <span class="pastille">confidentiel</span></h2>
                {% if inf_modif %}<a class="bouton" href="{{ path('app_blessure_nouvelle', {joueur: joueur.id}) }}">+ Blessure</a>{% endif %}
            </div>
            {% if blessures %}
                <div class="table-defile">
                    <table class="liste liste-fiches">
                        <thead><tr><th>Date</th><th>Blessure</th><th>Circonstances</th><th>Reprise</th><th>Durée</th>{% if inf_modif %}<th></th>{% endif %}</tr></thead>
                        <tbody>
                            {% for b in blessures %}
                                <tr>
                                    <td class="nowrap">{{ b.date ? b.date|date('d/m/Y') : '?' }}</td>
                                    <td class="principal etroit">{{ b.libelle }}{% if b.enCours %} <span class="pastille alerte">en cours</span>{% endif %}</td>
                                    <td>{{ b.lieu }}{% if b.avecArret is not null %} · {{ b.avecArret ? 'avec arrêt' : 'sans arrêt' }}{% endif %}</td>
                                    <td class="nowrap" data-label="reprise">{{ b.dateReprise ? b.dateReprise|date('d/m/Y') }}</td>
                                    <td data-label="durée">{{ b.duree is not null ? b.duree ~ ' j' }}</td>
                                    {% if inf_modif %}<td class="a-cote"><a href="{{ path('app_blessure_modifier', {id: b.id}) }}">Modifier</a></td>{% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="discret">Aucune blessure enregistrée.</p>
            {% endif %}
        </section>
    {% endif %}

    {# ---------- Visite médicale (poids, taille...) : droit « Visite médicale » ---------- #}
    {% if vm_voir %}
        <section class="bloc" id="visite-medicale">
            <div class="titre-page">
                <h2 class="titre-bloc">Visite médicale <span class="pastille">confidentiel</span></h2>
                {% if vm_modif %}<a class="bouton" href="{{ path('app_mesure_nouvelle', {id: joueur.id}) }}">+ Visite</a>{% endif %}
            </div>
            {% if mesures %}
                <div class="table-defile">
                    <table class="liste chiffres liste-fiches">
                        <thead><tr><th>Date</th><th>Poids</th><th>Taille</th><th>IMC</th><th>Taille assis</th><th>Pointure</th>{% if vm_modif %}<th></th>{% endif %}</tr></thead>
                        <tbody>
                            {% for x in mesures %}
                                <tr>
                                    <td class="principal etroit">{{ x.date|date('d/m/Y') }}</td>
                                    <td data-label="poids">{{ x.poids ? x.poids|number_format(1, ',') ~ ' kg' }}</td>
                                    <td data-label="taille">{{ x.taille ? x.taille|number_format(2, ',') ~ ' m' }}</td>
                                    <td data-label="IMC">{{ x.imc ? x.imc|number_format(1, ',') }}</td>
                                    <td data-label="taille assis">{{ x.tailleAssis ? x.tailleAssis|number_format(2, ',') ~ ' m' }}</td>
                                    <td data-label="pointure">{{ x.pointure }}</td>
                                    {% if vm_modif %}<td class="a-cote">{{ m.supprimer(path('app_mesure_supprimer', {id: x.id}), 'supprimer-mesure' ~ x.id, 'Supprimer cette visite ?', '×') }}</td>{% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="discret">Aucune visite médicale enregistrée.</p>
            {% endif %}
        </section>
    {% endif %}

    {# ---------- Tests physiques : droit « Tests physiques » ---------- #}
    {% if tests_voir %}
        <section class="bloc" id="physique">
            <div class="titre-page">
                <h2 class="titre-bloc">Tests physiques</h2>
                {% if tests_modif %}<a class="bouton" href="{{ path('app_test_nouveau', {id: joueur.id}) }}">+ Test</a>{% endif %}
            </div>
            {% if tests %}
                {% set epreuves = constant('App\\Entity\\TestPhysique::EPREUVES') %}
                <div class="table-defile">
                    <table class="liste chiffres liste-fiches">
                        <thead>
                            <tr>
                                <th>Date</th>
                                {% for champ, e in epreuves %}<th>{{ e[0] }} <span class="discret">({{ e[1] }})</span></th>{% endfor %}
                                {% if tests_modif %}<th></th>{% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for t in tests %}
                                <tr>
                                    <td class="principal etroit">{{ t.date|date('d/m/Y') }}</td>
                                    {% for champ, e in epreuves %}
                                        {% set v = attribute(t, champ) %}
                                        <td data-label="{{ e[0] }} ({{ e[1] }})">{{ v is not null ? v|number_format(2, ',')|trim('0', 'right')|trim(',', 'right') }}</td>
                                    {% endfor %}
                                    {% if tests_modif %}<td class="a-cote">{{ m.supprimer(path('app_test_supprimer', {id: t.id}), 'supprimer-test' ~ t.id, 'Supprimer ce test ?', '×') }}</td>{% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="discret">Aucun test enregistré.</p>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
