{% extends 'base.html.twig' %}

{% block title %}Listing – {{ titre }}{% endblock %}

{% block body %}
    {% set externe = qui in ['medical', 'partenaires', 'exterieurs'] %}
    {% set avec_groupe = categorie is null and qui in ['joueurs', 'encadrement', 'tous', 'exterieurs'] %}
    {% set avec_fonction = qui != 'joueurs' %}
    <div class="impression-a4">
    <p class="lien-retour sans-impression"><a href="{{ path('app_joueur_effectifs') }}">← Effectifs</a></p>
    <div class="titre-page">
        <h1>
            {{ app.user.club.nom ?? '' }} · {{ titre }}
            <span class="compteur">{{ lignes|length }} {{ accord(lignes|length, qui == 'joueurs' ? 'joueur' : 'personne') }}</span>
        </h1>
        <span class="actions sans-impression">
            <button type="button" class="bouton" onclick="window.print()">Imprimer</button>
            <a class="bouton" href="{{ path('app_joueur_listing', {qui: qui, categorie: categorie ? categorie.id, format: 'csv'}|filter(v => v)) }}">Ouvrir dans Excel</a>
        </span>
    </div>

    <form class="filtres sans-impression" method="get">
        <select name="qui" onchange="this.form.categorie && (this.form.categorie.value = ''); this.form.requestSubmit()">
            <option value="joueurs" {{ qui == 'joueurs' ? 'selected' }}>Joueurs</option>
            {% for type, t in types %}
                <option value="{{ type }}" {{ qui == type ? 'selected' }}>{{ t.libelle }}</option>
            {% endfor %}
            <option value="encadrement" {{ qui == 'encadrement' ? 'selected' }}>Tout l'encadrement</option>
            <option value="tous" {{ qui == 'tous' ? 'selected' }}>Tout le club (joueurs et encadrement)</option>
            {% for cle, libelle in exterieurs %}
                <option value="{{ cle }}" {{ qui == cle ? 'selected' }}>{{ libelle }}</option>
            {% endfor %}
            {% if exterieurs|length > 1 %}
                <option value="exterieurs" {{ qui == 'exterieurs' ? 'selected' }}>Tous les extérieurs</option>
            {% endif %}
        </select>
        {% if qui == 'joueurs' %}
            <select name="categorie" onchange="this.form.requestSubmit()">
                <option value="">Toutes les catégories</option>
                {% for c in categories %}
                    <option value="{{ c.id }}" {{ categorie and categorie.id == c.id ? 'selected' }}>{{ c.nom }}</option>
                {% endfor %}
            </select>
        {% endif %}
        <noscript><button type="submit" class="bouton">Afficher</button></noscript>
    </form>
    <p class="discret petit">{{ qui == 'joueurs' ? 'Joueurs actifs' : (qui == 'medical' ? 'Médecins, kinés et spécialistes avec qui travaille l\'infirmerie' : (externe ? 'Contacts extérieurs du club' : 'Personnes en activité')) }}, au {{ 'now'|date('d/m/Y') }}.</p>

    <div class="table-defile">
        <table class="liste listing">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    {% if avec_groupe %}<th>{{ qui == 'joueurs' ? 'Catégorie' : (qui == 'tous' ? 'Catégorie ou rôle' : 'Rôle') }}</th>{% endif %}
                    {% if avec_fonction %}<th>{{ qui == 'tous' ? 'Poste ou fonction' : (externe ? 'Profession ou type' : 'Fonction') }}</th>{% endif %}
                    {% if not externe %}<th>Né le</th><th>Âge</th>{% endif %}
                    <th>Adresse</th>
                    <th>Téléphone</th>
                    {% if not externe %}<th>N° de licence</th>{% else %}<th>E-mail</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for l in lignes %}
                    <tr>
                        <td class="fort"><a href="{{ l.lien }}">{{ l.nom }}</a></td>
                        <td>{{ l.prenom }}</td>
                        {% if avec_groupe %}<td>{{ l.groupe }}</td>{% endif %}
                        {% if avec_fonction %}<td>{{ l.fonction }}</td>{% endif %}
                        {% if not externe %}
                            <td class="sans-retour">{{ l.ne ? l.ne|date('d/m/Y') }}</td>
                            <td class="sans-retour">{{ l.age is not null ? l.age ~ ' ans' }}</td>
                        {% endif %}
                        <td>{{ l.adresse }}{% if l.cp or l.ville %}{{ l.adresse ? ', ' }}{{ [l.cp, l.ville]|filter(v => v)|join(' ') }}{% endif %}</td>
                        <td>
                            {% for t in l.tels|filter(v => v) %}
                                <span class="sans-retour">{{ t }}</span>{% if not loop.last %}<br>{% endif %}
                            {% endfor %}
                        </td>
                        <td>{{ externe ? l.email : l.licence }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="9" class="vide">Personne dans cette liste.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="discret petit sans-impression">
        {% if not externe %}Téléphones : {{ qui == 'joueurs' ? 'celui du joueur puis ceux des parents' : (qui == 'tous' ? 'pour un joueur, le sien puis ceux des parents ; pour l\'encadrement, les portables puis le fixe' : 'les portables puis le fixe') }}.
        Le fichier Excel donne aussi l'e-mail.{% endif %}
    </p>
    </div>
{% endblock %}
