{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Détections{% endblock %}

{% block body %}
    {% include 'recrutement/_onglets.html.twig' with {onglet: 'detections'} %}

    <div class="titre-page">
        <h1>Détections <span class="compteur">{{ detections|length }}</span></h1>
        <a class="bouton principal" href="{{ path('app_detection_nouvelle') }}">+ Nouvelle détection</a>
    </div>

    <form class="filtres" method="get">
        <input type="search" name="q" value="{{ filtres.q }}" placeholder="Nom ou club">
        <select name="annee" onchange="this.form.requestSubmit()">
            <option value="">Toutes les années de détection</option>
            {% for a in annees %}<option value="{{ a }}" {{ filtres.annee == a ? 'selected' }}>Détections {{ a }}</option>{% endfor %}
        </select>
        <select name="generation" onchange="this.form.requestSubmit()">
            <option value="">Toutes les générations</option>
            {% for g in generations %}<option value="{{ g }}" {{ filtres.generation == g ? 'selected' }}>Nés en {{ g }}</option>{% endfor %}
        </select>
        <label class="case-filtre"><input type="checkbox" name="retenus" value="1" {{ filtres.retenus ? 'checked' }} onchange="this.form.requestSubmit()"> Retenus seulement</label>
        <button type="submit" class="bouton">Filtrer</button>
    </form>

    <div class="table-defile">
        <table class="liste liste-fiches">
            <thead><tr><th>Enfant</th><th>Né en</th><th>Poste</th><th>Club actuel</th><th>Niveau</th><th>Détecté le</th><th>Suite</th></tr></thead>
            <tbody>
                {% for d in detections %}
                    <tr>
                        <td class="avec-vignette nowrap principal etroit">{{ m.avatar(d, 'mini') }} <a href="{{ path('app_detection_voir', {id: d.id}) }}"><strong>{{ d.nom }}</strong> {{ d.prenom }}</a></td>
                        <td data-label="né en">{{ d.generation }}</td>
                        <td>{{ d.poste }}</td>
                        <td>{{ d.clubActuel }}</td>
                        <td data-label="niveau">{{ d.niveau }}</td>
                        <td class="nowrap" data-label="détecté le">{{ d.dateDetection ? d.dateDetection|date('d/m/Y') }}</td>
                        <td class="nowrap a-cote">
                            {% if d.joueur %}
                                <a href="{{ path('app_joueur_voir', {id: d.joueur.id}) }}" class="pastille succes">au club</a>
                            {% elseif d.retenu %}
                                <span class="pastille">retenu</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="vide">Aucune détection pour ces critères.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
