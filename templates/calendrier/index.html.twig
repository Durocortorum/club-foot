{% extends 'base.html.twig' %}

{% block title %}Calendrier{% endblock %}

{% block body %}
    <div class="titre-page">
        <h1>Calendrier</h1>
        <span class="actions">
            <a class="bouton" href="{{ path('app_evenement_index') }}">Événements</a>
            <a class="bouton" href="{{ path('app_stage_index') }}">Stages</a>
            <a class="bouton" href="{{ path('app_tournoi_index') }}">Tournois</a>
            <a class="bouton" href="{{ path('app_rencontre_index') }}">Matchs</a>
            {% if peut_planifier %}<a class="bouton" href="{{ path('app_planning') }}">Planning des entraînements</a>{% endif %}
        </span>
    </div>

    <form class="filtres" method="get">
        <input type="hidden" name="mois" value="{{ mois|date('Y-m') }}">
        <select name="categorie" onchange="this.form.requestSubmit()" aria-label="Équipe">
            <option value="">Toutes les équipes</option>
            {% for c in categories %}
                <option value="{{ c.id }}" {{ choisie and choisie.id == c.id ? 'selected' }}>{{ c.nom }}</option>
            {% endfor %}
        </select>
        <noscript><button type="submit" class="bouton">Filtrer</button></noscript>
    </form>

    <div class="calendrier-entete">
        <a class="bouton petit" href="{{ path('app_calendrier', {mois: precedent}) }}" aria-label="Mois précédent">←</a>
        <h2>{{ titre }}</h2>
        <a class="bouton petit" href="{{ path('app_calendrier', {mois: suivant}) }}" aria-label="Mois suivant">→</a>
        {% if mois|date('Y-m') != aujourdhui|date('Y-m') %}
            <a class="bouton petit" href="{{ path('app_calendrier') }}">Aujourd'hui</a>
        {% endif %}
        <span class="calendrier-legende">
            <span class="cal-activite cal-match">Match</span>
            <span class="cal-activite cal-entrainement">Entraînement</span>
            <span class="cal-activite cal-evenement">Événement</span>
            <span class="cal-activite cal-stage">Stage</span>
            <span class="cal-activite cal-tournoi">Tournoi</span>
            <span class="cal-activite cal-seance">Séance seule</span>
        </span>
    </div>

    {% include 'calendrier/_grille.html.twig' with {avec_equipe: not choisie} %}
    {% if not jours %}
        <p class="vide">Aucun match ni entraînement ce mois-ci{{ choisie ? ' pour ' ~ choisie.nom }}.</p>
    {% endif %}
{% endblock %}
