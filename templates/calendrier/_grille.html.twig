{# Grille d'un mois (voir CalendrierMois). Variables : semaines, jours, mois, aujourdhui, titre ;
   avec_equipe : afficher l'équipe de chaque activité ; famille : espace famille (pas de liens vers les pages de l'encadrement,
   pas de séances) ; peut_planifier : liens vers le planning et les séances (encadrement). #}
{% set famille = famille ?? false %}
{% set peut_planifier = not famille and (peut_planifier ?? false) %}
<div class="calendrier" role="table" aria-label="Calendrier de {{ titre }}">
    <div class="calendrier-jours" role="row">
        {% for j in ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'] %}
            <div role="columnheader">{{ j }}</div>
        {% endfor %}
    </div>
    {% for semaine in semaines %}
        <div class="calendrier-semaine" role="row">
            {% for jour in semaine %}
                {% set cle = jour|date('Y-m-d') %}
                {% set activites = jours[cle] ?? [] %}
                <div role="cell" class="calendrier-jour{{ jour|date('m') != mois|date('m') ? ' hors-mois' }}{{ cle == aujourdhui ? ' aujourdhui' }}{{ activites ? '' : ' sans-activite' }}">
                    <div class="calendrier-date">
                        <span class="jour-semaine">{{ ['Lun.', 'Mar.', 'Mer.', 'Jeu.', 'Ven.', 'Sam.', 'Dim.'][jour|date('N') - 1] }}</span>
                        {{ jour|date('j') }}
                    </div>
                    {% for a in activites %}
                        {% set o = a.objet %}
                        {% set balise = famille ? 'span' : 'a' %}
                        {% if a.type == 'match' %}
                            {% set details = a.details ?? null %}
                            <{{ balise }} class="cal-activite cal-match{{ details and details.convoque ? ' convoque' }}" {% if not famille %}href="{{ path('app_rencontre_voir', {id: o.id}) }}"{% endif %} title="{{ o }}{{ o.lieu ? ' – ' ~ o.lieu }}">
                                <span class="cal-heure">{{ a.heure ? a.heure|replace({':': 'h'}) : 'heure ?' }}{% if avec_equipe %} · {{ o.equipeAffichee }}{% endif %}</span>
                                <span class="cal-titre">{{ o.adversaire }} <small>({{ o.aDomicile ? 'dom.' : 'ext.' }})</small></span>
                                {% if o.butsDomicile is not null %}<span class="cal-score">{{ o.butsDomicile }} – {{ o.butsExterieur }}</span>{% endif %}
                                {% if details and details.convoque %}<span class="cal-convoque">convoqué{{ details.qui ? ' : ' ~ details.qui }}</span>{% endif %}
                            </{{ balise }}>
                        {% elseif a.type == 'evenement' %}
                            <{{ balise }} class="cal-activite cal-evenement" {% if not famille %}href="{{ path('app_evenement_index', o.dernierJour < date('today') ? {periode: 'passes'} : {}) }}#evenement-{{ o.id }}"{% endif %} title="{{ o.type }} : {{ o.titre }}{{ o.lieu ? ' – ' ~ o.lieu }}">
                                <span class="cal-heure">{{ a.heure ? a.heure|replace({':': 'h'}) : 'suite' }}{% if avec_equipe %} · {{ o.toutLeClub ? 'club' : o.categories|map(c => c.nom)|join(', ') }}{% endif %}</span>
                                <span class="cal-titre">{{ o.titre }}</span>
                            </{{ balise }}>
                        {% elseif a.type == 'stage' %}
                            <{{ balise }} class="cal-activite cal-stage" {% if not famille %}href="{{ path('app_stage_voir', {id: o.id}) }}"{% endif %} title="Stage : {{ o.titre }}{{ o.lieu ? ' – ' ~ o.lieu }}">
                                <span class="cal-heure">{{ a.premier ? (o.horaires ?: 'Stage') : 'suite' }}{% if avec_equipe %} · {{ o.toutLeClub ? 'club' : o.categories|map(c => c.nom)|join(', ') }}{% endif %}</span>
                                <span class="cal-titre">{{ o.titre }}</span>
                            </{{ balise }}>
                        {% elseif a.type == 'tournoi' %}
                            <{{ balise }} class="cal-activite cal-tournoi" {% if not famille %}href="{{ path('app_tournoi_voir', {id: o.id}) }}"{% endif %} title="Tournoi : {{ o.nom }}{{ o.lieu ? ' – ' ~ o.lieu }}">
                                <span class="cal-heure">{{ a.premier ? 'Tournoi' : 'suite' }}{% if avec_equipe %} · {{ o.categorie }}{% endif %}</span>
                                <span class="cal-titre">{{ o.nom }}</span>
                            </{{ balise }}>
                        {% elseif a.type == 'seance' %}
                            {# Séance préparée un jour sans entraînement prévu de l'équipe. #}
                            <{{ peut_planifier ? 'a' : 'span' }} class="cal-activite cal-seance" {% if peut_planifier %}href="{{ path('app_seance_voir', {id: o.id}) }}"{% endif %} title="Séance {{ o.categorie }} : {{ o.theme }}">
                                <span class="cal-heure">Séance{% if avec_equipe %} · {{ o.categorie }}{% endif %}</span>
                                <span class="cal-titre">{{ o.theme ?: 'sans thème' }}</span>
                            </{{ peut_planifier ? 'a' : 'span' }}>
                        {% else %}
                            {% set lien = peut_planifier ? path('app_planning', {categorie: o.categorie.id} + (o.date > date('+28 days') ? {periode: 'saison'} : {})) ~ '#entrainement-' ~ o.id : null %}
                            {% set themes = famille ? '' : a.seances|map(s => s.theme)|filter(t => t)|join(', ') %}
                            <{{ lien ? 'a' : 'span' }} class="cal-activite cal-entrainement{{ o.annule ? ' annule' }}" {% if lien %}href="{{ lien }}"{% endif %} title="Entraînement {{ o.categorie }}{{ o.lieu ? ' – ' ~ o.lieu }}{{ themes ? ' – séance : ' ~ themes }}{{ o.annule ? ' (annulé)' }}">
                                <span class="cal-heure">{{ a.heure|replace({':': 'h'}) }}{% if avec_equipe %} · {{ o.categorie }}{% endif %}</span>
                                <span class="cal-titre">{{ o.annule ? 'Annulé' : 'Entraînement' }}{% if themes and not o.annule %} · {{ themes }}{% endif %}</span>
                            </{{ lien ? 'a' : 'span' }}>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    {% endfor %}
</div>
