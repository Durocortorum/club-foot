{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Matchs{% endblock %}

{% block body %}
    <div class="titre-page">
        <h1>Matchs <span class="compteur">{{ total }}</span></h1>
        {% if peut_creer %}
            <span class="actions">
                <a class="bouton" href="{{ path('app_championnat', filtres.categorie ? {categorie: filtres.categorie} : {}) }}">Championnat</a>
                <a class="bouton" href="{{ path('app_tournoi_index') }}">Tournois</a>
                <a class="bouton principal" href="{{ path('app_rencontre_nouveau') }}">+ Nouveau match</a>
            </span>
        {% endif %}
    </div>

    {% if dernier_import %}
        {% set n = dernier_import.ids|length %}
        <div class="carte annuler-import">
            <span>Dernier import : {{ n }} match{{ n > 1 ? 's' }} pour {{ dernier_import.categorie }}, le {{ dernier_import.le|date('d/m/Y à H:i') }}.</span>
            <form method="post" action="{{ path('app_rencontre_import_annuler') }}" class="en-ligne" data-confirmation="Supprimer les {{ n }} match{{ n > 1 ? 's' }} créé{{ n > 1 ? 's' }} par cet import ? Les matchs déjà complétés (feuille de match, convocation) sont gardés." data-confirmation-bouton="Annuler l'import">
                <input type="hidden" name="_token" value="{{ csrf_token('annuler-import') }}">
                <button class="bouton petit danger">Annuler cet import</button>
            </form>
        </div>
    {% endif %}

    <form class="filtres" method="get">
        <input type="search" name="q" value="{{ filtres.q }}" placeholder="Adversaire ou stade">
        {% include 'rencontre/_filtres.html.twig' %}
        <button type="submit" class="bouton">Filtrer</button>
    </form>

    {% include 'rencontre/_bilan.html.twig' %}

    {# Équipe choisie : qui peut modifier ses rapports de match (l'administrateur ou l'éducateur responsable le change). #}
    {% set equipe = filtres.categorie ? (categories|filter(c => c.id == filtres.categorie)|first) : null %}
    {% if equipe and responsables_equipe %}
        <p class="discret petit">
            {% include 'rencontre/_responsables.html.twig' with {responsables: responsables_equipe} %}
            {% if peut_designer_equipe %}<a href="{{ path('app_rencontre_responsables', {id: equipe.id, retour: app.request.requestUri}) }}">Choisir qui modifie les matchs</a>{% endif %}
        </p>
    {% endif %}

    {% if peut_creer and equipe and filtres.saison and total > 0 and is_granted('MATCH_MODIFIER', equipe) %}
        <form method="post" action="{{ path('app_rencontre_effacer') }}" class="effacer-saison"
              data-confirmation="Effacer les {{ total }} match{{ total > 1 ? 's' }} {{ equipe.nom }} de la saison {{ filtres.saison }} ? Les matchs déjà complétés (feuille de match, buts, convocation) sont gardés."
              data-confirmation-bouton="Effacer">
            <input type="hidden" name="_token" value="{{ csrf_token('effacer-matchs') }}">
            <input type="hidden" name="categorie" value="{{ filtres.categorie }}">
            <input type="hidden" name="saison" value="{{ filtres.saison }}">
            <button class="bouton petit danger">Effacer les matchs {{ equipe.nom }} de la saison {{ filtres.saison }}</button>
        </form>
    {% endif %}

    <div class="table-defile">
        <table class="liste liste-fiches">
            <thead>
                <tr><th>Date</th><th>Équipe</th><th>Match</th><th>Score</th><th>Compétition</th><th>Note</th></tr>
            </thead>
            <tbody>
                {% for r in rencontres %}
                    {# Sur téléphone : le match et son score en haut, le reste en dessous (voir .liste-fiches). #}
                    <tr>
                        <td class="nowrap">{{ r.date ? r.date|date('d/m/Y') : '?' }}</td>
                        <td class="fort">{{ r.equipeAffichee }}</td>
                        <td class="principal etroit"><a href="{{ path('app_rencontre_voir', {id: r.id}) }}">{{ r.domicile }} – {{ r.exterieur }}</a></td>
                        <td class="a-cote">{{ m.score(r) }}</td>
                        <td>{{ r.competition }}</td>
                        <td data-label="note">{{ r.note ? r.note|number_format(1, ',') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="vide">Aucun match pour ces critères.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {{ m.pagination('app_rencontre_index', filtres|merge({saison: filtres.saison ?? ''}), page, pages) }}
{% endblock %}
