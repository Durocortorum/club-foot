{% extends 'base.html.twig' %}

{% block title %}Composition – {{ rencontre }}{% endblock %}

{% block body %}
    <p class="lien-retour"><a href="{{ path('app_rencontre_voir', {id: rencontre.id}) }}">← {{ rencontre }}</a></p>
    <div class="titre-page">
        <div>
            <h1>Composition</h1>
            <p class="discret">{{ rencontre.equipeAffichee }} · {{ rencontre.date|date('d/m/Y') }} · {{ rencontre }}</p>
        </div>
        {% if modifiable %}<a class="bouton" href="{{ path('app_rencontre_modifier', {id: rencontre.id}) }}">Feuille de match</a>{% endif %}
    </div>

    {% if not modifiable %}
        {# Encadrement du secteur sans être responsable ni désigné : composition en lecture seule. #}
        <p class="discret petit"><span class="pastille">lecture seule</span> Seuls l'éducateur responsable de l'équipe et les personnes qu'il a désignées peuvent changer la composition.</p>
        {% if compo.titulaires %}{% include 'rencontre/_terrain_compo.html.twig' with {modifiable: false} %}{% else %}<p class="vide">Aucun titulaire sur la feuille de match.</p>{% endif %}
    {% elseif not compo.titulaires %}
        <p class="vide">Aucun titulaire sur la feuille de match. Ajoutez les joueurs dans « Feuille de match » et cochez « Titulaire » pour ceux qui commencent le match (d'office pour les numéros 1 à 11), puis revenez ici pour les placer.</p>
    {% else %}
        <form method="post" class="composition" data-controller="composition">
            <input type="hidden" name="_token" value="{{ csrf_token('composition' ~ rencontre.id) }}">
            <input type="hidden" name="placements" data-composition-target="champ">

            <div class="filtres">
                <label class="en-ligne">Système
                    <select name="systeme">
                        <option value="">—</option>
                        <optgroup label="Placement libre">
                            <option value="{{ constant('App\\Entity\\Rencontre::SYSTEME_EDUCATEUR') }}" {{ rencontre.placementEducateur ? 'selected' }}>{{ constant('App\\Entity\\Rencontre::LIBELLE_EDUCATEUR') }}</option>
                        </optgroup>
                        {% for groupe, liste in systemes %}
                            <optgroup label="{{ groupe }}">
                                {% for s in liste %}<option value="{{ s }}" {{ s == rencontre.systeme ? 'selected' }}>{{ s }}</option>{% endfor %}
                            </optgroup>
                        {% endfor %}
                    </select>
                </label>
                <button type="submit" name="action" value="replacer" class="bouton" data-confirmation="Replacer tous les joueurs selon le système choisi ? Les places déplacées à la main seront perdues." data-confirmation-bouton="Replacer">Replacer selon le système</button>
            </div>

            {# Joueurs déplacés à la main : la disposition n'est plus celle du système affiché. #}
            {% if rencontre.placements is not empty %}
                <p class="placement-educateur"><span class="pastille">Placement par l'éducateur</span>
                    Les joueurs ont été placés à la main. Pour revenir à une organisation type : choisissez-la ci-dessus, puis « Replacer selon le système ».</p>
            {% endif %}
            <p class="discret petit">Faites glisser les joueurs à la souris ou au doigt, puis enregistrez. Notre but est en bas.</p>
            {% include 'rencontre/_terrain_compo.html.twig' with {modifiable: true} %}

            <div class="barre-actions">
                <button type="submit" name="action" value="enregistrer" class="bouton principal">Enregistrer la composition</button>
            </div>
        </form>
    {% endif %}
{% endblock %}
