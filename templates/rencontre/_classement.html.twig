{#
    Classement de la poule (ClassementEquipe) : notre place en pastille, l'évolution due au match quand on la connaît,
    notre ligne et celle de l'adversaire en couleur. Variables : c (classement), categorie, saison.
#}
<section class="carte bloc classement-match">
    <div class="titre-page">
        <h2>Classement
            {% if c.rang %}<span class="classement-rang">{{ c.rang }}<sup>{{ c.rang == 1 ? 'er' : 'e' }}</sup></span>{% endif %}
            {% if c.rang and c.rang_avant and c.rang_avant != c.rang %}
                <span class="classement-evolution {{ c.rang < c.rang_avant ? 'monte' : 'descend' }}">{{ c.rang < c.rang_avant ? '▲' : '▼' }} {{ (c.rang - c.rang_avant)|abs }} place{{ (c.rang - c.rang_avant)|abs > 1 ? 's' }} avec ce match</span>
            {% elseif c.rang and c.rang_avant %}<span class="classement-evolution">= même place après ce match</span>{% endif %}
        </h2>
        {% if lien_championnat ?? true %}<a class="petit" href="{{ path('app_championnat', {categorie: categorie.id, saison: saison}) }}">Tout le championnat →</a>{% endif %}
    </div>
    <div class="table-defile">
        <table class="liste chiffres classement-compact">
            <thead><tr><th>#</th><th>Équipe</th><th>Pts</th><th>J</th><th>G</th><th>N</th><th>P</th><th>Diff</th></tr></thead>
            <tbody>
                {% for l in c.lignes %}
                    <tr class="{{ l.nous ? 'nous' }} {{ l.adversaire ? 'adversaire' }}">
                        <td>{{ l.rang }}</td>
                        <td class="principal">{{ l.equipe }}{{ l.adversaire ? ' · adversaire' }}</td>
                        <td><strong>{{ l.points }}</strong></td><td>{{ l.joues }}</td><td>{{ l.gagnes }}</td><td>{{ l.nuls }}</td><td>{{ l.perdus }}</td>
                        <td>{{ l.diff > 0 ? '+' }}{{ l.diff }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="discret petit">{{ c.recalcule ? 'Recalculé avec les matchs joués' ~ (c.mis_a_jour ? ' depuis le classement officiel du ' ~ c.mis_a_jour|date('d/m/Y') : '') : 'Classement officiel' ~ (c.mis_a_jour ? ' du ' ~ c.mis_a_jour|date('d/m/Y') : '') }}.</p>
</section>
