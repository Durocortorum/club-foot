{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}{{ titre }}{% endblock %}

{# Ligne d'une collection (feuille de match, buts, remplacements) sous forme de ligne de tableau. #}
{# Sur téléphone, chaque ligne devient une carte : intitulé (data-label) au-dessus de chaque case. #}
{% macro ligne(entree, champs, colonnes = []) %}
    <tr data-collection-target="ligne">
        {# « buteur|numeroAdverse » : plusieurs champs dans la même case. #}
        {% for noms in champs %}
            <td data-label="{{ colonnes[loop.index0] ?? '' }}" data-champ="{{ noms|split('|')|first }}">{% for nom in noms|split('|') %}{{ form_widget(entree[nom]) }}{{ form_errors(entree[nom]) }}{% endfor %}</td>
        {% endfor %}
        <td class="retirer-ligne"><button type="button" class="bouton danger petit" data-action="collection#retirer" title="Retirer la ligne">×</button></td>
    </tr>
{% endmacro %}

{% macro collection(champ, colonnes, champs, ajout) %}
    {% import _self as s %}
    <div data-controller="collection" data-collection-prototype-value="{{ s.ligne(champ.vars.prototype, champs, colonnes)|e('html_attr') }}" data-collection-index-value="{{ champ|length > 0 ? champ|keys|last + 1 : 0 }}">
        <div class="table-defile">
            <table class="liste saisie">
                <thead><tr>{% for c in colonnes %}<th>{{ c }}</th>{% endfor %}<th></th></tr></thead>
                <tbody data-collection-target="corps">
                    {% for entree in champ %}{{ s.ligne(entree, champs, colonnes) }}{% endfor %}
                </tbody>
            </table>
        </div>
        <button type="button" class="bouton" data-action="collection#ajouter">{{ ajout }}</button>
    </div>
    {% do champ.setRendered %}
{% endmacro %}
{% import _self as s %}

{% block body %}
    <p class="lien-retour">
        {% if rencontre.id %}
            <a href="{{ path('app_rencontre_voir', {id: rencontre.id}) }}">← Match</a>
        {% else %}
            <a href="{{ path('app_rencontre_index') }}">← Matchs</a>
        {% endif %}
    </p>
    <h1>{{ titre }}</h1>

    {# Buts et cartons notés en direct (tablette) pas encore sur la feuille : les reporter d'un clic. #}
    {% set direct = not nouveau ? direct_a_reporter(rencontre) : {buts: 0, cartons: 0, changements: 0} %}
    {% if direct.buts or direct.cartons or direct.changements %}
        <form method="post" action="{{ path('app_match_direct_reporter', {id: rencontre.id}) }}" id="reporter-direct" class="flash flash-info bandeau-direct">
            <input type="hidden" name="_token" value="{{ csrf_token('reporter' ~ rencontre.id) }}">
            <input type="hidden" name="retour" value="feuille">
            <span>
                ⚽ Noté en direct, pas encore sur la feuille :
                {% set elements = [] %}
                {% if direct.buts %}{% set elements = elements|merge([direct.buts ~ ' but' ~ (direct.buts > 1 ? 's')]) %}{% endif %}
                {% if direct.cartons %}{% set elements = elements|merge([direct.cartons ~ ' carton' ~ (direct.cartons > 1 ? 's')]) %}{% endif %}
                {% if direct.changements %}{% set elements = elements|merge([direct.changements ~ ' changement' ~ (direct.changements > 1 ? 's')]) %}{% endif %}
                {{ elements|join(', ', ' et ') }}.
            </span>
            <button type="submit" class="bouton petit principal">Reporter sur la feuille</button>
        </form>
    {% endif %}

    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'formulaire', 'data-controller': 'feuille score'}}) }}
        {{ form_errors(form) }}
        {% if not nouveau %}<input type="hidden" name="etat_feuille" value="{{ etat_feuille }}">{% endif %}

        <fieldset class="carte">
            <legend>Match</legend>
            {{ m.groupe(form, ['date', 'heure', 'categorie', 'competition']) }}
            <div class="champs equipes-match">
                <div class="champ">
                    {{ form_label(form.cote) }}
                    <div class="choix-cote">{{ form_widget(form.cote) }}</div>
                </div>
                {% for nom in ['club', 'adversaire', 'lieu'] %}
                    <div class="champ">{{ form_label(form[nom]) }}{{ form_widget(form[nom]) }}{{ form_errors(form[nom]) }}</div>
                {% endfor %}
            </div>
            {# Coupe seulement (affiché quand la compétition est « Coupe ») : égalité à la fin et tirs au but. #}
            <div class="champs coupe-match">
                <div class="champ">{{ form_label(form.egalite) }}{{ form_widget(form.egalite) }}{{ form_errors(form.egalite) }}
                    <p class="discret petit">Le Match Live propose ensuite les prolongations ou les tirs au but si le score est à égalité.</p></div>
                <div class="champ">
                    <label for="{{ form.tabDomicile.vars.id }}">Tirs au but marqués</label>
                    <div class="score-tab-cases">
                        <span class="discret petit">{{ rencontre.domicile ?: 'Domicile' }}</span>
                        {{ form_widget(form.tabDomicile, {attr: {'aria-label': 'Tirs au but marqués par ' ~ (rencontre.domicile ?: 'l\'équipe qui reçoit')}}) }}
                        <span class="tiret">–</span>
                        {{ form_widget(form.tabExterieur, {attr: {'aria-label': 'Tirs au but marqués par ' ~ (rencontre.exterieur ?: 'l\'équipe qui se déplace')}}) }}
                        <span class="discret petit">{{ rencontre.exterieur ?: 'Extérieur' }}</span>
                    </div>
                    {{ form_errors(form.tabDomicile) }}{{ form_errors(form.tabExterieur) }}
                    <p class="discret petit">Seulement si le match s'est fini à égalité. Ne compte pas dans le score : le match reste un nul, avec « qualifié » ou « éliminé ».</p>
                </div>
            </div>

            {# Score : tiré des buts du rapport de match (bloc « Buts »), non modifiable (score_controller.js). #}
            {% for champ in [form.butsDomicileMiTemps, form.butsExterieurMiTemps, form.butsDomicile, form.butsExterieur] %}
                {{ form_widget(champ, {type: 'hidden'}) }}
            {% endfor %}
            {% if nouveau %}
                {% do form.joue.setRendered %}
            {% else %}
                <div class="champ case match-joue">{{ form_label(form.joue) }}{{ form_widget(form.joue) }}</div>
                <p class="discret petit">Le score vient des buts saisis plus bas. Un match avec des buts compte forcément ; sans but, cochez la case pour un 0 – 0.</p>
                {# Score seulement, sans détailler les buts : masqué dès qu'un but est détaillé (score_controller.js). #}
                {% set sans_buts = rencontre.buts is empty %}
                <div class="score-rapide" data-score-target="rapide" {{ sans_buts ? '' : 'hidden' }}>
                    <p class="score-rapide-titre"><strong>Score seulement</strong> <span class="discret petit">(sans détailler les buts)</span></p>
                    <div class="score-rapide-cases">
                        <label for="score-rapide-dom" data-score-target="nomRapideDom">{{ rencontre.domicile }}</label>
                        <input type="number" id="score-rapide-dom" min="0" max="99" inputmode="numeric" data-score-target="rapideDom" value="{{ sans_buts ? rencontre.butsDomicile }}">
                        <span class="tiret">–</span>
                        <input type="number" id="score-rapide-ext" min="0" max="99" inputmode="numeric" data-score-target="rapideExt" value="{{ sans_buts ? rencontre.butsExterieur }}" aria-labelledby="score-rapide-nom-ext">
                        <span id="score-rapide-nom-ext" data-score-target="nomRapideExt">{{ rencontre.exterieur }}</span>
                    </div>
                    <p class="discret petit">Pour les buteurs et les minutes, détaillez les buts plus bas : le score se calculera alors à partir d'eux.</p>
                </div>
            {% endif %}
            <div class="tableau-score" aria-live="polite" {{ nouveau ? 'hidden' }}>
                <span class="equipe" data-score-target="nomDom">{{ rencontre.domicile }}</span>
                <span class="score-final">
                    <span data-score-target="affFinDom">{{ rencontre.butsDomicile ?? 0 }}</span><span class="tiret">–</span><span data-score-target="affFinExt">{{ rencontre.butsExterieur ?? 0 }}</span>
                </span>
                <span class="equipe" data-score-target="nomExt">{{ rencontre.exterieur }}</span>
                <span class="mi-temps">
                    1re mi-temps <strong data-score-target="affMt1">–</strong>
                    <span class="separateur">·</span>
                    2e mi-temps <strong data-score-target="affMt2">–</strong>
                </span>
                <ul class="buteurs domicile" data-score-target="butsDom"></ul>
                <span></span>
                <ul class="buteurs exterieur" data-score-target="butsExt"></ul>
            </div>
        </fieldset>

        {# Nouveau match : d'abord les informations du match et la convocation ; le reste se remplit
           ensuite, avec « Modifier ». Les blocs restent dans la page (masqués) pour feuille_controller.js. #}
        <div {{ nouveau ? 'hidden' }}>
        <fieldset class="carte">
            <legend>Conditions</legend>
            {{ m.groupe(form, ['terrain', 'meteo', 'vent', 'temperature', 'systeme', 'systemeAdverse']) }}
            {# Joueurs placés à la main sur le terrain (page « Composition ») : l'organisation n'est plus qu'un point de départ. #}
            {% if not nouveau and rencontre.placementEducateur %}
                <p class="placement-educateur discret petit">Joueurs placés à la main sur le terrain. Choisir une organisation type (4 4 2, 4 3 2 1…) les replacera selon elle.
                    <a href="{{ path('app_rencontre_composition', {id: rencontre.id}) }}">Voir la composition</a></p>
            {% endif %}
        </fieldset>

        <fieldset class="carte">
            <legend>Rapport</legend>
            {{ m.groupe(form, ['note', 'lienVideo', 'rapport']) }}
        </fieldset>

        <fieldset class="carte" id="feuille-de-match">
            <legend>Feuille de match</legend>
            <p class="discret petit">
                Joueurs proposés : les convoqués (sauf les absents) s'il y a une convocation, sinon ceux de la catégorie du match, puis ceux qui peuvent être surclassés (catégorie entre parenthèses). Un joueur ne figure qu'une fois.
                Case « Titulaire » : sur le terrain au coup d'envoi (cochée d'office pour les numéros 1 à 11, modifiable : un titulaire peut porter le n° 23). Poste « Non utilisé » pour un remplaçant resté sur le banc.
                {% if rencontre.id %}Après l'enregistrement, placez les titulaires sur le terrain : <a href="{{ path('app_rencontre_composition', {id: rencontre.id}) }}">Composition sur le terrain</a>.{% endif %}
            </p>
            <label class="case-filtre petit">
                <input type="checkbox" data-feuille-target="autres" data-action="feuille#filtrer">
                Afficher tous les joueurs du club (cas exceptionnel)
            </label>
            {# Titulaires cochés / joueurs sur le terrain (feuille_controller.js) : jamais plus que le terrain n'en compte. #}
            <p class="compte-titulaires" data-feuille-compte aria-live="polite"></p>
            {{ s.collection(form.participations, ['N°', 'Titulaire', 'Joueur', 'Poste', 'Min.', 'Note', 'Carton', 'Appréciation'], ['numero', 'titulaire', 'joueur', 'poste', 'tempsJeu', 'note', 'carton|minuteCarton', 'appreciation'], '+ Ajouter un joueur') }}
        </fieldset>

        <fieldset class="carte" data-controller="trace-but">
            <legend>Buts</legend>
            <p class="discret petit">Seuls les joueurs de la feuille de match sont proposés comme buteur ou passeur : remplissez-la d'abord.
                « ⚽ Placer » : dessiner le but sur le terrain (départ du ballon, entrée dans le but), visible ensuite sur la page du match.</p>
            {# Fenêtre de placement du but (trace_but_controller.js, même dessin qu'en direct). #}
            <dialog class="dialogue dialogue-but" data-trace-but-target="dialogue">
                <h2 class="dialogue-titre" data-trace-but-target="titre">But</h2>
                <p class="discret petit">Déplacez le <b>ballon</b> là où part le tir, puis tirez la <b>pointe de la flèche</b> jusqu'à l'endroit où il entre dans le but.</p>
                <svg class="terrain-but" data-trace-but-target="terrain" role="img" aria-label="Demi-terrain avec le but"></svg>
                <div class="dialogue-actions">
                    <button type="button" class="bouton lien-bouton danger" data-action="trace-but#effacer">Retirer du terrain</button>
                    <button type="button" class="bouton" data-action="trace-but#fermer">Annuler</button>
                    <button type="button" class="bouton principal" data-action="trace-but#enregistrer">Valider</button>
                </div>
            </dialog>
            {% if direct.buts %}
                <p class="petit">⚽ {{ direct.buts }} but{{ direct.buts > 1 ? 's' }} noté{{ direct.buts > 1 ? 's' }} en direct :
                    <button type="submit" form="reporter-direct" class="bouton petit">Les reporter ici</button></p>
            {% endif %}
            {{ s.collection(form.buts, ['Min.', 'Pour', 'Buteur', 'Passeur', 'Geste', 'Situation', 'Phase', 'Terrain'], ['temps', 'adverse', 'buteur|numeroAdverse', 'passeur', 'geste', 'conditions', 'phase', 'traceJson'], '+ Ajouter un but') }}
        </fieldset>

        <fieldset class="carte">
            <legend>Remplacements</legend>
            <p class="discret petit">
                Seuls les joueurs de la feuille de match sont proposés. Les temps de jeu de la feuille se calculent à partir des titulaires et de ces remplacements.
                Expulsion et carton blanc (exclusion temporaire) : se notent en carton sur la feuille de match (rouge avec sa minute ; carton blanc : 10 minutes retirées du temps de jeu).
            </p>
            {% if direct.changements %}
                <p class="petit">⇄ {{ direct.changements }} changement{{ direct.changements > 1 ? 's' }} noté{{ direct.changements > 1 ? 's' }} en direct :
                    <button type="submit" form="reporter-direct" class="bouton petit">Les reporter ici</button></p>
            {% endif %}
            {{ s.collection(form.remplacements, ['Min.', 'Sort', 'Entre', 'Motif'], ['minute', 'sortant', 'entrant', 'motif'], '+ Ajouter un remplacement') }}
        </fieldset>
        </div>

        {{ form_rest(form) }}
        <div class="barre-actions">
            {% if nouveau %}
                <button type="submit" class="bouton principal" name="suite" value="convocation">Enregistrer et convoquer</button>
                <button type="submit" class="bouton">Enregistrer sans convoquer</button>
                <p class="discret petit">Score, conditions, rapport et feuille de match se remplissent ensuite, avec « Modifier » sur la page du match.</p>
            {% else %}
                <button type="submit" class="bouton principal">Enregistrer le match</button>
            {% endif %}
        </div>
    {{ form_end(form) }}
{% endblock %}
