{# Bilan collectif V / N / D pour les filtres en cours. #}
{% if bilan.matchs %}
    <div class="tuiles bilan">
        <div class="tuile"><span class="tuile-valeur">{{ bilan.matchs }}</span><span class="tuile-libelle">{{ accord(bilan.matchs, 'match') }}</span></div>
        <div class="tuile"><span class="tuile-valeur resultat-V">{{ bilan.V }}</span><span class="tuile-libelle">{{ accord(bilan.V, 'victoire') }}</span></div>
        <div class="tuile"><span class="tuile-valeur resultat-N">{{ bilan.N }}</span><span class="tuile-libelle">{{ accord(bilan.N, 'nul') }}</span></div>
        <div class="tuile"><span class="tuile-valeur resultat-D">{{ bilan.D }}</span><span class="tuile-libelle">{{ accord(bilan.D, 'défaite') }}</span></div>
        <div class="tuile"><span class="tuile-valeur double">{{ bilan.pour }} – {{ bilan.contre }}</span><span class="tuile-libelle">buts pour – contre</span></div>
    </div>
{% endif %}
