{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Contacts médicaux{% endblock %}

{% block body %}
    <nav class="onglets">
        <a href="{{ path('app_infirmerie_index') }}">Blessures</a>
        <a href="{{ path('app_contact_index') }}" class="actif">Contacts médicaux</a>
    </nav>

    <div class="titre-page">
        <h1>Contacts médicaux <span class="compteur">{{ contacts|length }}</span></h1>
        <a class="bouton principal" href="{{ path('app_contact_nouveau') }}">+ Nouveau contact</a>
    </div>

    <div class="table-defile">
        <table class="liste">
            <thead><tr><th>Profession</th><th>Nom</th><th>Téléphone</th><th>Adresse</th><th></th></tr></thead>
            <tbody>
                {% for c in contacts %}
                    <tr>
                        <td>{{ c.profession }}</td>
                        <td><strong>{{ c.nom }}</strong> {{ c.prenom }}</td>
                        <td class="nowrap">{% if c.telephone %}<a href="tel:{{ c.telephone|replace({' ': ''}) }}">{{ c.telephone }}</a>{% endif %}</td>
                        <td>{{ [c.adresse, [c.codePostal, c.ville]|filter(v => v)|join(' ')]|filter(v => v)|join(', ') }}</td>
                        <td class="nowrap">
                            <a href="{{ path('app_contact_modifier', {id: c.id}) }}">Modifier</a>
                            {{ m.supprimer(path('app_contact_supprimer', {id: c.id}), 'supprimer-contact' ~ c.id, 'Supprimer ce contact ?', '×') }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="vide">Aucun contact.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
