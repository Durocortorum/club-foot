{% extends 'commun/formulaire.html.twig' %}

{# Formulaire de blessure. La localisation précise se choisit avant, sur l'atlas anatomique du dossier
   médical du joueur (« Localiser une blessure »), qui ouvre ce formulaire déjà rempli. #}

{% block complement %}
    {% set joueur = form.vars.value.joueur %}
    {% if joueur and joueur.id and not form.vars.value.id %}
        <p class="discret">
            <a href="{{ path('app_dossier_medical_localiser', {id: joueur.id}) }}">Localiser la blessure sur le corps</a>
            pour remplir la localisation et la zone touchée.
        </p>
    {% endif %}
{% endblock %}
