{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Infirmerie{% endblock %}

{% block body %}
    {% include 'infirmerie/_onglets.html.twig' with {actif: 'blessures'} %}

    <div class="titre-page">
        <h1>{{ filtres.statut == 'en_cours' ? 'Joueurs indisponibles' : 'Toutes les blessures' }} <span class="compteur">{{ total }}</span></h1>
        {% if is_granted('ROLE_INFIRMERIE') %}<a class="bouton principal" href="{{ path('app_blessure_nouvelle') }}">+ Nouvelle blessure</a>{% endif %}
    </div>

    <form class="filtres" method="get">
        <input type="search" name="q" value="{{ filtres.q }}" placeholder="Joueur ou type de blessure">
        <select name="statut">
            <option value="en_cours" {{ filtres.statut == 'en_cours' ? 'selected' }}>En cours (sans reprise)</option>
            <option value="toutes" {{ filtres.statut == 'toutes' ? 'selected' }}>Historique complet</option>
        </select>
        <select name="categorie">
            <option value="">Toutes les catégories</option>
            {% for c in categories %}
                <option value="{{ c.id }}" {{ filtres.categorie == c.id ? 'selected' }}>{{ c.nom }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="bouton">Filtrer</button>
    </form>

    <div class="table-defile">
        <table class="liste liste-fiches">
            <thead><tr><th>Joueur</th><th>Catégorie</th><th>Date</th><th>Blessure</th><th>Circonstances</th><th>Reprise</th><th></th></tr></thead>
            <tbody>
                {% for b in blessures %}
                    <tr>
                        <td class="avec-vignette nowrap principal etroit">{{ m.avatar(b.joueur, 'mini') }} <a href="{{ path('app_dossier_medical', {id: b.joueur.id}) }}"><strong>{{ b.joueur.nom }}</strong> {{ b.joueur.prenom }}</a></td>
                        <td class="fort">{{ b.joueur.categorie }}</td>
                        <td class="nowrap">{{ b.date ? b.date|date('d/m/Y') : '?' }}</td>
                        <td class="large">{{ b.libelle }}</td>
                        <td>{{ b.lieu }}</td>
                        <td class="nowrap" data-label="reprise">{% include 'infirmerie/_reprise.html.twig' with {b: b, pastille: true} only %}</td>
                        <td class="a-cote">{% if is_granted('ROLE_INFIRMERIE') %}<a href="{{ path('app_blessure_modifier', {id: b.id}) }}">Modifier</a>{% endif %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="vide">{{ filtres.statut == 'en_cours' ? 'Aucun joueur actif n\'est indisponible.' : 'Aucune blessure pour ces critères.' }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {{ m.pagination('app_infirmerie_index', filtres, page, pages) }}

    {% if par_type %}
        <section class="carte bloc">
            <h2>Blessures les plus fréquentes (historique)</h2>
            {% set max = par_type|first %}
            <ul class="barres">
                {% for type, n in par_type %}
                    <li><span class="barres-libelle">{{ type }}</span><span class="barres-barre" style="width: {{ (100 * n / max)|round }}%"></span><span class="barres-valeur">{{ n }}</span></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}
