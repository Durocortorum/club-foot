{% extends 'base.html.twig' %}

{% block title %}Localiser une blessure – {{ joueur.nomComplet }}{% endblock %}

{% block body %}
    <p><a href="{{ path('app_dossier_medical', {id: joueur.id}) }}#infirmerie">← Dossier médical de {{ joueur.prenom }} {{ joueur.nom }}</a></p>

    <div class="titre-page">
        <h1>Localiser une blessure · {{ joueur.prenom }} <strong>{{ joueur.nom }}</strong></h1>
        <a class="bouton" href="{{ path('app_blessure_nouvelle', {joueur: joueur.id}) }}">Saisir sans localiser</a>
    </div>

    <div class="atlas">
        <section class="carte atlas-corps">
            <nav class="onglets-atlas" aria-label="Vue du corps">
                {% for code, c in {face: 'Face', dos: 'Dos'} %}
                    <a class="bouton {{ code == vue ? 'principal' }}" href="{{ path('app_dossier_medical_localiser', {id: joueur.id, vue: code}) }}" {{ code == vue ? 'aria-current="page"' }}>{{ c }}</a>
                {% endfor %}
            </nav>
            <p class="discret petit">Cliquez sur la région touchée. {{ vue == 'face' ? 'Vu de face, la droite du joueur est à gauche de l\'image.' : 'Vu de dos, la droite du joueur est à droite de l\'image.' }}</p>
            <div class="planche-cadre" style="--ratio: {{ ratio|round(4) }}">
                <img src="{{ asset('images/atlas/' ~ corps.image) }}" alt="Muscles du corps humain, {{ corps.titre|lower }}" style="left: 0; top: 0; width: 100%; height: 100%">
                {% for z in corps.zones %}
                    {% set libelle = libelles[z.region] ~ (z.cote is defined ? ' ' ~ z.cote : '') %}
                    <a class="point region" title="{{ libelle }}" aria-label="{{ libelle }}"
                       href="{{ path('app_dossier_medical_localiser_region', {id: joueur.id, region: z.region, cote: z.cote ?? null}) }}"
                       style="left: {{ z.pos[0] }}%; top: {{ z.pos[1] }}%; width: {{ z.pos[2] }}%; height: {{ z.pos[3] }}%"><span>{{ libelle }}</span></a>
                {% endfor %}
            </div>
        </section>

        <section class="carte atlas-liste">
            <h2>Ou choisissez dans la liste</h2>
            <ul>
                {% for code, r in regions %}
                    <li>
                        <span>{{ r.libelle }}</span>
                        {% for cote in r.cotes %}
                            <a class="bouton petit" href="{{ path('app_dossier_medical_localiser_region', {id: joueur.id, region: code, cote: cote}) }}">{{ cote ?? 'Choisir' }}</a>
                        {% endfor %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>

    {{ include('infirmerie/_atlas_credits.html.twig') }}
{% endblock %}
