{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Mon espace{% endblock %}

{% block body %}
    <h1>Bonjour {{ app.user.prenom != 'Famille' ? app.user.prenom : '' }}</h1>

    {# Informations importantes du club, en tête tant qu'elles ne sont pas lues. #}
    {% for msg in messages_importants() %}
        <a class="info-importante" href="{{ path('app_espace_message', {id: msg.id}) }}">
            <strong>Important · {{ msg.sujet }}</strong>
            <span>{{ msg.corps|length > 140 ? msg.corps|slice(0, 140) ~ '…' : msg.corps }}</span>
            <span class="petit">Lire le message →</span>
        </a>
    {% endfor %}
    {% set non_lus = messages_non_lus() %}
    {% if non_lus %}
        <p><a class="bouton" href="{{ path('app_espace_messages') }}">{{ non_lus }} {{ accord(non_lus, 'message') }} non {{ accord(non_lus, 'lu') }}</a></p>
    {% endif %}

    {% if evenements %}
        <section class="carte bloc" id="evenements">
            <h2>Événements du club</h2>
            {% for ev in evenements %}
                <div class="evenement evenement-famille">
                    <div class="evenement-date">
                        <span class="jour">{{ ev.debut|date('d') }}</span>
                        <span class="mois">{{ ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'][ev.debut|date('n') - 1] }}</span>
                    </div>
                    <div class="evenement-corps">
                        <strong>{{ ev.titre }}</strong> <span class="pastille">{{ ev.type }}</span>
                        <p class="discret">
                            {% if ev.fin and ev.fin|date('Y-m-d') != ev.debut|date('Y-m-d') %}Du {{ ev.debut|date('d/m à H\\hi') }} au {{ ev.fin|date('d/m à H\\hi') }}{% else %}{{ ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'][ev.debut|date('w')] }} {{ ev.debut|date('d/m') }} à {{ ev.debut|date('H\\hi') }}{% endif %}{% if ev.lieu %} · {{ ev.lieu }}{% endif %}
                        </p>
                        {% if ev.description %}<p class="petit">{{ ev.description|nl2br }}</p>{% endif %}
                    </div>
                </div>
            {% endfor %}
        </section>
    {% endif %}

    {% for e in enfants %}
        {% set j = e.joueur %}
        <section class="carte bloc">
            <div class="identite">
                <div class="avatar">{{ j.prenom|first|upper }}{{ j.nom|first|upper }}</div>
                <div>
                    <h2>{{ j.prenom }} <strong>{{ j.nom }}</strong></h2>
                    <p class="discret">{{ j.categorie ?? 'Catégorie à venir' }}{% if j.educateur %} · éducateur : {{ j.educateur }}{% endif %}</p>
                </div>
            </div>

            {% if e.stages %}
                {% import 'stage/_resume.html.twig' as resume_stage %}
                <h3 id="stages-{{ j.id }}">Stages</h3>
                {% for s in e.stages %}
                    {% set inscrit = s.inscription(j) %}
                    <div class="stage-famille">
                        <div>
                            <strong>{{ s.titre }}</strong>
                            {% if s.obligatoire %}<span class="pastille alerte">obligatoire</span>{% endif %}
                            {% if inscrit %}<span class="pastille succes">{{ j.prenom }} est inscrit(e)</span>{% endif %}
                            {% if inscrit and s.payant %}<span class="pastille {{ inscrit.paye ? 'succes' : 'alerte' }}">{{ inscrit.paye ? 'réglé' : 'à régler' }}</span>{% endif %}
                            <br><span class="discret petit">{{ resume_stage.quand(s) }} · {{ resume_stage.tarif(s) }}{% if s.raison %} · {{ s.raison }}{% endif %}</span>
                            {% if s.description %}<br><span class="petit">{{ s.description|nl2br }}</span>{% endif %}
                        </div>
                        {% if s.inscriptionOuverte %}
                            {% if inscrit or not s.complet %}
                                <form method="post" action="{{ path('app_espace_stage', {id: s.id, joueur: j.id}) }}" {% if inscrit %}data-confirmation="Annuler l'inscription de {{ j.prenom }} ?" data-confirmation-bouton="Annuler l'inscription"{% endif %}>
                                    <input type="hidden" name="_token" value="{{ csrf_token('stage-famille' ~ s.id ~ '-' ~ j.id) }}">
                                    <input type="hidden" name="action" value="{{ inscrit ? 'desinscrire' : 'inscrire' }}">
                                    <button type="submit" class="bouton petit {{ inscrit ? 'danger' : 'principal' }}">{{ inscrit ? 'Annuler l\'inscription' : 'Inscrire ' ~ j.prenom }}</button>
                                    <br><span class="discret petit">jusqu'au {{ s.limiteInscription|date('d/m') }}{% if s.places and not inscrit %} · {{ s.placesRestantes }} {{ s.placesRestantes > 1 ? 'places' : 'place' }}{% endif %}</span>
                                </form>
                            {% else %}
                                <span class="pastille alerte">complet</span>
                            {% endif %}
                        {% elseif s.obligatoire %}
                            <span class="discret petit">En cas d'empêchement, prévenez l'éducateur.</span>
                        {% elseif not inscrit and s.inscriptionsFamilles %}
                            <span class="discret petit">Inscriptions closes{% if s.limiteInscription %} depuis le {{ s.limiteInscription|date_modify('+1 day')|date('d/m') }}{% endif %}</span>
                        {% elseif not inscrit %}
                            <span class="discret petit">Inscription auprès de l'éducateur</span>
                        {% endif %}
                    </div>
                {% endfor %}
            {% endif %}

            {% if e.taches %}
                <h3 id="taches">Tâches confiées à {{ j.prenom }}</h3>
                <ul class="liste-taches">
                    {% for t in e.taches %}
                        <li>
                            <span>
                                <strong>{{ t.objet }}</strong>
                                {% if t.echeance %}<span class="discret petit">pour le {{ ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'][t.echeance|date('w')] }} {{ t.echeance|date('d/m') }}</span>{% endif %}
                                {% if t.faite %}<span class="pastille succes">faite</span>{% elseif t.enRetard %}<span class="pastille alerte">en retard</span>{% endif %}
                                {% if t.description %}<span class="petit">{{ t.description }}</span>{% endif %}
                            </span>
                            {% if not t.faite %}
                                <form method="post" action="{{ path('app_espace_tache_faite', {id: t.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('tache-faite' ~ t.id) }}">
                                    <button type="submit" class="bouton petit principal">✓ C'est fait</button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {# Amendes de discipline : celles à payer, et celles payées depuis le début de la saison. #}
            {% if e.amendes %}
                {% set a_payer = e.amendes|filter(s => s.amendeAPayer) %}
                <h3 id="amendes-{{ j.id }}">Amendes{% if a_payer %} <span class="pastille alerte">{{ a_payer|reduce((t, s) => t + s.amende, 0)|number_format(2, ',', ' ') }} € à payer</span>{% endif %}</h3>
                <ul class="liste-simple">
                    {% for s in e.amendes %}
                        <li>
                            <strong class="nowrap">{{ s.amende|number_format(2, ',', ' ') }} €</strong>
                            · {{ s.motif }} <span class="discret petit">({{ s.date|date('d/m/Y') }})</span>
                            {% if s.amendePayeeLe %}<span class="pastille succes">payée le {{ s.amendePayeeLe|date('d/m') }}</span>{% else %}<span class="pastille alerte">à payer</span>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
                {% if a_payer %}<p class="discret petit">À régler auprès du club.</p>{% endif %}
            {% endif %}

            {# Autoévaluation : effort ressenti après les séances des derniers jours (RPE de 1 à 10). #}
            {% if e.a_noter or e.ressentis %}
                <h3 id="ressenti-{{ j.id }}">Effort ressenti</h3>
                {% for s in e.a_noter %}
                    {% set est_match = s.adversaire is defined %}
                    {% set cle = (est_match ? 'r-' : 'e-') ~ s.id %}
                    <form method="post" action="{{ path('app_espace_ressenti', {joueur: j.id}) }}" class="ressenti-saisie">
                        <input type="hidden" name="_token" value="{{ csrf_token('ressenti' ~ j.id) }}">
                        <input type="hidden" name="seance" value="{{ cle }}">
                        <p><strong>{{ est_match ? 'Match contre ' ~ s.adversaire : 'Entraînement' }}</strong> <span class="discret">du {{ ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'][s.date|date('w')] }} {{ s.date|date('d/m') }}</span> : comment {{ j.prenom }} a-t-il (elle) ressenti l'effort ?</p>
                        <div class="echelle-rpe" role="radiogroup" aria-label="Effort ressenti, de 1 (très facile) à 10 (maximum)">
                            {% for n, libelle in echelle_rpe %}
                                <label class="rpe-{{ n }}" title="{{ libelle }}"><input type="radio" name="rpe" value="{{ n }}" required><span>{{ n }}</span></label>
                            {% endfor %}
                        </div>
                        <p class="discret petit echelle-legende"><span>1 = très facile</span><span>5 = dur</span><span>10 = maximum</span></p>
                        <div class="ressenti-details">
                            <label>Durée <input type="number" name="duree" min="1" max="300" placeholder="{{ est_match ? 'temps joué' : 'minutes' }}" aria-label="Durée en minutes"> min</label>
                            <input type="text" name="commentaire" maxlength="255" placeholder="Une douleur, une remarque ? (facultatif)" aria-label="Commentaire">
                            <button type="submit" class="bouton principal petit">Envoyer</button>
                        </div>
                    </form>
                {% endfor %}
                {% if e.ressentis %}
                    <p class="discret petit">Derniers ressentis :
                        {% for r in e.ressentis|slice(0, 6) %}<span class="pastille-rpe rpe-{{ r.rpe }}" title="{{ r.libelle }}{{ r.commentaire ? ' – ' ~ r.commentaire }}">{{ r.date|date('d/m') }} · {{ r.rpe }}/10</span>{% endfor %}
                    </p>
                {% endif %}
            {% endif %}

            {% if e.convocations %}
                <h3>Convocations</h3>
                {% for c in e.convocations %}
                    {% set cv = c.convocation %}
                    {% set r = cv.rencontre %}
                    <div class="convocation-famille">
                        <strong>{{ ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'][r.date|date('w')] }} {{ r.date|date('d/m/Y') }}</strong>{% if r.heure %} à {{ r.heure }}{% endif %}
                        <div>{{ r.domicile }} – {{ r.exterieur }} <span class="discret">· {{ r.competition ?? 'Match' }}</span></div>
                        {% if cv.rdvHeure or cv.rdvLieu %}
                            <div>Rendez-vous{% if cv.rdvHeure %} à <strong>{{ cv.rdvHeure }}</strong>{% endif %}{% if cv.rdvLieu %}, {{ cv.rdvLieu }}{% endif %}</div>
                        {% endif %}
                        {% if cv.message %}<p class="memo petit">{{ cv.message }}</p>{% endif %}

                        <p>
                            {% if c.reponse == 'present' %}<span class="pastille succes">présent</span>
                            {% elseif c.reponse == 'absent' %}<span class="pastille alerte">absent</span>{% if c.motif %} <span class="petit">{{ c.motif }}</span>{% endif %}
                            {% else %}<span class="pastille alerte">réponse attendue</span>{% endif %}
                        </p>
                        <div class="reponses-famille">
                            <form method="post" action="{{ path('app_espace_reponse', {id: c.id}) }}" class="en-ligne">
                                <input type="hidden" name="_token" value="{{ csrf_token('repondre' ~ c.id) }}">
                                <input type="hidden" name="reponse" value="present">
                                <button class="bouton {{ c.reponse != 'present' ? 'principal' }}">{{ c.reponse == 'present' ? '✓ Présent' : 'Présent' }}</button>
                            </form>
                            <form method="post" action="{{ path('app_espace_reponse', {id: c.id}) }}" class="reponse-convoque">
                                <input type="hidden" name="_token" value="{{ csrf_token('repondre' ~ c.id) }}">
                                <input type="hidden" name="reponse" value="absent">
                                <input type="text" name="motif" value="{{ c.motif }}" placeholder="Motif (facultatif)" list="motifs-absence" maxlength="120" aria-label="Motif de l'absence">
                                <button class="bouton">{{ c.reponse == 'absent' ? '✓ Absent' : 'Absent' }}</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}

            {% if e.entrainements %}
                <h3 id="entrainements-{{ j.id }}">Prochains entraînements</h3>
                <p class="discret petit">{{ j.prenom }} est attendu(e) à chaque entraînement : signalez seulement une absence.</p>
                <ul class="liste-simple">
                    {% for en in e.entrainements %}
                        {% set absence = en.absenceDe(j) %}
                        {% set jeton = csrf_token('entrainement' ~ en.id ~ '-' ~ j.id) %}
                        <li>
                            <strong class="nowrap">{{ ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'][en.date|date('w')] }} {{ en.date|date('d/m') }}</strong>
                            · {{ en.horaire }}{% if en.lieu %} · {{ en.lieu }}{% endif %}
                            {% if en.annule %}
                                <span class="pastille alerte">annulé{{ en.motifAnnulation ? ' : ' ~ en.motifAnnulation }}</span>
                            {% elseif absence %}
                                <span class="pastille alerte">absent(e) · {{ absence.motif }}</span>
                                <form method="post" action="{{ path('app_espace_entrainement', {id: en.id}) }}" class="en-ligne">
                                    <input type="hidden" name="_token" value="{{ jeton }}">
                                    <input type="hidden" name="joueur" value="{{ j.id }}">
                                    <input type="hidden" name="retirer" value="1">
                                    <button class="bouton petit">Finalement présent(e)</button>
                                </form>
                            {% else %}
                                <span class="pastille succes">attendu(e)</span>
                                <details class="petit">
                                    <summary>Signaler une absence</summary>
                                    <form method="post" action="{{ path('app_espace_entrainement', {id: en.id}) }}" class="reponse-convoque">
                                        <input type="hidden" name="_token" value="{{ jeton }}">
                                        <input type="hidden" name="joueur" value="{{ j.id }}">
                                        <select name="motif" aria-label="Motif">{% for mo in motifs_entrainement %}<option>{{ mo }}</option>{% endfor %}</select>
                                        <input type="text" name="commentaire" placeholder="Précision (facultatif)" maxlength="120" aria-label="Précision">
                                        <button class="bouton petit">Signaler l'absence</button>
                                    </form>
                                </details>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <h3>Prochains matchs</h3>
            {% if e.matchs %}
                <ul class="liste-simple">
                    {% for r in e.matchs %}
                        <li>
                            <strong class="nowrap">{{ ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'][r.date|date('w')] }} {{ r.date|date('d/m/Y') }}</strong>{% if r.heure %} à {{ r.heure }}{% endif %}
                            <div>{{ r.domicile }} – {{ r.exterieur }} <span class="discret">· {{ r.competition ?? 'Match' }}</span></div>
                            {% if r.lieu %}<div class="discret petit">{{ r.lieu }}</div>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="discret">Aucun match programmé pour le moment.</p>
            {% endif %}

            {% if e.stats %}
                {# Statistiques : on choisit la période, toute la carrière ou une saison (periode_controller.js). #}
                <div class="statistiques-famille" data-controller="periode">
                    <div class="titre-page">
                        <h3 id="statistiques-{{ j.id }}">Statistiques</h3>
                        <select data-periode-target="choix" data-action="periode#afficher" aria-label="Période des statistiques">
                            {% for cle, p in e.stats.periodes %}<option value="{{ cle }}">{{ p.libelle }}</option>{% endfor %}
                        </select>
                    </div>
                    {% for cle, p in e.stats.periodes %}
                        <div data-periode-target="periode" data-periode="{{ cle }}" {{ not loop.first ? 'hidden' }}>
                            <div class="tuiles bilan">
                                <div class="tuile"><span class="tuile-valeur">{{ p.matchs }}</span><span class="tuile-libelle">{{ accord(p.matchs, 'match joué', 'matchs joués') }}</span></div>
                                <div class="tuile"><span class="tuile-valeur">{{ p.titularisations }}</span><span class="tuile-libelle">{{ accord(p.titularisations, 'titularisation') }}</span></div>
                                <div class="tuile"><span class="tuile-valeur">{{ p.minutes }}</span><span class="tuile-libelle">{{ accord(p.minutes, 'minute') }}</span></div>
                                <div class="tuile"><span class="tuile-valeur">{{ p.buts }}</span><span class="tuile-libelle">{{ accord(p.buts, 'but') }}</span></div>
                                <div class="tuile"><span class="tuile-valeur">{{ p.passes }}</span><span class="tuile-libelle">{{ accord(p.passes, 'passe décisive', 'passes décisives') }}</span></div>
                                <div class="tuile"><span class="tuile-valeur">{{ p.jaunes }} / {{ p.rouges }}</span><span class="tuile-libelle">{{ accord(p.jaunes, 'carton jaune', 'cartons jaunes') }} / {{ accord(p.rouges, 'rouge') }}</span></div>
                                <div class="tuile"><span class="tuile-valeur">{{ p.taux is not null ? p.taux ~ ' %' : '—' }}</span><span class="tuile-libelle">présence à l'entraînement{% if p.seances %} ({{ p.presences }}/{{ p.seances }}){% endif %}</span></div>
                            </div>
                        </div>
                    {% endfor %}

                    {# Détail des matchs de la période choisie (sans note ni appréciation du coach). #}
                    {% if e.stats.matchs %}
                        <h4>Détail des matchs</h4>
                        <div class="table-defile">
                            <table class="liste liste-fiches">
                                <thead><tr><th>Date</th><th>Match</th><th>Score</th><th>Poste</th><th>Min.</th><th>Buts</th><th>Passes D.</th><th>Carton</th></tr></thead>
                                <tbody>
                                    {% for p in e.stats.matchs %}
                                        {% set r = p.rencontre %}
                                        {% set bp = e.stats.buts[r.id] ?? {buts: 0, passes: 0} %}
                                        <tr data-periode-target="ligne" data-saison="{{ r.saison }}">
                                            <td class="nowrap">{{ r.date ? r.date|date('d/m/Y') }}</td>
                                            <td class="principal etroit">{{ r.domicile }} – {{ r.exterieur }} <span class="discret">{{ r.equipeAffichee }}</span></td>
                                            <td class="a-cote">{{ m.score(r) }}</td>
                                            <td>{{ p.poste }}</td>
                                            <td data-label="min.">{{ p.tempsJeu }}</td>
                                            <td data-label="buts">{{ bp.buts ?: '' }}</td>
                                            <td data-label="passes D.">{{ bp.passes ?: '' }}</td>
                                            <td>{% if p.carton %}<span class="carton {{ p.couleurCarton }}" title="{{ p.cartonLibelle }}"></span> <span class="petit">{{ p.cartonLibelle }}</span>{% endif %}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <p class="discret" data-periode-target="vide" hidden>Aucun match sur cette période.</p>
                    {% endif %}
                </div>
            {% endif %}

            {% if e.proches is not null %}
                <h3>Personnes à contacter</h3>
                <p class="discret petit">
                    Vous êtes majeur(e) : vous indiquez ici qui le club peut contacter (parent, conjoint(e), proche…),
                    et vous décidez qui peut voir cet espace (convocations, matchs, entraînements) et répondre pour vous.
                </p>
                {% include 'famille/_proches.html.twig' with {joueur: j, proches: e.proches, peut_gerer: true, peut_acces: true} %}
            {% endif %}
        </section>
    {% else %}
        <p class="discret">Votre compte n'est relié à aucun joueur pour le moment. Contactez l'éducateur de l'équipe.</p>
    {% endfor %}
    <datalist id="motifs-absence">{% for mo in motifs %}<option value="{{ mo }}">{% endfor %}</datalist>
{% endblock %}
