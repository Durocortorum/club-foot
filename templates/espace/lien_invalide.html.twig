{% extends 'base.html.twig' %}

{% block title %}Lien expiré{% endblock %}

{% block body %}
    <div class="connexion">
        <div class="carte">
            <h1>Ce lien ne fonctionne plus</h1>
            <p>
                Il a déjà servi, ou il a expiré ({{ constant('App\\Service\\AccesFamille::DUREE_LIEN') }} jours),
                ou un lien plus récent vous a été envoyé.
            </p>
            <p>Si vous avez déjà choisi votre mot de passe, connectez-vous simplement. Sinon, demandez un nouveau lien à l'éducateur.</p>
            <a class="bouton principal plein" href="{{ path('app_connexion') }}">Se connecter</a>
        </div>
    </div>
{% endblock %}
