{% extends 'base.html.twig' %}

{% block title %}Activer mon compte{% endblock %}

{% block body %}
    <div class="connexion">
        <div class="carte large">
            <div class="connexion-titre">
                <img class="blason grand" src="{{ logo_club }}" alt="">
                <h1>{{ apparence.club.nom }}</h1>
                <p>Espace famille</p>
            </div>

            <p>
                Bienvenue ! Votre compte <strong>{{ compte.email }}</strong> permet de suivre
                {{ compte.joueurs|map(j => j.prenom ~ ' ' ~ j.nom)|join(', ', ' et ') }} :
                prochains matchs et, bientôt, convocations.
                Choisissez votre mot de passe pour l'activer.
            </p>

            <details class="petit">
                <summary>Utilisation de vos données</summary>
                <p class="discret">
                    Le club utilise votre adresse e-mail pour vous connecter à cet espace et vous transmettre les informations
                    de l'équipe (convocations, matchs, messages). Elle n'est ni vendue, ni communiquée à d'autres organismes.
                    Vous pouvez demander à tout moment au club de modifier ou de supprimer votre compte.
                </p>
            </details>

            {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'formulaire'}}) }}
                {{ form_errors(form) }}
                <div class="champ">{{ form_label(form.motDePasse.first) }}{{ form_widget(form.motDePasse.first) }}{{ form_help(form.motDePasse.first) }}{{ form_errors(form.motDePasse.first) }}</div>
                <div class="champ">{{ form_label(form.motDePasse.second) }}{{ form_widget(form.motDePasse.second) }}{{ form_errors(form.motDePasse.second) }}</div>
                {{ form_errors(form.motDePasse) }}
                <div class="champ case">{{ form_label(form.accord) }}{{ form_widget(form.accord) }}</div>
                {{ form_errors(form.accord) }}
                {{ form_rest(form) }}
                <button type="submit" class="bouton principal plein">Activer mon compte</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
