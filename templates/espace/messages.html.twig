{% extends 'base.html.twig' %}

{% block title %}Messages{% endblock %}

{% block body %}
    <p><a href="{{ path('app_espace') }}">← Mon espace</a></p>
    <h1>Messages du club</h1>

    {% if lignes %}
        <ul class="boite-reception">
            {% for l in lignes %}
                {% set msg = l.message %}
                <li class="{{ not l.lu or l.nouvelles_reponses ? 'non-lu' }}">
                    <a href="{{ path('app_espace_message', {id: msg.id}) }}">
                        <span class="boite-sujet">
                            {% if not l.lu %}<span class="point-non-lu" aria-label="non lu"></span>{% endif %}
                            {{ msg.sujet }}
                            {% if msg.important %} <span class="pastille alerte">important</span>{% endif %}
                            {% if l.nouvelles_reponses %} <span class="pastille succes">{{ l.nouvelles_reponses }} {{ accord(l.nouvelles_reponses, 'réponse') }}</span>{% endif %}
                        </span>
                        <span class="boite-info discret petit">{{ msg.auteurNom }} · {{ msg.creeLe|date('d/m/Y') }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="discret">Aucun message pour l'instant. Les messages de l'encadrement (éducateurs, dirigeants) apparaîtront ici.</p>
    {% endif %}
{% endblock %}
