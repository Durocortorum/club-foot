{% extends 'base.html.twig' %}

{% block title %}Messages{% endblock %}

{% block body %}
    <p><a href="{{ path('app_espace') }}">← Mon espace</a></p>
    <div class="titre-page">
        <h1 data-liste-messages>Messages du club</h1>
        <a class="bouton principal" href="{{ path('app_espace_message_nouveau') }}">+ Écrire à l'encadrement</a>
    </div>

    {# Conversations reçues et écrites, la plus récemment active en tête (comme une messagerie de téléphone). #}
    {% if conversations %}
        <ul class="boite-reception bloc">
            {% for c in conversations %}
                {% set msg = c.message %}
                {% set nouveau = not c.lu or c.nouvelles_reponses %}
                <li class="{{ nouveau ? 'non-lu' }}">
                    <a href="{{ path('app_espace_message', {id: msg.id}) }}">
                        <span class="boite-sujet">
                            {% if nouveau %}<span class="point-non-lu" aria-label="nouveau"></span>{% endif %}
                            {{ msg.sujet }}
                            {% if msg.important %} <span class="pastille alerte">important</span>{% endif %}
                            {% if c.nouvelles_reponses %} <span class="pastille succes">{{ c.nouvelles_reponses }} {{ accord(c.nouvelles_reponses, 'nouvelle réponse', 'nouvelles réponses') }}</span>{% endif %}
                        </span>
                        <span class="boite-info discret petit">
                            {{ c.envoye ? 'Vous → ' ~ msg.cibleLibelle : msg.auteurNom }} · {{ c.activite|date('d/m/Y H:i') }}
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="discret">Aucun message pour l'instant. Les messages de l'encadrement (éducateurs, dirigeants) apparaîtront ici ; vous pouvez aussi leur écrire.</p>
    {% endif %}
{% endblock %}
