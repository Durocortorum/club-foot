{% extends 'base.html.twig' %}

{% block title %}Bilan du direct · {{ rencontre.domicile }} – {{ rencontre.exterieur }}{% endblock %}

{% macro pct(v) %}{% if v is not null %}<span class="pct {{ v >= 70 ? 'bon' : (v < 50 ? 'faible') }}">{{ v }} %</span>{% else %}<span class="discret">–</span>{% endif %}{% endmacro %}
{% macro min(periode, minute, mi) %}{% set fin = (periode == 1 ? 1 : 2) * mi %}{{ minute > fin ? fin ~ '+' ~ (minute - fin) : minute }}'{% endmacro %}
{% import _self as m %}

{% block body %}
    {% set nous = rencontre.ADomicile ? rencontre.domicile : rencontre.exterieur %}
    {# Cadre Turbo : la page « En direct » affiche ce bilan sous la saisie (bouton « Voir le bilan du match »),
       sans quitter la page ; les liens vers d'autres pages sortent du cadre (data-turbo-frame="_top"). #}
    <turbo-frame id="bilan-direct">
    <p class="lien-retour bilan-retour"><a href="{{ path('app_rencontre_voir', {id: rencontre.id}) }}" data-turbo-frame="_top">← Match</a></p>
    <div class="titre-page">
        <div>
            <h1>Statistiques du match</h1>
            <p class="discret">{{ nous }} {{ stats.pour }} – {{ stats.contre }} {{ rencontre.adversaire }} · {{ rencontre.categorie }} · {{ rencontre.date|date('d/m/Y') }} · {{ notees }} action{{ notees > 1 ? 's' }} notée{{ notees > 1 ? 's' }} en direct{% if actions|length > notees %}, complétée{{ notees > 1 ? 's' }} par la feuille de match (buts, cartons, remplacements){% endif %}</p>
        </div>
        <span class="actions">
            {% if modifiable %}<a class="bouton principal bilan-saisie" href="{{ path('app_match_live', {id: rencontre.id}) }}" data-turbo-frame="_top">Saisie en direct</a>{% endif %}
            {# Notés en direct mais pas encore sur la feuille de match. #}
            {% set a_reporter = direct_a_reporter(rencontre) %}
            {% if modifiable and (a_reporter.buts or a_reporter.cartons or a_reporter.changements) %}
                <form method="post" action="{{ path('app_match_direct_reporter', {id: rencontre.id}) }}" class="en-ligne" data-turbo-frame="_top">
                    <input type="hidden" name="_token" value="{{ csrf_token('reporter' ~ rencontre.id) }}">
                    <button type="submit" class="bouton" title="Buts (si la feuille n'en a pas), cartons et changements notés en direct">Reporter sur la feuille de match</button>
                </form>
            {% endif %}
        </span>
    </div>

    {% if not actions %}
        <p class="vide carte">Aucune action notée pour ce match.{% if modifiable %} Ouvrez le <a href="{{ path('app_match_live', {id: rencontre.id}) }}" data-turbo-frame="_top">direct</a> au coup d'envoi.{% endif %}</p>
    {% else %}
        {% set e = stats.equipe %}
        <div class="tuiles bilan">
            <div class="tuile"><span class="tuile-valeur">{{ m.pct(reussite(e, 'passe')) }}</span><span class="tuile-libelle">passes réussies ({{ e.BP + e.MP }})</span></div>
            <div class="tuile"><span class="tuile-valeur">{{ m.pct(reussite(e, 'duel')) }}</span><span class="tuile-libelle">duels gagnés ({{ e.DG + e.DP }})</span></div>
            <div class="tuile"><span class="tuile-valeur">{{ m.pct(reussite(e, 'controle')) }}</span><span class="tuile-libelle">bons contrôles ({{ e.BC + e.MC }})</span></div>
            <div class="tuile"><span class="tuile-valeur">{{ e.FC }} / {{ e.FC + e.FH }}</span><span class="tuile-libelle">frappes cadrées</span></div>
            <div class="tuile"><span class="tuile-valeur">{{ e.TC }} / {{ e.TC + e.TH }}</span><span class="tuile-libelle">têtes cadrées</span></div>
            <div class="tuile"><span class="tuile-valeur">{{ e.AC + e.ATC }} / {{ e.AC + e.AH + e.ATC + e.ATH }}</span><span class="tuile-libelle">frappes et têtes adverses cadrées</span></div>
            <div class="tuile"><span class="tuile-valeur">{{ e.C }}</span><span class="tuile-libelle">centres</span></div>
            <div class="tuile"><span class="tuile-valeur double">{{ e.CO }} – {{ e.CA }}</span><span class="tuile-libelle">corners pour – contre</span></div>
            <div class="tuile"><span class="tuile-valeur"><b class="pastille-action action-CJ">{{ e.CJ }}</b> <b class="pastille-action action-CR">{{ e.CR }}</b></span><span class="tuile-libelle">cartons (adversaire : {{ e.JA }} jaune{{ e.JA > 1 ? 's' }}, {{ e.RA }} rouge{{ e.RA > 1 ? 's' }})</span></div>
        </div>

        {# Carte du terrain : même terrain que le Match Live, dessinée dans la page (carte_match_controller.js). #}
        <section class="carte bloc carte-match" id="carte" data-controller="carte-match" data-carte-match-donnees-value="{{ carte|json_encode }}">
            <h2>Carte du terrain</h2>
            <p class="carte-match-barre">
                <span class="discret petit">Nous attaquons →</span>
                <span class="choix-mode" role="group" aria-label="Affichage">
                    <button type="button" class="filtre-terrain" data-mode="points" data-action="carte-match#choisirMode" data-carte-match-target="boutonMode">📍 Endroits</button>
                    <button type="button" class="filtre-terrain" data-mode="zones" data-action="carte-match#choisirMode" data-carte-match-target="boutonMode">▦ Zones</button>
                </span>
            </p>
            <div class="live-filtres-terrain" data-carte-match-target="filtres"></div>
            <div class="terrain-direct horizontal consultation" data-sens="avant" data-carte-match-target="terrain">
                <span class="marque mediane"></span><span class="marque rond"></span>
                <span class="marque surface nous"></span><span class="marque surface eux"></span>
                <div class="zones"></div>
            </div>
            <p class="live-legende-terrain" data-carte-match-target="legende"></p>
            <p class="discret petit">Touchez une équipe ou un joueur pour ne voir que ses actions, et une couleur de la légende pour ne garder que ce type d'action. Passez sur un rond pour la minute et le joueur. « Zones » : nombre d'actions de chaque zone (rouge : nous ; bleu : l'adversaire).</p>
        </section>


        {% if traces.marques or traces.encaisses %}
            <section class="carte bloc">
                <h2>Les buts</h2>
                <p class="discret petit">D'où part le ballon (rond, avec la minute) et où il entre dans le but (flèche) ; pointillés : de la tête.</p>
                <div class="buts-schemas">
                    <figure>
                        <figcaption>Buts marqués ({{ traces.marques|length }})</figcaption>
                        {{ include('match_direct/_demi_terrain.html.twig', {buts: traces.marques, cote: 'eux'}) }}
                        <ul class="buts-liste">{% for b in traces.marques %}<li><b>{{ m.min(b.periode, b.minute, mi) }}</b> {{ b.nom ?: '—' }}{{ b.passeur ? ', passe de ' ~ b.passeur }}{{ b.geste ? ' · ' ~ b.geste }}</li>{% endfor %}</ul>
                    </figure>
                    <figure>
                        <figcaption>Buts encaissés ({{ traces.encaisses|length }})</figcaption>
                        {{ include('match_direct/_demi_terrain.html.twig', {buts: traces.encaisses, cote: 'nous'}) }}
                        <ul class="buts-liste">{% for b in traces.encaisses %}<li><b>{{ m.min(b.periode, b.minute, mi) }}</b> {{ b.geste ?: 'adversaire' }}</li>{% endfor %}</ul>
                    </figure>
                </div>
            </section>
        {% endif %}

        {% if changements %}
            <section class="carte bloc">
                <h2>Changements ({{ changements|length }})</h2>
                <ul class="liste-changements">
                    {% for c in changements %}
                        <li><b>{{ m.min(c.periode, c.minute, mi) }}</b>
                            <span class="sort">↓ {{ c.sortant ? c.sortant.prenom ~ ' ' ~ c.sortant.nom : '—' }}</span>
                            {% if c.entrant %}<span class="entre">↑ {{ c.entrant.prenom ~ ' ' ~ c.entrant.nom }}</span>{% elseif c.motif == 'Carton blanc' %}<span class="discret">carton blanc, 10 min hors du terrain, revient ensuite</span>{% else %}<span class="discret">sans remplaçant</span>{% endif %}
                            {% if c.motif == 'Blessure' %}<span class="discret">(blessure)</span>{% endif %}</li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <section class="carte bloc">
            <h2>Par joueur</h2>
            <div class="table-defile">
                <table class="liste chiffres stats-direct colonne-figee">
                    <thead><tr>
                        <th class="texte">Joueur</th>
                        <th title="Bonnes passes / mauvaises passes">Passes</th><th>%</th>
                        <th title="Duels gagnés / perdus">Duels</th><th>%</th>
                        <th title="Bons contrôles / mauvais contrôles">Contrôles</th><th>%</th>
                        <th title="Frappes cadrées / total">Frappes</th><th title="Têtes cadrées / total">Têtes</th><th>Centres</th><th>Buts</th><th title="Passes décisives">Passes D.</th><th title="Cartons jaunes / rouges">Cartons</th><th>Total</th>
                    </tr></thead>
                    <tbody>
                        {% for l in stats.joueurs %}
                            {% set a = l.actions %}
                            <tr>
                                <td class="texte nowrap"><a href="{{ path('app_match_direct_bilan', {id: rencontre.id, joueur: l.joueur.id}) }}#carte">{{ l.joueur.nom }} {{ l.joueur.prenom }}</a></td>
                                <td>{{ a.BP ?? 0 }} / {{ a.MP ?? 0 }}</td><td>{{ m.pct(reussite(a, 'passe')) }}</td>
                                <td>{{ a.DG ?? 0 }} / {{ a.DP ?? 0 }}</td><td>{{ m.pct(reussite(a, 'duel')) }}</td>
                                <td>{{ a.BC ?? 0 }} / {{ a.MC ?? 0 }}</td><td>{{ m.pct(reussite(a, 'controle')) }}</td>
                                <td>{{ a.FC ?? 0 }} / {{ (a.FC ?? 0) + (a.FH ?? 0) }}</td><td>{{ a.TC ?? 0 }} / {{ (a.TC ?? 0) + (a.TH ?? 0) }}</td><td>{{ a.C ?? 0 }}</td><td>{{ a.B ?? 0 }}</td><td>{{ a.PD ?? 0 }}</td>
                                <td>{% if a.CJ ?? 0 %}<b class="pastille-action action-CJ">{{ a.CJ }}</b>{% endif %} {% if a.CR ?? 0 %}<b class="pastille-action action-CR">{{ a.CR }}</b>{% endif %}</td>
                                <td class="fort">{{ l.total }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    {# Toute l'équipe : nos actions (celles sans joueur comprises, comme un corner). #}
                    {% set totalNous = 0 %}{% for code in types|keys %}{% set totalNous = totalNous + e[code] %}{% endfor %}
                    <tfoot>
                        <tr class="total-equipe">
                            <th class="texte">Équipe</th>
                            <td>{{ e.BP }} / {{ e.MP }}</td><td>{{ m.pct(reussite(e, 'passe')) }}</td>
                            <td>{{ e.DG }} / {{ e.DP }}</td><td>{{ m.pct(reussite(e, 'duel')) }}</td>
                            <td>{{ e.BC }} / {{ e.MC }}</td><td>{{ m.pct(reussite(e, 'controle')) }}</td>
                            <td>{{ e.FC }} / {{ e.FC + e.FH }}</td><td>{{ e.TC }} / {{ e.TC + e.TH }}</td><td>{{ e.C }}</td><td>{{ e.B }}</td><td>{{ e.PD }}</td>
                            <td><b class="pastille-action action-CJ">{{ e.CJ }}</b> <b class="pastille-action action-CR">{{ e.CR }}</b></td>
                            <td class="fort">{{ totalNous }}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        <section class="carte bloc">
            <h2>Par quart d'heure</h2>
            <div class="table-defile">
                <table class="liste chiffres colonne-figee">
                    <thead><tr><th class="texte">Minutes</th><th>Passes ✓/✗</th><th>Duels ✓/✗</th><th title="Frappes et têtes">Frappes</th><th title="Frappes et têtes de l'adversaire">Frappes adverses</th><th>Buts</th><th title="Nos cartons – ceux de l'adversaire">Cartons</th></tr></thead>
                    <tbody>
                        {% for q in stats.quarts %}
                            {% set a = q.actions %}
                            <tr>
                                <td class="texte nowrap">{{ q.debut }}′ – {{ q.fin }}′</td>
                                <td>{{ a.BP ?? 0 }} / {{ a.MP ?? 0 }}</td><td>{{ a.DG ?? 0 }} / {{ a.DP ?? 0 }}</td>
                                <td>{{ (a.FC ?? 0) + (a.FH ?? 0) + (a.TC ?? 0) + (a.TH ?? 0) }}</td><td>{{ (a.AC ?? 0) + (a.AH ?? 0) + (a.ATC ?? 0) + (a.ATH ?? 0) }}</td><td>{{ a.B ?? 0 }} – {{ a.BA ?? 0 }}</td><td>{{ (a.CJ ?? 0) + (a.CR ?? 0) }} – {{ (a.JA ?? 0) + (a.RA ?? 0) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <details class="carte bloc">
            <summary><strong>Toutes les actions ({{ actions|length }})</strong></summary>
            <ol class="journal">
                {% for a in actions %}
                    <li><span class="min">{{ m.min(a.periode, a.minute, mi) }}</span><span class="quoi"><b class="pastille-action action-{{ a.type }}">{{ a.type }}</b> {% if a.joueur %}{{ a.joueur.nom }} {{ a.joueur.prenom }} · {% endif %}{{ a.libelle }}{% if a.uuid starts with 'feuille-' %} <span class="discret">(feuille de match)</span>{% endif %}</span></li>
                {% endfor %}
            </ol>
        </details>
    {% endif %}
    </turbo-frame>
{% endblock %}
