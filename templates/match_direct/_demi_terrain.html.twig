{#
    Demi-terrain vu de dessus avec le but et ses poteaux (mesures en mètres, terrain de 105 × 68),
    et les buts : ballon au départ du tir, flèche jusqu'au point d'entrée dans le but.
    Variables : buts (liste de {minute, nom, geste, depart, arrivee}), cote = 'eux' (but adverse à droite) ou 'nous' (notre but à gauche).
#}
{% set droite = cote == 'eux' %}
{% set couleur = droite ? '#d62839' : '#1f5fd1' %}
<svg class="demi-terrain-buts" viewBox="{{ droite ? '50.5 -2 58.5 72' : '-3.5 -2 58.5 72' }}" role="img"
     aria-label="{{ droite ? 'Buts marqués' : 'Buts encaissés' }} : départ du ballon et direction dans le but">
    <defs>
        <marker id="pointe-but-{{ cote }}" viewBox="0 0 4 4" refX="3.2" refY="2" markerWidth="3.2" markerHeight="3.2" orient="auto-start-reverse">
            <path d="M0,0 L4,2 L0,4 z" fill="{{ couleur }}"/>
        </marker>
    </defs>
    {% set bx = droite ? 105 : 0 %}{% set s = droite ? -1 : 1 %}
    <rect x="{{ droite ? 52.5 : 0 }}" y="0" width="52.5" height="68" fill="#eef6ef" stroke="#9cc9a3" stroke-width="0.3"/>
    {# Surface de réparation, surface de but, point de penalty, arc et rond central. #}
    <path d="M{{ bx }},13.84 H{{ bx + s * 16.5 }} V54.16 H{{ bx }}" fill="none" stroke="#9cc9a3" stroke-width="0.3"/>
    <path d="M{{ bx }},24.84 H{{ bx + s * 5.5 }} V43.16 H{{ bx }}" fill="none" stroke="#9cc9a3" stroke-width="0.3"/>
    <circle cx="{{ bx + s * 11 }}" cy="34" r="0.35" fill="#9cc9a3"/>
    <path d="M{{ bx + s * 16.5 }},26.69 A9.15,9.15 0 0 {{ droite ? 0 : 1 }} {{ bx + s * 16.5 }},41.31" fill="none" stroke="#9cc9a3" stroke-width="0.3"/>
    <path d="M52.5,24.85 A9.15,9.15 0 0 {{ droite ? 1 : 0 }} 52.5,43.15" fill="none" stroke="#9cc9a3" stroke-width="0.3"/>
    {# Le but : filets derrière la ligne, deux poteaux. #}
    <rect x="{{ droite ? 105 : -2.4 }}" y="30.34" width="2.4" height="7.32" fill="url(#filet-{{ cote }})" stroke="#6b6e75" stroke-width="0.2"/>
    <pattern id="filet-{{ cote }}" width="0.8" height="0.8" patternUnits="userSpaceOnUse"><rect width="0.8" height="0.8" fill="#e6e9ee"/><path d="M0,0 L0.8,0.8 M0.8,0 L0,0.8" stroke="#8d939c" stroke-width="0.08"/></pattern>
    <circle cx="{{ bx }}" cy="30.34" r="0.45" fill="#fff" stroke="#1d1d1f" stroke-width="0.2"/>
    <circle cx="{{ bx }}" cy="37.66" r="0.45" fill="#fff" stroke="#1d1d1f" stroke-width="0.2"/>
    {% for b in buts %}
        <g>
            <title>{{ b.minute }}' {{ b.nom }}{{ b.geste ? ' · ' ~ b.geste }}{{ b.situation ? ' · sur ' ~ {corner: 'corner', cfd: 'coup franc direct', cfi: 'coup franc indirect', penalty: 'penalty'}[b.situation] ~ (b.passeur and b.situation in ['corner', 'cfi'] ? ' de ' ~ b.passeur) }}</title>
            {# But sur corner : le centre part du drapeau (côté du tir), en pointillés fins, jusqu'au départ du tir. #}
            {% if b.situation == 'corner' %}
                {% set cy = b.depart[1] < 34 ? 0 : 68 %}
                <line x1="{{ bx }}" y1="{{ cy }}" x2="{{ b.depart[0] }}" y2="{{ b.depart[1] }}" stroke="{{ couleur }}" stroke-width="0.3" stroke-dasharray="0.8 0.8" opacity="0.8"/>
                {% set haut = cy ? cy - 3.2 : 3.2 %}
                <path d="M{{ bx }},{{ cy }} V{{ haut }}" stroke="#1d1d1f" stroke-width="0.25"/>
                <path d="M{{ bx }},{{ haut }} l{{ s * 2.2 }},{{ cy ? 0.8 : -0.8 }} l{{ -s * 2.2 }},{{ cy ? 0.8 : -0.8 }} z" fill="{{ couleur }}"/>
            {% endif %}
            {# Coup franc indirect : de l'endroit où il est tiré jusqu'à la reprise, en pointillés. #}
            {% if b.situation == 'cfi' and b.coupFranc|default(null) %}
                <line x1="{{ b.coupFranc[0] }}" y1="{{ b.coupFranc[1] }}" x2="{{ b.depart[0] }}" y2="{{ b.depart[1] }}" stroke="{{ couleur }}" stroke-width="0.3" stroke-dasharray="0.8 0.8" opacity="0.8"/>
                <circle cx="{{ b.coupFranc[0] }}" cy="{{ b.coupFranc[1] }}" r="0.8" fill="#fff" stroke="{{ couleur }}" stroke-width="0.3"/>
            {% endif %}
            <line x1="{{ b.depart[0] }}" y1="{{ b.depart[1] }}" x2="{{ b.arrivee[0] }}" y2="{{ b.arrivee[1] }}" stroke="{{ couleur }}" stroke-width="0.45"
                  stroke-dasharray="{{ b.geste == 'Tête' ? '1 0.6' : 'none' }}" marker-end="url(#pointe-but-{{ cote }})"/>
            <circle cx="{{ b.depart[0] }}" cy="{{ b.depart[1] }}" r="0.9" fill="#fff" stroke="#1d1d1f" stroke-width="0.2"/>
            <text x="{{ b.depart[0] }}" y="{{ b.depart[1] - 1.6 }}" text-anchor="middle" font-size="1.9" font-weight="700" fill="#1d1d1f">{{ b.minute }}'</text>
            {# Coup franc (CF) ou penalty (P) : pastille sous le ballon. #}
            {% if b.situation in ['cfd', 'cfi', 'penalty'] %}
                <rect x="{{ b.depart[0] - 1.7 }}" y="{{ b.depart[1] + 1.3 }}" width="3.4" height="2.1" rx="1" fill="{{ couleur }}"/>
                <text x="{{ b.depart[0] }}" y="{{ b.depart[1] + 2.85 }}" text-anchor="middle" font-size="1.5" font-weight="800" fill="#fff">{{ b.situation == 'penalty' ? 'P' : 'CF' }}</text>
            {% endif %}
        </g>
    {% endfor %}
</svg>
