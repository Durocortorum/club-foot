{% extends 'base.html.twig' %}

{% block title %}{{ message.sujet }}{% endblock %}

{% block body %}
    <p class="lien-retour"><a href="{{ path('app_message_index') }}">← Messages</a></p>

    <h1>{{ message.sujet }}{% if message.important %} <span class="pastille alerte">important</span>{% endif %}</h1>
    <p class="discret">De {{ message.auteurNom }} · {{ message.creeLe|date('d/m/Y à H:i') }} · pour {{ message.cibleLibelle }}</p>

    <section class="carte message-corps" data-fil-message="{{ message.id }}" data-fil-signature="{{ fil|length }}">{{ message.corps|nl2br }}</section>

    <section class="bloc" id="fil-{{ app.user.id }}">
        <h2 class="titre-bloc">Votre conversation avec {{ message.auteurNom }}</h2>
        <div class="carte fil">
            {% for r in fil %}
                <div class="bulle {{ r.deLEncadrement ? 'encadrement' : 'famille' }}">
                    <div class="bulle-entete">{{ r.deLEncadrement ? r.auteurNom : 'Vous' }} · {{ r.creeLe|date('d/m à H:i') }}</div>
                    {{ r.corps|nl2br }}
                </div>
            {% endfor %}
            <form method="post" action="{{ path('app_message_repondre', {id: message.id, famille: app.user.id}) }}" class="repondre">
                <input type="hidden" name="_token" value="{{ csrf_token('repondre-message' ~ message.id ~ '-' ~ app.user.id) }}">
                <textarea name="corps" rows="3" maxlength="3000" required placeholder="Votre réponse" aria-label="Votre réponse"></textarea>
                <button class="bouton principal">Envoyer</button>
            </form>
        </div>
    </section>
{% endblock %}
