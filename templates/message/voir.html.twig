{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}{{ message.sujet }}{% endblock %}

{% block body %}
    <p class="lien-retour"><a href="{{ path('app_message_index') }}">← Messages</a></p>

    <div class="titre-page">
        <h1>{{ message.sujet }}{% if message.important %} <span class="pastille alerte">important</span>{% endif %}</h1>
        {% if peut_supprimer %}
            {{ m.supprimer(path('app_message_supprimer', {id: message.id}), 'supprimer-message' ~ message.id, 'Supprimer ce message ? Les familles ne le verront plus, ni les réponses.') }}
        {% endif %}
    </div>
    <p class="discret">
        {{ message.creeLe|date('d/m/Y à H:i') }} · de {{ message.auteurNom }} · pour {{ message.cibleLibelle }}
        {% if message.rencontre and is_granted('MATCH_MODIFIER', message.rencontre) %} · <a href="{{ path('app_convocation', {id: message.rencontre.id}) }}">convocation du match</a>{% endif %}
    </p>

    <section class="carte message-corps" data-fil-message="{{ message.id }}" data-fil-signature="{{ message.reponses|length }}">{{ message.corps|nl2br }}</section>

    <section class="bloc" id="reponses">
        <h2 class="titre-bloc">Réponses</h2>
        {% for id, f in fils %}
            <div class="carte fil" id="fil-{{ id }}">
                <h3>{{ f.qui }}{% if f.famille.famille %} <span class="discret petit">{{ f.famille.email }}</span>{% endif %}</h3>
                {% for r in f.reponses %}
                    <div class="bulle {{ r.deLEncadrement ? 'encadrement' : 'famille' }}">
                        <div class="bulle-entete">{{ r.deLEncadrement ? r.auteurNom : f.qui }} · {{ r.creeLe|date('d/m à H:i') }}</div>
                        {{ r.corps|nl2br }}
                    </div>
                {% endfor %}
                <form method="post" action="{{ path('app_message_repondre', {id: message.id, famille: id}) }}" class="repondre">
                    <input type="hidden" name="_token" value="{{ csrf_token('repondre-message' ~ message.id ~ '-' ~ id) }}">
                    <textarea name="corps" rows="2" maxlength="3000" required placeholder="Répondre" aria-label="Réponse à {{ f.famille.email }}"></textarea>
                    <button class="bouton principal">Répondre</button>
                </form>
            </div>
        {% else %}
            <p class="discret">Aucune réponse pour l'instant.</p>
        {% endfor %}
    </section>

    {% set collegues = message.destinatairesEncadrement %}
    {% if collegues %}
        <section class="bloc">
            <h2 class="titre-bloc">Destinataires <span class="compteur">{{ collegues|length }}</span></h2>
            <ul class="liste-simple">
                {% for d in collegues %}
                    <li>
                        {{ d.compte.prenom }} {{ d.compte.nom }}
                        {% if d.luLe %}<span class="pastille succes" title="Lu le {{ d.luLe|date('d/m/Y à H:i') }}">lu</span>{% else %}<span class="pastille">non lu</span>{% endif %}
                        {% if not fils[d.compte.id] is defined %}
                            <details class="repondre-premier">
                                <summary>Écrire à {{ d.compte.prenom }}</summary>
                                <form method="post" action="{{ path('app_message_repondre', {id: message.id, famille: d.compte.id}) }}" class="repondre">
                                    <input type="hidden" name="_token" value="{{ csrf_token('repondre-message' ~ message.id ~ '-' ~ d.compte.id) }}">
                                    <textarea name="corps" rows="2" maxlength="3000" required aria-label="Message à {{ d.compte.prenom }}"></textarea>
                                    <button class="bouton principal">Envoyer</button>
                                </form>
                            </details>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if lignes %}
    <section class="bloc">
        <h2 class="titre-bloc">Destinataires <span class="compteur">{{ lignes|length }}</span></h2>
        <p class="discret petit">{{ message.nombreLus }} {{ accord(message.nombreLus, 'joueur') }} sur {{ lignes|length }} : message lu par au moins un compte de la famille.</p>
        <div class="table-defile">
            <table class="liste liste-fiches">
                <thead><tr><th>Joueur</th><th>Comptes famille</th></tr></thead>
                <tbody>
                    {% for l in lignes %}
                        <tr>
                            <td class="nowrap principal"><strong>{{ l.joueur.nom }}</strong> {{ l.joueur.prenom }}</td>
                            <td class="petit large">
                                {% for d in l.destinataires %}
                                    <div>
                                        {{ d.compte.email }}
                                        {% if d.luLe %}<span class="pastille succes" title="Lu le {{ d.luLe|date('d/m/Y à H:i') }}">lu</span>
                                        {% elseif d.compte.password is null %}<span class="pastille">compte pas encore activé</span>
                                        {% else %}<span class="pastille">non lu</span>{% endif %}
                                    </div>
                                {% else %}
                                    <span class="pastille alerte">aucun compte famille</span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    {% endif %}

    {% if lignes and (sans_compte or not email_actif) %}
        <section class="carte bloc" data-controller="copier" data-copier-texte-value="{{ texte_a_copier }}">
            <h2>À prévenir autrement</h2>
            {% if sans_compte %}
                <p>Sans compte famille actif, ces familles ne voient pas le message :
                    <strong>{{ sans_compte|map(l => l.joueur.prenom ~ ' ' ~ l.joueur.nom)|join(', ') }}</strong>.
                    Copiez-le pour WhatsApp ou un SMS, ou invitez-les depuis la page « Accès familles ».</p>
            {% else %}
                <p>Les e-mails ne partent pas de ce site : copiez le message pour le groupe WhatsApp, si besoin.</p>
            {% endif %}
            <button type="button" class="bouton" data-action="copier#copier" data-copier-target="bouton">Copier le message</button>
        </section>
    {% endif %}
{% endblock %}
