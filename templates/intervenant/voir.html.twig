{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}{{ intervenant.nomComplet }}{% endblock %}

{% block body %}
    <p class="lien-retour"><a href="{{ path('app_intervenant_index', {type: type}) }}">← {{ libelles.pluriel }}</a></p>

    <div class="titre-page">
        <div class="identite">
            {{ m.avatar(intervenant, 'grand') }}
            <div>
                <h1>{{ intervenant.prenom }} <strong>{{ intervenant.nom }}</strong></h1>
                <p class="discret">
                    {{ libelles.singulier|capitalize }}
                    {% if intervenant.fonction %} · {{ intervenant.fonction }}{% endif %}
                    {% if intervenant.ancien %} <span class="pastille">a quitté le club</span>{% endif %}
                </p>
            </div>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <div class="actions">
                <a class="bouton principal" href="{{ path('app_intervenant_modifier', {type: type, id: intervenant.id}) }}">Modifier</a>
                {{ m.supprimer(path('app_intervenant_supprimer', {type: type, id: intervenant.id}), 'supprimer' ~ type ~ intervenant.id, 'Supprimer définitivement la fiche de ' ~ intervenant.nomComplet ~ ' ?') }}
            </div>
        {% endif %}
    </div>

    <div class="grille-fiches">
        <section class="carte">
            <h2>Club</h2>
            <dl>
                {% if intervenant.equipes is defined and intervenant.equipes is not empty %}
                    <dt>Équipes</dt>
                    <dd>{% for c in intervenant.equipes %}<a href="{{ path('app_joueur_index', {categorie: c.id}) }}">{{ c.nom }}</a>{% if c.feminine %}<span class="pastille feminine" title="Équipe féminine">F</span>{% endif %}{{ not loop.last ? ', ' }}{% endfor %}</dd>
                {% endif %}
                {{ m.ligne('Équipe / fonction', intervenant.fonction) }}
                {{ m.ligne('Seconde équipe', intervenant.fonction2) }}
                {% if type == 'arbitres' %}
                    {{ m.ligne('Niveau', intervenant.niveau) }}
                    {{ m.ligne('Équipement fourni', intervenant.equipement) }}
                {% endif %}
                {{ m.ligne('Diplôme', intervenant.diplome ? intervenant.diplome ~ (intervenant.dateDiplome ? ' (obtenu le ' ~ intervenant.dateDiplome|date('d/m/Y') ~ ')') : null) }}
                {% if not intervenant.diplome and intervenant.dateDiplome %}{{ m.ligne('Diplôme obtenu le', intervenant.dateDiplome|date('d/m/Y')) }}{% endif %}
                {{ m.ligne('N° de licence', intervenant.licence) }}
                {% if intervenant.permis or conducteur %}
                    <dt>Permis</dt>
                    <dd>
                        {{ intervenant.permis ?? conducteur.categoriesPermis }}
                        {% if conducteur %}
                            {% set libelle_etat = {ok: 'contrôlé', bientot: 'contrôle à refaire bientôt', a_controler: 'contrôle à faire', expire: 'permis plus valable'}[conducteur.etat] %}
                            · <span class="pastille {{ conducteur.etat in ['ok', 'bientot'] ? 'succes' : 'alerte' }}">conducteur du club : {{ libelle_etat }}</span>
                            {% if conducteur.controleLe %}<span class="discret petit">le {{ conducteur.controleLe|date('d/m/Y') }}</span>{% endif %}
                        {% elseif is_granted('ROLE_ADMIN') %}
                            · <a class="petit" href="{{ path('app_transport_conducteur_nouveau', {nom: intervenant.prenom ~ ' ' ~ intervenant.nom}) }}">l'ajouter aux conducteurs (contrôle du permis)</a>
                        {% endif %}
                    </dd>
                {% endif %}
                {{ m.ligne('Date de naissance', intervenant.dateNaissance ? intervenant.dateNaissance|date('d/m/Y')) }}
            </dl>
        </section>

        <section class="carte">
            <h2>Coordonnées</h2>
            <dl>
                {{ m.ligne('Adresse', intervenant.adresse) }}
                {{ m.ligne('Ville', [intervenant.codePostal, intervenant.ville]|filter(v => v)|join(' ')) }}
                {{ m.ligne('Tél. fixe', intervenant.telFixe) }}
                {{ m.ligne('Portable', intervenant.telPortable1) }}
                {{ m.ligne('Portable 2', intervenant.telPortable2) }}
                {{ m.ligne('Tél. professionnel', intervenant.telProfessionnel) }}
                {% if intervenant.email %}<dt>E-mail</dt><dd><a href="mailto:{{ intervenant.email }}">{{ intervenant.email }}</a></dd>{% endif %}
            </dl>
        </section>

        {% if joueurs %}
            <section class="carte">
                <h2>Joueurs suivis <span class="compteur">{{ joueurs|length }}</span></h2>
                <ul class="liste-simple">
                    {% for j in joueurs %}
                        <li><a href="{{ path('app_joueur_voir', {id: j.id}) }}"><strong>{{ j.nom }}</strong> {{ j.prenom }}</a> <span class="discret">{{ j.categorie }}</span></li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if intervenant.memo %}
            <section class="carte">
                <h2>Mémo</h2>
                <p class="memo">{{ intervenant.memo }}</p>
            </section>
        {% endif %}
    </div>
{% endblock %}
