{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="connexion">
        <div class="carte">
            <div class="connexion-titre">
                <img class="blason grand" src="{{ logo_club }}" alt="">
                <h1>{{ apparence.club.nom }}</h1>
                <p>Gestion du centre de formation</p>
            </div>

            {% if erreur %}
                <div class="flash flash-erreur">{{ erreur.messageKey|trans(erreur.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <label for="email">Adresse e-mail</label>
                <input type="email" id="email" name="email" value="{{ dernier_email }}" autocomplete="username" required autofocus>

                <label for="mot_de_passe">Mot de passe</label>
                <input type="password" id="mot_de_passe" name="mot_de_passe" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="bouton principal plein">Se connecter</button>
            </form>
        </div>
    </div>
{% endblock %}
