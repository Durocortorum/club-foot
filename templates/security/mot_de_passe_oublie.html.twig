{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <div class="connexion">
        <div class="carte">
            <div class="connexion-titre">
                <img class="blason grand" src="{{ logo_club }}" alt="">
                <h1>Mot de passe oublié</h1>
                <p>Recevez un lien pour en choisir un nouveau</p>
            </div>

            <form method="post">
                <label for="email">Adresse e-mail de votre compte</label>
                <input type="email" id="email" name="email" value="{{ email }}" autocomplete="username" required autofocus>
                <input type="hidden" name="_token" value="{{ csrf_token('mot-de-passe-oublie') }}">
                <button type="submit" class="bouton principal plein">Recevoir le lien</button>
            </form>

            <p class="connexion-lien"><a href="{{ path('app_connexion') }}">← Retour à la connexion</a></p>
        </div>
    </div>
{% endblock %}
