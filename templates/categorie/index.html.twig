{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <div class="titre-page">
        <div>
            <h1>Catégories <span class="compteur">{{ categories|length }}</span></h1>
            <p class="discret">Les équipes du club, dans l'ordre où elles apparaissent partout (accueil, filtres, statistiques). Une catégorie ne peut être supprimée que si plus aucun joueur, match ou séance ne l'utilise.</p>
        </div>
        <a class="bouton principal" href="{{ path('app_categorie_nouvelle') }}">+ Nouvelle catégorie</a>
    </div>

    <div class="table-defile">
        <table class="liste liste-fiches">
            <thead><tr><th>Ordre</th><th>Catégorie</th><th>Secteur</th><th title="Durée d'un match, deux mi-temps">Durée d'un match</th><th>Utilisée par</th><th></th></tr></thead>
            <tbody>
                {% for c in categories %}
                    <tr>
                        <td class="nowrap">
                            {% set bornes = {monter: loop.first, descendre: loop.last} %}
                            {% for sens, symbole in {monter: '↑', descendre: '↓'} %}
                                {% if not bornes[sens] %}
                                    <form method="post" action="{{ path('app_categorie_deplacer', {id: c.id, sens: sens}) }}" class="en-ligne">
                                        <input type="hidden" name="_token" value="{{ csrf_token('deplacer-categorie' ~ c.id) }}">
                                        <button class="bouton petit" title="{{ sens|capitalize }}">{{ symbole }}</button>
                                    </form>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td class="principal"><strong>{{ c.nom }}</strong>{% if c.feminine %}<span class="pastille feminine" title="Équipe féminine">F</span>{% endif %}{% if c.plateaux %} <span class="pastille" title="Joue des plateaux (petits matchs sans classement) au lieu de matchs">plateaux</span>{% endif %}</td>
                        <td>{{ c.secteurLibelle }}</td>
                        <td class="nowrap" data-label="match :">{{ c.dureeMatch ? c.dureeMatch ~ ' min (2 × ' ~ (c.dureeMatch / 2)|round(1)|replace({'.': ','}) ~ ')' : '—' }}</td>
                        <td class="discret" data-label="utilisée par">{{ utilisations[c.id]|join(', ') ?: '—' }}</td>
                        <td class="nowrap actions fin">
                            <a class="bouton petit" href="{{ path('app_categorie_modifier', {id: c.id}) }}">Modifier</a>
                            {% if not utilisations[c.id] %}
                                {{ m.supprimer(path('app_categorie_supprimer', {id: c.id}), 'supprimer-categorie' ~ c.id, 'Supprimer la catégorie « ' ~ c.nom ~ ' » ?') }}
                            {% else %}
                                {# Utilisée : la supprimer ferait perdre leur catégorie aux joueurs, matchs, séances… #}
                                <button class="bouton petit danger" disabled title="Utilisée par {{ utilisations[c.id]|join(', ') }} : changez-les de catégorie avant de la supprimer, ou renommez-la.">Supprimer</button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="vide">Aucune catégorie. Ajoutez vos équipes avec « Nouvelle catégorie ».</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="discret petit">Pour mettre une équipe dans un autre secteur : « Modifier » sur sa ligne, puis « Secteur ». Les flèches ne changent que l'ordre d'affichage. Pastille « plateaux » : l'équipe joue des plateaux (petits matchs sans classement) au lieu de matchs ; à changer avec « Modifier ».</p>

    <section class="bloc" id="responsables-secteur">
        <h2 class="titre-bloc">Responsables de secteur</h2>
        <p class="discret petit">Le responsable d'un secteur voit tout le secteur, modifie les matchs et les convocations de toutes ses équipes et choisit qui les modifie. Il peut aussi être éducateur d'une de ces équipes (fiche Encadrement). S'il n'a pas encore le droit du secteur, il le reçoit en l'enregistrant.</p>
        <form method="post" action="{{ path('app_categorie_responsables_secteur') }}" class="formulaire">
            <input type="hidden" name="_token" value="{{ csrf_token('responsables-secteur') }}">
            <div class="carte">
                <div class="champs">
                    {% for cle, s in secteurs %}
                        <div class="champ">
                            <label for="responsable-{{ cle }}">{{ s.libelle }}</label>
                            <select id="responsable-{{ cle }}" name="responsable[{{ cle }}]">
                                <option value="">— Aucun —</option>
                                {% for u in comptes_encadrement %}
                                    <option value="{{ u.id }}" {{ responsables_secteur[cle] is defined and responsables_secteur[cle] == u ? 'selected' }}>{{ u.prenom }} {{ u.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="actions-ligne">
                <button type="submit" class="bouton principal">Enregistrer les responsables</button>
            </div>
        </form>
    </section>
{% endblock %}
