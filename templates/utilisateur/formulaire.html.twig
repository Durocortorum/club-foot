{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
    <p class="lien-retour"><a href="{{ path('app_utilisateur_index') }}">← Utilisateurs</a></p>
    <div class="titre-page">
        <h1>{{ titre }}</h1>
        {% if suppression is defined %}
            {{ m.supprimer(suppression.action, suppression.jeton, suppression.question) }}
        {% endif %}
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'formulaire'}}) }}
        {{ form_errors(form) }}

        <fieldset class="carte">
            <legend>Identité</legend>
            {{ m.groupe(form, ['prenom', 'nom', 'email']) }}
        </fieldset>

        <fieldset class="carte">
            <legend>Droits</legend>
            <div class="cases-droits">
                {% for case in form.rolesAttribues %}
                    <label class="case-droit">{{ form_widget(case) }} {{ case.vars.label }}</label>
                {% endfor %}
            </div>
            {{ form_help(form.rolesAttribues) }}
            {{ form_errors(form.rolesAttribues) }}
            {% if utilisateur == app.user %}
                <p class="discret petit">Vous ne pouvez pas retirer vos propres droits d'administration.</p>
            {% endif %}
        </fieldset>

        <fieldset class="carte">
            <legend>Mot de passe</legend>
            {% if utilisateur.id and not utilisateur.password %}
                <p class="flash flash-info">Ce compte n'a pas encore de mot de passe : définissez-en un pour que la personne puisse se connecter.</p>
            {% endif %}
            <div class="champs">
                <div class="champ">{{ form_label(form.motDePasse.first) }}{{ form_widget(form.motDePasse.first) }}{{ form_help(form.motDePasse.first) }}{{ form_errors(form.motDePasse.first) }}</div>
                <div class="champ">{{ form_label(form.motDePasse.second) }}{{ form_widget(form.motDePasse.second) }}{{ form_errors(form.motDePasse.second) }}</div>
            </div>
            {{ form_errors(form.motDePasse) }}
        </fieldset>

        {{ form_rest(form) }}
        <div class="barre-actions">
            <button type="submit" class="bouton principal">Enregistrer</button>
        </div>
    {{ form_end(form) }}

    {# Suspension du compte : formulaire à part (on ne met pas un formulaire dans un autre). #}
    {% if utilisateur.id and utilisateur != app.user %}
        <section class="carte bloc" id="suspension">
            <h2>Suspendre le compte</h2>
            {% if utilisateur.suspendu %}
                <p class="flash flash-erreur">
                    Compte suspendu depuis le {{ utilisateur.suspenduLe|date('d/m/Y', 'Europe/Paris') }}{{ utilisateur.suspenduJusquAu ? ', jusqu\'au ' ~ utilisateur.suspenduJusquAu|date('d/m/Y') ~ ' inclus (réactivé tout seul le lendemain)' : ', jusqu\'à sa réactivation' }}.
                    {% if utilisateur.motifSuspension %}<br>Motif : {{ utilisateur.motifSuspension }}{% endif %}
                </p>
                <form method="post" action="{{ path('app_utilisateur_reactiver', {id: utilisateur.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('reactiver-utilisateur' ~ utilisateur.id) }}">
                    <button class="bouton principal">Réactiver le compte</button>
                </form>
            {% else %}
                <p class="discret petit">La personne ne peut plus se connecter (elle est déconnectée si elle l'était), ne reçoit plus les e-mails ni les alertes du site, et ne tient plus ses équipes (matchs rouverts au secteur). Son compte, ses droits et son historique sont gardés : « Réactiver » rend tout comme avant.</p>
                <form method="post" action="{{ path('app_utilisateur_suspendre', {id: utilisateur.id}) }}" class="formulaire"
                      data-confirmation="Suspendre le compte de {{ utilisateur }} ?" data-confirmation-bouton="Suspendre">
                    <input type="hidden" name="_token" value="{{ csrf_token('suspendre-utilisateur' ~ utilisateur.id) }}">
                    <div class="champs">
                        <div class="champ">
                            <label for="jusqu_au">Jusqu'au (inclus)</label>
                            <input type="date" id="jusqu_au" name="jusqu_au" min="{{ 'now'|date('Y-m-d', 'Europe/Paris') }}">
                            <p class="discret petit">Vide : jusqu'à réactivation à la main.</p>
                        </div>
                        <div class="champ">
                            <label for="motif">Motif (facultatif)</label>
                            <input type="text" id="motif" name="motif" maxlength="255" placeholder="ex. : sanction, arrêt maladie">
                        </div>
                    </div>
                    <div class="actions-ligne"><button class="bouton danger">Suspendre le compte</button></div>
                </form>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
