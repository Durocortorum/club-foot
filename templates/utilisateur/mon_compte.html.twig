{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Mon compte{% endblock %}

{% block body %}
    <h1>Mon compte</h1>

    {% include 'commun/_notifications.html.twig' with {texte: moi.famille ? null : 'Recevez une alerte quand une famille ou un collègue vous répond, même application fermée.'} %}

    <div class="grille-fiches">
        <section class="carte">
            <h2>Mes informations</h2>
            <dl>
                <dt>Nom</dt><dd>{{ moi.prenom }} {{ moi.nom }}</dd>
                <dt>Adresse e-mail</dt><dd>{{ moi.email }}</dd>
                {% if moi.famille %}
                    <dt>Joueurs suivis</dt><dd>{{ moi.joueurs|map(j => j.prenom ~ ' ' ~ j.nom)|join(', ') ?: 'aucun' }}</dd>
                {% else %}
                    <dt>Droits</dt><dd>{{ moi.admin ? 'Administration (tous les droits)' : (moi.libellesRoles|join(', ') ?: 'aucun') }}</dd>
                    {% if secteurs_responsable %}
                        <dt>Responsabilités</dt>
                        <dd>{% for s in secteurs_responsable %}<div><span class="pastille responsable">Responsable secteur {{ s }}</span></div>{% endfor %}</dd>
                    {% endif %}
                {% endif %}
            </dl>
            <p class="discret petit">{{ moi.famille ? 'Pour changer d\'adresse ou supprimer votre compte, adressez-vous à l\'éducateur de l\'équipe.' : 'Pour changer vos droits, adressez-vous à un administrateur.' }}</p>
            {% if not moi.famille and not (moi.admin or moi.medecin) %}
                <p><a class="bouton" href="{{ path('app_demande_medicale') }}">🔒 Demander l'accès médical</a></p>
            {% endif %}
        </section>

        {% if encadrement %}
            {# Fiche Encadrement du compte (même adresse e-mail, ou même prénom et nom) : coordonnées mises à jour par la personne. #}
            <section class="carte">
                <h2>Ma fiche</h2>
                {% for f in fiches %}
                    <div class="identite">
                        {{ m.avatar(f.fiche) }}
                        <div>
                            <strong>{{ f.fiche.prenom }} {{ f.fiche.nom }}</strong> <span class="pastille">{{ f.libelle|lower }}</span>
                            <div class="discret petit">{{ [f.fiche.telPortable1 ?? f.fiche.telFixe, f.fiche.email]|filter(v => v)|join(' · ') ?: 'Aucune coordonnée' }}</div>
                        </div>
                    </div>
                    <p class="actions-ligne">
                        <a class="bouton principal petit" href="{{ path('app_ma_fiche', {type: f.type}) }}">Mettre à jour mes coordonnées</a>
                        <a class="bouton petit" href="{{ path('app_intervenant_voir', {type: f.type, id: f.fiche.id}) }}">Voir ma fiche</a>
                    </p>
                {% else %}
                    <p class="discret">Aucune fiche à votre nom dans l'Encadrement (ni avec votre adresse e-mail, ni à vos prénom et nom). Demandez à l'administrateur de la créer.</p>
                {% endfor %}
            </section>
        {% endif %}

        {# Choix des e-mails reçus : la notification et l'espace restent ; mot de passe, invitation, code médical partent toujours. #}
        {% set choix = moi.famille ? constant('App\\Entity\\Utilisateur::EMAILS_AU_CHOIX') : constant('App\\Entity\\Utilisateur::EMAILS_AU_CHOIX')|filter((v, k) => k == 'messages') %}
        <section class="carte" id="mes-emails">
            <h2>Mes e-mails</h2>
            <p class="discret petit">Cochez les e-mails que vous voulez recevoir à {{ moi.email }}. Décochés : l'information reste visible dans l'application{{ moi.famille ? ' (votre espace)' }} et la notification sur le téléphone part quand même.</p>
            <form method="post" class="formulaire">
                <input type="hidden" name="_token" value="{{ csrf_token('mes-emails') }}">
                <input type="hidden" name="emails_choix" value="1">
                {% for cle, libelle in choix %}
                    <label class="case-joueur"><input type="checkbox" name="emails[]" value="{{ cle }}" {{ moi.recoitEmail(cle) ? 'checked' }}> {{ libelle }}</label>
                {% endfor %}
                <p class="discret petit">Les e-mails de votre compte (mot de passe oublié, lien d'activation{{ moi.famille ? '' : ', code d\'accès médical' }}) partent toujours.</p>
                <button type="submit" class="bouton principal">Enregistrer mes choix</button>
            </form>
        </section>

        <section class="carte">
            <h2>Changer mon mot de passe</h2>
            {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'formulaire'}}) }}
                {{ form_errors(form) }}
                <div class="champ">{{ form_label(form.actuel) }}{{ form_widget(form.actuel) }}{{ form_errors(form.actuel) }}</div>
                <div class="champ">{{ form_label(form.nouveau.first) }}{{ form_widget(form.nouveau.first) }}{{ form_help(form.nouveau.first) }}{{ form_errors(form.nouveau.first) }}</div>
                <div class="champ">{{ form_label(form.nouveau.second) }}{{ form_widget(form.nouveau.second) }}{{ form_errors(form.nouveau.second) }}</div>
                {{ form_errors(form.nouveau) }}
                {{ form_rest(form) }}
                <button type="submit" class="bouton principal">Changer le mot de passe</button>
            {{ form_end(form) }}
        </section>
    </div>

    {% if mes_equipes %}
        {# Équipes dont la personne s'occupe : raccourcis vers son travail (prochain match, convocation, présences, planning). #}
        <section class="bloc">
            <h2 class="titre-bloc">Mes équipes</h2>
            <div class="grille-fiches">
                {% for e in mes_equipes %}
                    {% set c = e.categorie %}
                    {% set p = e.prochain %}
                    {% set voit_matchs = secteurs_matchs is null or c.secteur in secteurs_matchs %}
                    <section class="carte mon-equipe">
                        <h3>{{ c.nom }} <span class="discret petit">{{ c.secteurLibelle }}</span></h3>
                        <p>{% for r in e.roles %}<span class="pastille {{ r starts with 'Responsable secteur' ? 'responsable' }}">{{ r }}</span> {% endfor %}</p>
                        <p class="petit">
                            {% if p %}
                                {{ p.plateau ? 'Prochain plateau' : 'Prochain match' }} : {% if voit_matchs %}<a href="{{ path('app_rencontre_voir', {id: p.id}) }}">{% endif %}{{ p.date|date('d/m/Y') }}{{ p.heure ? ' à ' ~ p.heure }} · {% if not p.plateau %}{{ p.aDomicile ? 'vs' : '@' }} {% endif %}{{ p.adversaire }}{% if voit_matchs %}</a>{% endif %}
                            {% else %}
                                <span class="discret">Pas de match prévu</span>
                            {% endif %}
                        </p>
                        <p class="actions-ligne">
                            {% if p and is_granted('MATCH_MODIFIER', p) %}
                                <a class="bouton petit principal" href="{{ path('app_convocation', {id: p.id}) }}">Convocation</a>
                                <a class="bouton petit" href="{{ path('app_rencontre_modifier', {id: p.id}) }}#feuille-de-match">Feuille de match</a>
                            {% endif %}
                            {% if voit_matchs %}<a class="bouton petit" href="{{ path('app_rencontre_index', {categorie: c.id}) }}">Matchs</a>{% endif %}
                            {% if c.secteur in secteurs_vus %}
                                <a class="bouton petit" href="{{ path('app_presence_index', {categorie: c.id}) }}">Présences</a>
                                <a class="bouton petit" href="{{ path('app_planning', {categorie: c.id}) }}">Entraînements</a>
                            {% endif %}
                        </p>
                    </section>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
