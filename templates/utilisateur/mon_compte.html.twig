{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Mon compte{% endblock %}

{% block body %}
    <h1>Mon compte</h1>

    {% include 'commun/_notifications.html.twig' with {texte: moi.famille ? null : 'Recevez une alerte quand une famille ou un collègue vous répond, même application fermée.'} %}

    <div class="grille-fiches">
        <section class="carte">
            <h2>Mes informations</h2>
            <dl>
                <dt>Nom</dt><dd>{{ moi.prenom }} {{ moi.nom }}</dd>
                <dt>Adresse e-mail</dt><dd>{{ moi.email }}</dd>
                {% if moi.famille %}
                    <dt>Joueurs suivis</dt><dd>{{ moi.joueurs|map(j => j.prenom ~ ' ' ~ j.nom)|join(', ') ?: 'aucun' }}</dd>
                {% else %}
                    <dt>Droits</dt><dd>{{ moi.admin ? 'Administration (tous les droits)' : (moi.libellesRoles|join(', ') ?: 'aucun') }}</dd>
                {% endif %}
            </dl>
            <p class="discret petit">{{ moi.famille ? 'Pour changer d\'adresse ou supprimer votre compte, adressez-vous à l\'éducateur de l\'équipe.' : 'Pour changer vos droits, adressez-vous à un administrateur.' }}</p>
            {% if not moi.famille and not (moi.admin or moi.medecin) %}
                <p><a class="bouton" href="{{ path('app_demande_medicale') }}">🔒 Demander l'accès médical</a></p>
            {% endif %}
        </section>

        <section class="carte">
            <h2>Changer mon mot de passe</h2>
            {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'formulaire'}}) }}
                {{ form_errors(form) }}
                <div class="champ">{{ form_label(form.actuel) }}{{ form_widget(form.actuel) }}{{ form_errors(form.actuel) }}</div>
                <div class="champ">{{ form_label(form.nouveau.first) }}{{ form_widget(form.nouveau.first) }}{{ form_help(form.nouveau.first) }}{{ form_errors(form.nouveau.first) }}</div>
                <div class="champ">{{ form_label(form.nouveau.second) }}{{ form_widget(form.nouveau.second) }}{{ form_errors(form.nouveau.second) }}</div>
                {{ form_errors(form.nouveau) }}
                {{ form_rest(form) }}
                <button type="submit" class="bouton principal">Changer le mot de passe</button>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
