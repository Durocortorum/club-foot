{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Présences{% endblock %}

{% block body %}
    <div class="titre-page">
        <h1>Présences{% set nom_equipe = filtres.categorie ? (categories|filter(c => c.id == filtres.categorie)|first).nom ?? null : null %}{% if nom_equipe %} <span class="equipe-titre">{{ nom_equipe }}</span>{% endif %} <span class="compteur">{{ total }} {{ accord(total, 'semaine') }}</span></h1>
        {% if peut_creer %}
            <span class="actions">
                <a class="bouton doublon-barre" href="{{ path('app_planning') }}">Planning et absences</a>
                <a class="bouton principal" href="{{ path('app_presence_nouvelle') }}">+ Nouvelle semaine</a>
            </span>
        {% endif %}
    </div>

    <form class="filtres" method="get">
        <select name="saison" onchange="this.form.requestSubmit()">
            <option value="">Toutes les saisons</option>
            {% for s in saisons %}
                <option value="{{ s }}" {{ filtres.saison == s ? 'selected' }}>Saison {{ s }}</option>
            {% endfor %}
        </select>
        <select name="categorie" onchange="this.form.requestSubmit()">
            <option value="">Toutes les catégories</option>
            {% for c in categories %}
                <option value="{{ c.id }}" {{ filtres.categorie == c.id ? 'selected' }}>{{ c.nom }}</option>
            {% endfor %}
        </select>
        <noscript><button type="submit" class="bouton">Filtrer</button></noscript>
    </form>

    <div class="table-defile">
        <table class="liste liste-fiches">
            <thead><tr><th>Semaine</th><th>Équipe</th><th>Joueurs</th></tr></thead>
            <tbody>
                {% for s in semaines %}
                    <tr>
                        <td class="principal"><a href="{{ path('app_presence_voir', {id: s.id}) }}">du {{ s.lundi|date('d/m/Y') }} au {{ s.samedi|date('d/m/Y') }}</a></td>
                        <td class="fort">{{ s.equipeAffichee }}</td>
                        <td data-label="joueurs">{{ s.presences|length }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="vide">Aucune semaine pour ces critères.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {{ m.pagination('app_presence_index', filtres|merge({saison: filtres.saison ?? ''}), page, pages) }}
{% endblock %}

{% block barre_bas %}{{ include('presence/_barre_bas.html.twig') }}{% endblock %}
