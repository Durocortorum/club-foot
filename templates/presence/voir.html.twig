{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Présences {{ semaine.equipeAffichee }}{% endblock %}

{% block body %}
    {% set equipe = semaine.equipeAffichee %}
    <p class="lien-retour"><a href="{{ path('app_presence_index') }}">← Présences</a></p>

    <div class="titre-page">
        <div>
            <h1>{{ equipe }}</h1>
            <p class="discret">Semaine du {{ semaine.lundi|date('d/m/Y') }} au {{ semaine.samedi|date('d/m/Y') }}</p>
        </div>
        <div class="actions">
            {{ m.supprimer(path('app_presence_supprimer', {id: semaine.id}), 'supprimer-semaine' ~ semaine.id, 'Supprimer cette semaine et toutes ses présences ?', 'Supprimer la semaine') }}
        </div>
    </div>

    <p class="discret petit">
        Pour chaque demi-journée : l'équipe avec laquelle le joueur s'est entraîné, ou le motif d'absence.
        Laissez vide s'il n'y avait pas de séance. Notez aussi la semaine de chaque joueur (note sur 10) : la forme en découle toute seule (7,5 et plus 🔥, 6 🙂, 5 😐, moins 😟) ; elles apparaissent dans la convocation et dans « Composer le onze ». Le bouton ✓ sous un créneau marque présents tous les joueurs encore vides ; un second clic le décoche et vide les présents de la colonne (les absences restent).
    </p>

    <form method="post" data-controller="presence" data-presence-equipe-value="{{ equipe }}" data-presence-seuils-value="{{ seuils_forme|json_encode }}" data-presence-formes-value="{{ formes|json_encode }}">
        <input type="hidden" name="_token" value="{{ csrf_token('presences' ~ semaine.id) }}">
        {# Seules les demi-journées d'entraînement de l'équipe sont affichées ; les autres sur demande (séance en plus). #}
        {% set caches = creneaux|length - creneaux_entrainement|length %}
        {% if caches %}
            <p class="petit">Séances de l'équipe seulement ({{ creneaux_entrainement|map(c => creneaux[c])|join(', ') }}).
                <button type="button" class="lien-bouton" data-action="presence#toutAfficher" data-presence-target="bascule">Afficher les {{ caches }} autres demi-journées</button></p>
        {% endif %}
        <div class="table-defile">
            <table class="liste grille-presence" data-presence-target="grille">
                <thead>
                    <tr>
                        <th>Joueur</th>
                        <th class="col-semaine" title="Note de la semaine d'entraînement, sur 10 (avant les convocations)">Note<br><span class="discret">semaine</span></th>
                        <th class="col-semaine" title="Forme de la semaine d'entraînement">Forme</th>
                        {% for cle, libelle in creneaux %}
                            <th title="{{ libelle }}" class="{{ cle not in creneaux_entrainement ? 'creneau-cache' }}">{{ libelle|split(' ')|first|slice(0, 3) }}<br><span class="discret">{{ 'matin' in libelle ? 'mat.' : 'a-m' }}</span></th>
                        {% endfor %}
                        <th>Présent</th>
                        <th></th>
                    </tr>
                    <tr class="remplir">
                        <th></th><th class="col-semaine"></th><th class="col-semaine"></th>
                        {% for cle, libelle in creneaux %}
                            <th class="{{ cle not in creneaux_entrainement ? 'creneau-cache' }}"><button type="button" class="bouton petit coche-creneau" data-action="presence#remplir" data-presence-creneau-param="{{ cle }}" data-libelle="{{ libelle }}" aria-pressed="false" title="Cocher : tous présents – {{ libelle }}">✓</button></th>
                        {% endfor %}
                        <th></th><th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in presences %}
                        {% set j = p.joueur %}
                        {% set present = p.creneaux|filter(v => v not in motifs|keys and v not in motifs_anciens|keys)|length %}
                        <tr>
                            <td class="avec-vignette nowrap">{{ m.avatar(j, 'mini') }} <a href="{{ path('app_joueur_voir', {id: j.id}) }}"><strong>{{ j.nom }}</strong> {{ j.prenom }}</a></td>
                            <td class="col-semaine"><input type="number" class="note-semaine" name="note[{{ j.id }}]" min="0" max="10" step="0.5" value="{{ p.noteSemaine }}" aria-label="Note de la semaine de {{ j.prenom }} {{ j.nom }}" placeholder="/10" data-action="input->presence#formeDeLaNote"></td>
                            <td class="col-semaine">
                                {# Forme : calculée d'après la note (rien à choisir), mise à jour pendant la saisie. #}
                                {% set f = formes[p.forme] ?? null %}
                                <span class="forme-auto {{ p.forme }}" data-forme-auto aria-live="polite">{{ f ? f[1] ~ ' ' ~ f[0] : '—' }}</span>
                            </td>
                            {% for cle, libelle in creneaux %}
                                {% set valeur = p.creneau(cle) %}
                                <td class="{{ cle not in creneaux_entrainement ? 'creneau-cache' }}">
                                    <select name="creneaux[{{ j.id }}][{{ cle }}]" data-creneau="{{ cle }}" title="{{ libelle }}"
                                            class="creneau {{ valeur is null ? 'vide' : (valeur in motifs|keys or valeur in motifs_anciens|keys ? 'absence' : 'present') }}">
                                        <option value=""></option>
                                        <option value="{{ equipe }}" {{ valeur == equipe ? 'selected' }}>✓ {{ equipe }}</option>
                                        <optgroup label="Absence">
                                            {% for code, motif in motifs %}
                                                <option value="{{ code }}" {{ valeur == code ? 'selected' }}>{{ motif }}</option>
                                            {% endfor %}
                                            {% for code, motif in motifs_anciens|filter((m, code) => code == valeur) %}
                                                <option value="{{ code }}" selected>{{ motif }}</option>
                                            {% endfor %}
                                        </optgroup>
                                        <optgroup label="Avec une autre équipe">
                                            {% for e in equipes|filter(e => e != equipe) %}
                                                <option value="{{ e }}" {{ valeur == e ? 'selected' }}>{{ e }}</option>
                                            {% endfor %}
                                            {% if valeur and valeur != equipe and valeur not in motifs|keys and valeur not in motifs_anciens|keys and valeur not in equipes %}
                                                <option value="{{ valeur }}" selected>{{ valeur }}</option>
                                            {% endif %}
                                        </optgroup>
                                    </select>
                                </td>
                            {% endfor %}
                            <td class="nowrap">
                                {{ present }} / {{ p.creneaux|length }}
                                {% if p.creneaux|length %}<span class="pourcentage">{{ (present * 100 / p.creneaux|length)|round }} %</span>{% endif %}
                            </td>
                            <td>
                                <button type="submit" form="retirer-{{ p.id }}" class="bouton danger petit" title="Retirer {{ j.prenom }} {{ j.nom }} de cette semaine">×</button>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="16" class="vide">Aucun joueur dans cette semaine.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="barre-actions">
            <button type="submit" class="bouton principal">Enregistrer les présences</button>
            {% if a_ajouter %}
                <select name="ajouter" class="ajout">
                    <option value="">Ajouter un joueur de la catégorie…</option>
                    {% for j in a_ajouter %}<option value="{{ j.id }}">{{ j.nom }} {{ j.prenom }}</option>{% endfor %}
                </select>
            {% endif %}
        </div>
    </form>

    {% for p in presences %}
        <form id="retirer-{{ p.id }}" method="post" action="{{ path('app_presence_retirer', {id: semaine.id, presence: p.id}) }}"
              data-confirmation="Retirer {{ p.joueur.nomComplet }} de cette semaine ? Les présences non enregistrées seront perdues." data-confirmation-bouton="Retirer">
            <input type="hidden" name="_token" value="{{ csrf_token('retirer' ~ p.id) }}">
        </form>
    {% endfor %}
{% endblock %}
