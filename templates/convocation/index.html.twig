{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Convocation · {{ rencontre }}{% endblock %}

{% block body %}
    {% set jours = constant('App\\Service\\EnvoiConvocations::JOURS') %}
    <p><a href="{{ path('app_rencontre_voir', {id: rencontre.id}) }}">← Retour au match</a></p>

    <div class="titre-page">
        <div>
            <p class="discret">{{ rencontre.equipeAffichee }} · {{ jours[rencontre.date|date('w')] }} {{ rencontre.date|date('d/m/Y') }}{% if rencontre.heure %} à {{ rencontre.heure }}{% endif %}</p>
            <h1>Convocation · {{ rencontre.domicile }} – {{ rencontre.exterieur }}</h1>
        </div>
        {% if convocation %}
            <div class="actions">
                <a class="bouton" href="{{ path('app_message_nouveau', {rencontre: rencontre.id}) }}" title="Message aux familles des convoqués (tous, présents, sans réponse...)">Écrire aux convoqués</a>
                {{ m.supprimer(path('app_convocation_supprimer', {id: rencontre.id}), 'supprimer-convocation' ~ convocation.id, 'Supprimer la convocation et les réponses des familles ? Les convoqués encore vierges sur la feuille de match (sans numéro, poste, note…) en seront aussi retirés. Les familles ne sont pas prévenues.') }}
            </div>
        {% endif %}
    </div>

    {% if convocation %}
        {% set presents = convocation.parReponse('present') %}
        {% set absents = convocation.parReponse('absent') %}
        {% set attente = convocation.parReponse(null) %}
    {% endif %}

    {# Déplacement (module Transport), en premier : repris dans la convocation envoyée,
       le message du groupe et l'espace famille. #}
    {% if rencontre.deplacements is not empty or not rencontre.aDomicile %}
        <section class="carte bloc" id="deplacement">
            <h2 class="titre-leger">Déplacement</h2>
            {% if rencontre.deplacements is not empty %}
                <ul class="liste-simple">
                    {% for d in rencontre.deplacements %}
                        <li class="avec-actions">
                            <span>🚌 {{ d.resumeFamilles }}{% if d.passagers %} <span class="discret petit">· {{ d.passagers }} passager{{ d.passagers > 1 ? 's' }}</span>{% endif %}</span>
                            <a class="petit" href="{{ path('app_transport_modifier', {id: d.id}) }}">Modifier</a>
                        </li>
                    {% endfor %}
                </ul>
                <p class="discret petit">Affiché aux familles dans la convocation (e-mail, message du groupe, espace famille).</p>
            {% else %}
                <p class="discret">Aucun déplacement noté pour ce match à l'extérieur.</p>
            {% endif %}
            <a class="bouton petit" href="{{ path('app_transport_nouveau', {match: rencontre.id}) }}">+ {{ rencontre.deplacements is empty ? 'Noter le déplacement' : 'Ajouter un véhicule' }}</a>
        </section>
    {% endif %}

    <section class="bloc">
        {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'formulaire'}}) }}
            {{ form_errors(form) }}
            <fieldset class="carte">
                <legend>Rendez-vous</legend>
                {{ m.groupe(form, ['rdvHeure', 'rdvLieu', 'message']) }}
            </fieldset>

            <fieldset class="carte" id="joueurs-convoques">
                <legend>Joueurs convoqués</legend>
                {# Jeunes joueurs appelés (surclassement) : 1, 2, 3 niveaux en dessous, ou tous. #}
                <nav class="niveaux-dessous petit" aria-label="Niveaux en dessous proposés">
                    <span class="discret">Niveaux en dessous :</span>
                    {% for n, libelle in {1: '1', 2: '2', 3: '3', 0: 'tous'} %}
                        <a class="bouton petit {{ n == niveaux_dessous ? 'principal' }}" href="{{ path('app_convocation', n == 1 ? {id: rencontre.id} : {id: rencontre.id, dessous: n}) }}#joueurs-convoques" {{ n == niveaux_dessous ? 'aria-current="true"' }}>{{ libelle }}</a>
                    {% endfor %}
                </nav>
                {% if niveaux_vides %}
                    <p class="discret petit">Aucun joueur actif : {{ niveaux_vides|join(' ; ') }}.</p>
                {% endif %}
                {{ form_errors(form.joueurs) }}
                {% for groupe, choix in form.joueurs.vars.choices %}
                    {# Groupe ouvert : celui du match, ou un groupe où des joueurs sont déjà convoqués. #}
                    {% set coches = choix.choices|filter(c => form.joueurs[c.value].vars.checked)|length %}
                    <details class="groupe-joueurs" {{ loop.first or coches ? 'open' }}>
                        <summary>{{ groupe }} <span class="discret petit">({{ choix.choices|length }}{{ coches and not loop.first ? ', ' ~ coches ~ ' ' ~ accord(coches, 'convoqué') }})</span></summary>
                        <div class="cases-joueurs">
                            {% for c in choix.choices %}
                                {% set ailleurs = c.attr['data-ailleurs'] ?? null %}
                                <label class="case-joueur {{ ailleurs and c.attr.disabled is defined ? 'indisponible' }}" {% if ailleurs %}title="Déjà convoqué(e) avec {{ ailleurs }}"{% endif %}>
                                    {{ form_widget(form.joueurs[c.value]) }} {{ c.label }}
                                    {% if ailleurs %}<span class="pastille alerte petit">avec {{ ailleurs }}</span>{% endif %}
                                </label>
                            {% endfor %}
                        </div>
                    </details>
                {% endfor %}
                {% do form.joueurs.setRendered %}
            </fieldset>
            {{ form_rest(form) }}
            {# Envoi aux parents : à tous la première fois ; ensuite seulement aux joueurs ajoutés (par exemple pour
               remplacer des absents), ceux déjà prévenus ne reçoivent rien de plus. #}
            {% set deja_envoyee = convocation and convocation.envoyeeLe %}
            <div class="barre-actions">
                <button type="submit" name="suite" value="envoyer" class="bouton principal"
                        data-confirmation="{{ deja_envoyee ? 'Enregistrer, puis envoyer la convocation aux parents des joueurs ajoutés ? Ceux déjà prévenus ne reçoivent rien de plus.' : 'Enregistrer, puis envoyer la convocation aux parents des joueurs cochés ?' }}"
                        data-confirmation-bouton="Envoyer">
                    {{ deja_envoyee ? 'Enregistrer et envoyer aux joueurs ajoutés' : 'Enregistrer et envoyer aux parents' }}
                </button>
                <button type="submit" class="bouton">Enregistrer sans envoyer</button>
            </div>
            <p class="discret petit">
                {% if deja_envoyee %}Des absents ? Cochez d'autres joueurs, puis « Enregistrer et envoyer aux joueurs ajoutés » : seuls leurs parents reçoivent la convocation.
                {% else %}Les parents reçoivent un e-mail (et un message dans leur espace) pour répondre présent ou absent.{% endif %}
            </p>
        {{ form_end(form) }}
    </section>

    {% if convocation %}
        <section class="bloc" id="reponses">
            <h2 class="titre-bloc">
                Réponses
                <span class="pastille succes">{{ presents|length }} présent{{ presents|length > 1 ? 's' }}</span>
                <span class="pastille alerte">{{ absents|length }} absent{{ absents|length > 1 ? 's' }}</span>
                <span class="pastille">{{ attente|length }} sans réponse</span>
            </h2>
            <div class="table-defile">
                <table class="liste liste-fiches">
                    <thead><tr><th>Joueur</th><th>Prévenir</th><th>Réponse</th><th>Répondu par</th><th>Modifier la réponse</th></tr></thead>
                    <tbody>
                        {% for c in convocation.convoques %}
                            {% set s = sms[c.id] %}
                            <tr>
                                <td class="nowrap principal">
                                    <a href="{{ path('app_joueur_voir', {id: c.joueur.id}) }}"><strong>{{ c.joueur.nom }}</strong> {{ c.joueur.prenom }}</a>
                                    {% if convocation.envoyeeLe and not c.envoyeLe %}<span class="pastille alerte petit" title="Ajouté après l'envoi : bouton « Envoyer aux parents » pour le prévenir">pas encore prévenu</span>{% endif %}
                                    <form method="post" action="{{ path('app_convocation_retirer', {id: rencontre.id, convoque: c.id}) }}" class="en-ligne"
                                          data-confirmation="Retirer {{ c.joueur.prenom }} {{ c.joueur.nom }} de la convocation ?{{ convocation.envoyeeLe ? ' Sa famille sera prévenue (e-mail et messagerie).' }}"
                                          data-confirmation-bouton="Retirer">
                                        <input type="hidden" name="_token" value="{{ csrf_token('retirer-convoque' ~ c.id) }}">
                                        <button class="lien-discret petit" title="Retirer de la convocation">Retirer</button>
                                    </form>
                                </td>
                                <td class="nowrap large">
                                    {% if s.compte %}<span class="pastille succes" title="Reçoit la convocation par e-mail et répond dans son espace">compte famille</span>{% endif %}
                                    {% for qui, numero in s.numeros %}
                                        <a class="bouton petit" href="sms:{{ numero }}?&body={{ s.texte|url_encode }}" title="SMS au {{ qui|lower }} ({{ numero }}) depuis votre téléphone">SMS {{ qui|lower }}</a>
                                    {% else %}
                                        {% if not s.compte %}<span class="pastille alerte">ni compte ni portable</span>{% endif %}
                                    {% endfor %}
                                </td>
                                <td>
                                    {% if c.reponse == 'present' %}<span class="pastille succes">présent</span>
                                    {% elseif c.reponse == 'absent' %}<span class="pastille alerte">absent</span>{% if c.motif %} <span class="petit">{{ c.motif }}</span>{% endif %}
                                    {% else %}<span class="pastille">sans réponse</span>{% endif %}
                                </td>
                                <td class="petit discret">{% if c.reponduLe %}{{ c.reponduPar }}, le {{ c.reponduLe|date('d/m à H:i') }}{% endif %}</td>
                                <td class="large">
                                    {# Rattachés au formulaire unique sous le tableau (« Enregistrer toutes les réponses »). #}
                                    <span class="reponse-convoque">
                                        <select name="reponse[{{ c.id }}]" form="toutes-reponses" aria-label="Réponse pour {{ c.joueur.prenom }}">
                                            <option value="">Sans réponse</option>
                                            <option value="present" {{ c.reponse == 'present' ? 'selected' }}>Présent</option>
                                            <option value="absent" {{ c.reponse == 'absent' ? 'selected' }}>Absent</option>
                                        </select>
                                        <input type="text" name="motif[{{ c.id }}]" form="toutes-reponses" value="{{ c.motif }}" placeholder="Motif d'absence" list="motifs-absence" maxlength="120">
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <form method="post" action="{{ path('app_convocation_reponses', {id: rencontre.id}) }}" id="toutes-reponses" class="actions-ligne">
                <input type="hidden" name="_token" value="{{ csrf_token('reponses-convocation' ~ rencontre.id) }}">
                <button type="submit" class="bouton principal">Enregistrer toutes les réponses</button>
                {% if attente|length %}
                    <button type="submit" name="action" value="tous_presents" class="bouton"
                            data-confirmation="Noter présents les {{ attente|length }} joueur{{ attente|length > 1 ? 's' }} sans réponse ?" data-confirmation-bouton="Tous présents">
                        Tous les sans-réponse : présents ({{ attente|length }})
                    </button>
                {% endif %}
            </form>
            <datalist id="motifs-absence">{% for mo in motifs %}<option value="{{ mo }}">{% endfor %}</datalist>

            {# Un joueur malade, blessé ou empêché d'ici le match : un autre est convoqué à sa place (ses parents prévenus). #}
            <form method="post" action="{{ path('app_convocation_remplacer', {id: rencontre.id}) }}" class="carte remplacer-joueur">
                <h3>Remplacer un joueur</h3>
                <input type="hidden" name="_token" value="{{ csrf_token('remplacer' ~ convocation.id) }}">
                <div class="champs">
                    <div class="champ">
                        <label for="remplace">Joueur empêché</label>
                        <select id="remplace" name="remplace">
                            <option value="">— Aucun (ajouter seulement) —</option>
                            {% for c in convocation.convoques %}
                                <option value="{{ c.id }}">{{ c.joueur.nom }} {{ c.joueur.prenom }}{{ c.reponse == 'absent' ? ' (absent)' }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="champ">
                        <label for="motif-remplacement">Motif</label>
                        <input type="text" id="motif-remplacement" name="motif" list="motifs-absence" placeholder="Malade, blessé…" maxlength="120">
                    </div>
                    <div class="champ">
                        <label for="remplacant">Joueur convoqué à sa place</label>
                        <select id="remplacant" name="joueur" required>
                            <option value="">— Choisir —</option>
                            {% for groupe, liste in remplacants %}
                                <optgroup label="{{ groupe }}">
                                    {% for j in liste %}<option value="{{ j.id }}">{{ j.nom }} {{ j.prenom }}</option>{% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <button type="submit" class="bouton principal">{{ convocation.envoyeeLe ? 'Convoquer et prévenir ses parents' : 'Convoquer' }}</button>
                <p class="discret petit">Le joueur empêché est noté absent (avec le motif) ; le remplaçant est ajouté à la convocation{{ convocation.envoyeeLe ? ' et ses parents la reçoivent aussitôt' }}.</p>
            </form>
        </section>
    {% endif %}

    {# Envoi aux familles et message pour le groupe, tout en bas. #}
    {% if convocation %}
        <div class="grille-fiches">
            <section class="carte">
                <h2>Envoi</h2>
                {% if convocation.envoyeeLe %}
                    <p>Envoyée aux familles le {{ convocation.envoyeeLe|date('d/m/Y à H:i') }}.</p>
                {% else %}
                    <p><span class="pastille alerte">pas encore envoyée</span> Les familles ne voient la convocation qu'une fois envoyée.</p>
                {% endif %}
                <div class="actions-ligne">
                    {# Après le premier envoi : la convocation définitive (groupe fixé), à tous les convoqués sauf les absents. #}
                    <form method="post" action="{{ path('app_convocation_envoyer', {id: rencontre.id}) }}" class="en-ligne"
                          {% if convocation.envoyeeLe %}data-confirmation="Envoyer la convocation définitive aux parents de tous les convoqués (sauf les absents) ?" data-confirmation-bouton="Envoyer"{% endif %}>
                        <input type="hidden" name="_token" value="{{ csrf_token('envoyer-convocation' ~ convocation.id) }}">
                        {% if convocation.envoyeeLe %}
                            <input type="hidden" name="definitive" value="1">
                            <button class="bouton principal bouton-definitive">📣 Envoyer la convocation définitive</button>
                        {% else %}
                            <button class="bouton principal">Envoyer aux parents</button>
                        {% endif %}
                    </form>
                    {% set pas_prevenus = convocation.convoques|filter(c => not c.envoyeLe)|length %}
                    {% if convocation.envoyeeLe and pas_prevenus %}
                        <form method="post" action="{{ path('app_convocation_envoyer', {id: rencontre.id}) }}" class="en-ligne">
                            <input type="hidden" name="_token" value="{{ csrf_token('envoyer-convocation' ~ convocation.id) }}">
                            <input type="hidden" name="nouveaux" value="1">
                            <button class="bouton principal">Envoyer aux {{ pas_prevenus }} joueur{{ pas_prevenus > 1 ? 's' }} ajouté{{ pas_prevenus > 1 ? 's' }}</button>
                        </form>
                    {% endif %}
                    {% if convocation.envoyeeLe and attente %}
                        <form method="post" action="{{ path('app_convocation_envoyer', {id: rencontre.id}) }}" class="en-ligne">
                            <input type="hidden" name="_token" value="{{ csrf_token('envoyer-convocation' ~ convocation.id) }}">
                            <input type="hidden" name="relance" value="1">
                            <button class="bouton">{{ attente|length > 1 ? 'Relancer les ' ~ attente|length ~ ' joueurs sans réponse' : 'Relancer le joueur sans réponse' }}</button>
                        </form>
                    {% endif %}
                </div>
                <p class="discret petit">
                    {% if convocation.envoyeeLe %}<b>Convocation définitive</b> : quand le groupe est fixé (réponses reçues, absents remplacés), elle part à tous les convoqués sauf les absents.<br>{% endif %}
                    Un e-mail part vers chaque compte famille actif. Pour les autres : message du groupe ci-contre, ou boutons « SMS » du tableau des réponses au-dessus (depuis un téléphone, le SMS s'ouvre tout prêt).
                </p>
            </section>

            <section class="carte" data-controller="copier" data-copier-texte-value="{{ message_groupe }}">
                <h2>Message pour le groupe</h2>
                <p class="memo petit">{{ message_groupe }}</p>
                <div class="actions-ligne">
                    <button type="button" class="bouton petit" data-action="copier#copier" data-copier-target="bouton">Copier le message</button>
                    <a class="bouton petit" href="https://wa.me/?text={{ message_groupe|url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
                </div>
            </section>
        </div>
    {% endif %}
{% endblock %}
