{% extends 'base.html.twig' %}

{% block body %}
    <h1>Bonjour {{ app.user.prenom }}</h1>

    {% if etapes_faites < etapes|length %}
        <section class="carte premiers-pas">
            <div class="premiers-pas-entete">
                <h2>Premiers pas</h2>
                <span class="discret petit">{{ etapes_faites }} sur {{ etapes|length }}</span>
                <span class="jauge large"><span style="width: {{ (100 * etapes_faites / etapes|length)|round }}%"></span></span>
            </div>
            <ol class="etapes">
                {% for e in etapes %}
                    <li class="{{ e.fait ? 'faite' }}">
                        <span class="etape-coche" aria-hidden="true">{{ e.fait ? '✓' : loop.index }}</span>
                        <span class="etape-texte"><strong>{{ e.titre }}</strong><br><span class="discret petit">{{ e.texte }}</span></span>
                        <a class="bouton petit {{ e.fait ? '' : 'principal' }}" href="{{ e.lien }}">{{ e.fait ? 'Voir' : e.action }}</a>
                    </li>
                {% endfor %}
            </ol>
        </section>
    {% endif %}

    {% import 'tache/_boutons.html.twig' as b %}
    {% if mes_taches %}
        <section class="carte mes-taches">
            <div class="premiers-pas-entete">
                <h2>Mes tâches</h2>
                <a class="discret petit" href="{{ path('app_tache_index') }}">{{ nb_taches > mes_taches|length ? 'les ' ~ nb_taches ~ ' tâches' : 'tout voir' }} →</a>
            </div>
            <ul class="liste-taches">
                {% for t in mes_taches %}
                    <li>
                        <span><a href="{{ path('app_tache_voir', {id: t.id}) }}"><strong>{{ t.objet }}</strong></a>
                            <span class="discret petit">{{ t.categorie ? t.categorie.nom : 'Tout le club' }}{% if t.echeance %} · pour le {{ t.echeance|date('d/m') }}{% endif %}</span>
                            {{ b.pastilles(t) }}</span>
                        <span>{{ b.statut(t, path('app_accueil')) }}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if taches_club %}
        <section class="carte mes-taches taches-club">
            <div class="premiers-pas-entete">
                <h2>Tâches en cours du club</h2>
                <a class="discret petit" href="{{ path('app_tache_index', {vue: 'toutes'}) }}">{{ nb_taches_club > taches_club|length ? 'les ' ~ nb_taches_club ~ ' tâches' : 'tout voir' }} →</a>
            </div>
            <ul class="liste-taches">
                {% for t in taches_club %}
                    <li>
                        <span><a href="{{ path('app_tache_voir', {id: t.id}) }}"><strong>{{ t.objet }}</strong></a>
                            <span class="discret petit">{{ t.chargeDe }} · {{ t.categorie ? t.categorie.nom : 'Tout le club' }}{% if t.echeance %} · pour le {{ t.echeance|date('d/m') }}{% endif %}</span>
                            {{ b.pastilles(t) }}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <p class="discret">Joueurs actifs par catégorie, pour les secteurs auxquels vous avez accès.</p>
    {% for secteur, categories in secteurs %}
        <section class="secteur">
            <h2>{{ libelles[secteur].libelle }}</h2>
            <div class="tuiles">
                {% for c in categories %}
                    <a class="tuile equipe" href="{{ path('app_joueur_index', {categorie: c.id}) }}">
                        <span class="equipe-niveau">{{ c.nom }}</span>
                        <span class="equipe-effectif">{{ c.total }} joueur{{ c.total > 1 ? 's' }}</span>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% else %}
        <p>Votre compte n'a accès à aucun secteur. Demandez à un administrateur de vous attribuer des droits.</p>
    {% endfor %}
{% endblock %}
