{% extends 'base.html.twig' %}
{% import 'finances/_macros.html.twig' as f %}

{% block title %}Discipline{% endblock %}

{% block body %}
    {% set modif = is_granted('ROLE_DISCIPLINE') %}

    <div class="titre-page">
        <h1>Discipline <span class="compteur">{{ sanctions|length }}</span></h1>
        {% if modif %}<a class="bouton principal" href="{{ path('app_sanction_nouvelle') }}">+ Nouvel incident</a>{% endif %}
    </div>

    {% if amendes.infligees or amendes.a_payer %}
        <div class="tuiles amendes">
            <div class="tuile"><span class="discret petit">Amendes {{ amendes.saison }}</span><strong>{{ f.euros(amendes.infligees) }}</strong></div>
            <div class="tuile"><span class="discret petit">Encaissées {{ amendes.saison }}</span><strong>{{ f.euros(amendes.encaissees) }}</strong></div>
            <a class="tuile {{ amendes.a_payer ? 'a-payer' }}" href="{{ path('app_discipline_index', filtre ? {} : {amendes: 'a_payer'}) }}">
                <span class="discret petit">Reste à payer</span><strong>{{ f.euros(amendes.a_payer) }}</strong>
                <span class="petit">{{ amendes.nb_a_payer }} amende{{ amendes.nb_a_payer > 1 ? 's' }} · {{ filtre ? 'tout afficher' : 'les voir' }}</span>
            </a>
        </div>
    {% endif %}
    {% if filtre %}<p class="discret petit">Amendes pas encore payées, toutes saisons. <a href="{{ path('app_discipline_index') }}">Tous les incidents</a></p>{% endif %}

    <div class="table-defile">
        <table class="liste liste-fiches">
            <thead><tr><th>Date</th><th>Joueur</th><th>Lieu</th><th>Motif</th><th>Sanction sportive</th><th>Sanction scolaire</th><th>Gravité</th><th>Amende</th><th></th></tr></thead>
            <tbody>
                {% for s in sanctions %}
                    <tr>
                        <td class="nowrap">{{ s.date|date('d/m/Y') }}</td>
                        <td class="nowrap principal etroit"><a href="{{ path('app_joueur_voir', {id: s.joueur.id, _fragment: 'scolarite'}) }}"><strong>{{ s.joueur.nom }}</strong> {{ s.joueur.prenom }}</a> <span class="discret">{{ s.joueur.categorie }}</span></td>
                        <td>{{ s.lieu }}</td>
                        <td class="large fort">{{ s.motif }}</td>
                        <td data-label="sportive :">{{ s.sanctionSportive }}</td>
                        <td data-label="scolaire :">{{ s.sanctionScolaire }}</td>
                        <td data-label="gravité">{{ s.graviteLibelle }}</td>
                        <td data-label="amende :" class="nowrap">
                            {% if s.amende %}
                                {{ f.euros(s.amende) }}
                                {% if s.amendePayeeLe %}
                                    <span class="pastille succes" title="Payée le {{ s.amendePayeeLe|date('d/m/Y') }}">payée</span>
                                {% elseif modif %}
                                    <form method="post" action="{{ path('app_sanction_amende_payee', {id: s.id}) }}" class="en-ligne">
                                        <input type="hidden" name="_token" value="{{ csrf_token('amende-payee' ~ s.id) }}">
                                        <input type="hidden" name="filtre" value="{{ filtre }}">
                                        <button class="bouton petit" title="Noter l'amende payée aujourd'hui">Payée</button>
                                    </form>
                                {% else %}
                                    <span class="pastille alerte">à payer</span>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td class="a-cote">{% if modif %}<a href="{{ path('app_sanction_modifier', {id: s.id}) }}">Modifier</a>{% endif %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="9" class="vide">{{ filtre ? 'Aucune amende à payer.' : 'Aucun incident enregistré.' }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
