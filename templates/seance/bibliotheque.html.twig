{% extends 'base.html.twig' %}

{% block title %}Bibliothèque d'exercices{% endblock %}

{% block body %}
    {% if seance %}
        <p class="lien-retour"><a href="{{ path('app_seance_voir', {id: seance.id}) }}">← {{ seance }}</a></p>
    {% else %}
        <p class="lien-retour"><a href="{{ path('app_seance_index') }}">← Entraînements</a></p>
    {% endif %}
    <div class="titre-page">
        <div>
            <h1>Bibliothèque d'exercices</h1>
            {% if seance %}
                <p class="discret">Choisissez un exercice type : il est copié dans la séance, où vous pourrez modifier le schéma, la durée et les consignes.
                    Pour travailler les coups de pied arrêtés : <a href="{{ path('app_cpa', {seance: seance.id}) }}">🚩 bibliothèque des corners, coups francs et touches</a>.</p>
            {% else %}
                <p class="discret">Tous les exercices types du club. Ajoutez-en un à l'une de vos séances : il y est copié, et vous pourrez ensuite l'adapter.</p>
            {% endif %}
        </div>
    </div>

    {% if not seance %}
        <form class="filtres" method="get">
            <input type="search" name="q" value="{{ filtres.q }}" placeholder="Titre ou consigne">
            <select name="groupe" onchange="this.form.requestSubmit()">
                <option value="">Tous les groupes</option>
                {% for cle, g in tous_groupes %}
                    <option value="{{ cle }}" {{ filtres.groupe == cle ? 'selected' }}>{{ g.libelle }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="bouton">Filtrer</button>
        </form>
    {% endif %}

    {% if groupes|length > 1 %}
        <nav class="sommaire">
            {% for cle, g in groupes %}
                <a href="#groupe-{{ cle }}" class="{{ g.conseille ? 'actif' }}">{{ g.libelle }} ({{ g.exercices|length }})</a>
            {% endfor %}
        </nav>
    {% endif %}

    {% for cle, g in groupes %}
        <section class="bloc" id="groupe-{{ cle }}">
            <h2 class="titre-bloc">{{ g.libelle }}{% if g.conseille and seance %} <span class="pastille">conseillé pour {{ seance.categorie }}</span>{% endif %}</h2>
            <div class="grille-exercices">
                {% for cleExercice, e in g.exercices %}
                    <article class="carte exercice-type">
                        <svg class="schema-terrain" data-controller="schema" data-schema-lecture-value="true" data-schema-schema-value="{{ e.schema|json_encode }}" data-schema-target="svg" role="img" aria-label="Schéma : {{ e.titre }}"></svg>
                        <h3>{{ e.titre }} <span class="pastille">{{ e.duree }} min</span></h3>
                        <details>
                            <summary>Consignes</summary>
                            <p class="memo petit">{{ e.consignes }}</p>
                        </details>
                        {% if seance %}
                            <form method="post" action="{{ path('app_seance_bibliotheque_ajouter', {id: seance.id, cle: cleExercice}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('bibliotheque' ~ seance.id) }}">
                                <button class="bouton principal">+ Ajouter à la séance</button>
                            </form>
                        {% elseif destinations %}
                            <details class="copier">
                                <summary class="bouton principal">+ Ajouter à une séance…</summary>
                                <form method="post" action="{{ path('app_bibliotheque_ajouter', {cle: cleExercice}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('bibliotheque') }}">
                                    <select name="seance" required>
                                        <option value="">Choisir la séance</option>
                                        {% for d in destinations %}
                                            <option value="{{ d.id }}">{{ d }}</option>
                                        {% endfor %}
                                    </select>
                                    <button class="bouton petit">Ajouter</button>
                                </form>
                            </details>
                        {% endif %}
                    </article>
                {% else %}
                    <p class="vide">Aucun exercice{{ filtres.q|default(false) ? ' pour cette recherche' }}.</p>
                {% endfor %}
            </div>
        </section>
    {% endfor %}
{% endblock %}
