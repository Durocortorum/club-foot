{% extends 'base.html.twig' %}
{% import 'commun/_macros.html.twig' as m %}

{% block title %}Entraînements{% endblock %}

{% block body %}
    <div class="titre-page">
        <h1>Entraînements{% set nom_equipe = filtres.categorie ? (categories|filter(c => c.id == filtres.categorie)|first).nom ?? null : null %}{% if nom_equipe %} <span class="equipe-titre">{{ nom_equipe }}</span>{% endif %} <span class="compteur">{{ total }} séance{{ total > 1 ? 's' }}</span></h1>
        <span class="actions">
            <a class="bouton doublon-barre" href="{{ path('app_cpa') }}" title="Bibliothèque de combinaisons de corners, coups francs et touches">🚩 Coups de pied arrêtés</a>
            <a class="bouton doublon-barre" href="{{ path('app_etat_forme') }}" title="État de forme du jour renseigné par les joueurs : fatigue, sommeil, douleurs, motivation">💚 État de forme</a>
            <a class="bouton doublon-barre" href="{{ path('app_ressenti') }}" title="Effort ressenti par les joueurs après chaque séance (RPE)">Effort ressenti</a>
            {% if is_granted('ROLE_TESTS_PHYSIQUES_LECTURE') %}<a class="bouton doublon-barre" href="{{ path('app_tests') }}" title="Catalogue des tests physiques et techniques, séances de tests">Tests</a><a class="bouton doublon-barre" href="{{ path('app_progression_equipe') }}" title="Résultats et progression de chaque joueur">Progression</a>{% endif %}
        {% if peut_creer %}
                <a class="bouton doublon-barre" href="{{ path('app_planning') }}">Planning et absences</a>
                <a class="bouton doublon-barre" href="{{ path('app_bibliotheque') }}">Bibliothèque d'exercices</a>
                <a class="bouton principal" href="{{ path('app_seance_nouvelle') }}">+ Nouvelle séance</a>
        {% endif %}
        </span>
    </div>

    <form class="filtres" method="get">
        <input type="search" name="q" value="{{ filtres.q }}" placeholder="Thème ou exercice">
        <select name="saison" onchange="this.form.requestSubmit()">
            <option value="">Toutes les saisons</option>
            {% for s in saisons %}
                <option value="{{ s }}" {{ filtres.saison == s ? 'selected' }}>Saison {{ s }}</option>
            {% endfor %}
        </select>
        <select name="categorie" onchange="this.form.requestSubmit()">
            <option value="">Toutes les catégories</option>
            {% for c in categories %}
                <option value="{{ c.id }}" {{ filtres.categorie == c.id ? 'selected' }}>{{ c.nom }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="bouton">Filtrer</button>
    </form>

    <div class="table-defile">
        <table class="liste liste-fiches">
            <thead><tr><th>Date</th><th>Équipe</th><th>Thème</th><th>Exercices</th><th>Durée</th></tr></thead>
            <tbody>
                {% for s in seances %}
                    <tr>
                        <td class="nowrap"><a href="{{ path('app_seance_voir', {id: s.id}) }}">{{ s.date|date('d/m/Y') }}</a></td>
                        <td class="fort">{{ s.categorie }}</td>
                        <td class="principal"><a href="{{ path('app_seance_voir', {id: s.id}) }}">{{ s.theme }}</a></td>
                        <td data-label="exercices">{{ s.exercices|length }}</td>
                        <td>{{ s.duree ? s.duree ~ ' min' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="vide">Aucune séance{{ filtres.saison or filtres.categorie or filtres.q ? ' pour ces critères' }}.{% if peut_creer %} Créez la première avec « Nouvelle séance ».{% endif %}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {{ m.pagination('app_seance_index', filtres, page, pages) }}
{% endblock %}

{% block barre_bas %}{{ include('seance/_barre_bas.html.twig') }}{% endblock %}
