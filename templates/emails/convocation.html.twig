{% extends 'emails/_mise_en_page.html.twig' %}

{% set r = convocation.rencontre %}
{% set jours = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'] %}

{% block titre %}{{ definitive|default(false) ? 'Convocation définitive' : (relance ? 'Rappel : convocation' : 'Convocation') }}{% endblock %}

{% block corps %}
    <p style="margin: 0 0 12px;">Bonjour,</p>
    {% set quoi = r.plateau ? 'plateau' : 'match' %}
    {% if definitive|default(false) %}<p style="margin: 0 0 12px;"><strong>Convocation définitive :</strong> le groupe pour ce {{ quoi }} est fixé. En cas d'empêchement, prévenez-nous au plus vite.</p>
    {% elseif relance %}<p style="margin: 0 0 12px;"><strong>Petit rappel :</strong> nous attendons toujours votre réponse.</p>{% endif %}
    <p style="margin: 0 0 12px;"><strong>{{ convoque.joueur.prenom }} {{ convoque.joueur.nom }}</strong> est convoqué(e) pour le {{ quoi }} :</p>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin: 14px 0; border-left: 4px solid {{ club.couleur }}; background: #f8f8fa; border-radius: 0 8px 8px 0;">
        <tr><td colspan="2" style="padding: 10px 12px 4px; font-size: 17px; font-weight: bold;">{{ r.equipeAffichee }} – {{ r.adversaire }}</td></tr>
        <tr>
            <td style="padding: 4px 12px; color: #6b6b72; font-size: 13px; white-space: nowrap;">Date</td>
            <td style="padding: 4px 12px; font-size: 14px;">{{ jours[r.date|date('w')]|capitalize }} {{ r.date|date('d/m/Y') }}{% if r.heure %} à {{ r.heure }}{% endif %}</td>
        </tr>
        {% if r.competition and not r.plateau %}
            <tr><td style="padding: 4px 12px; color: #6b6b72; font-size: 13px;">Compétition</td><td style="padding: 4px 12px; font-size: 14px;">{{ r.competition }}</td></tr>
        {% endif %}
        {% if r.lieu %}
            <tr><td style="padding: 4px 12px; color: #6b6b72; font-size: 13px;">Lieu du {{ quoi }}</td><td style="padding: 4px 12px; font-size: 14px;">{{ r.lieu }}</td></tr>
        {% endif %}
        {% if convocation.rdvHeure or convocation.rdvLieu %}
            <tr>
                <td style="padding: 4px 12px 10px; color: #6b6b72; font-size: 13px; white-space: nowrap;">Rendez-vous</td>
                <td style="padding: 4px 12px 10px; font-size: 14px;"><strong>Rendez-vous{% if convocation.rdvHeure %} à {{ convocation.rdvHeure }}{% endif %}{% if convocation.rdvLieu %}, {{ convocation.rdvLieu }}{% endif %}</strong></td>
            </tr>
        {% endif %}
        {% if r.deplacements is not empty %}
            <tr>
                <td style="padding: 4px 12px 10px; color: #6b6b72; font-size: 13px; white-space: nowrap; vertical-align: top;">Déplacement</td>
                <td style="padding: 4px 12px 10px; font-size: 14px;">{% for d in r.deplacements %}{{ d.resumeFamilles }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td>
            </tr>
        {% endif %}
    </table>

    {% if convocation.message %}<p style="margin: 0 0 12px; white-space: pre-line;">{{ convocation.message }}</p>{% endif %}

    <p style="margin: 0 0 12px;">Merci d'indiquer s'il sera présent ou absent :</p>
    <p style="margin: 18px 0 8px;">
        <a href="{{ espace }}" style="display: inline-block; padding: 12px 22px; background: {{ club.couleur }}; color: {{ club.couleurTexte }}; border-radius: 8px; text-decoration: none; font-weight: bold;">Répondre</a>
    </p>
    <p style="margin: 0; color: #6b6b72; font-size: 12px;">Le bouton ouvre votre espace famille ({{ espace }}) : connectez-vous avec votre adresse e-mail et votre mot de passe.</p>
{% endblock %}
